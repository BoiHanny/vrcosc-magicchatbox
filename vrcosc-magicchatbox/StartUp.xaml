<Window
    x:Class="vrcosc_magicchatbox.StartUp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Starting MagicChatbox"
    Width="580"
    Background="#150A2E"
    Cursor="AppStarting"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="StartupProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border
                            Background="#241748"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="PART_Track" />
                                <Border
                                    x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#6E4FB5" />
                                            <GradientStop Offset="1" Color="#C3A9FF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.7"
                                            RenderingBias="Performance"
                                            ShadowDepth="0"
                                            Color="#9E82DD" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartupGhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A99BD4" />
            <Setter Property="FontFamily" Value="Albert Sans Thin" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ghostBorder"
                            Padding="16,6"
                            Background="Transparent"
                            BorderBrush="#463473"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ghostBorder" Property="Background" Value="#2E2050" />
                                <Setter TargetName="ghostBorder" Property="BorderBrush" Value="#6D55A8" />
                                <Setter Property="Foreground" Value="#DCD2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ghostBorder" Property="Background" Value="#241A40" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border
        Background="#150A2E"
        MouseDown="DraggableGrid_MouseLeftButtonDown"
        SnapsToDevicePixels="True">
        <Border BorderBrush="#33265C" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="30,26,30,22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#2E1568" />
                            <GradientStop Offset="1" Color="#1B0E3C" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="54"
                            Height="54"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Img/Icons/MagicChatbox_ico.png" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Comfortaa Light"
                                    FontSize="27"
                                    Foreground="White"
                                    Text="MagicChatbox" />
                                <Border
                                    Margin="12,4,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="#2C1E58"
                                    BorderBrush="#4B3689"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <TextBlock
                                        x:Name="VersionText"
                                        d:Text="0.9.215"
                                        FontFamily="Albert Sans Thin"
                                        FontSize="11"
                                        Foreground="#C3A9FF" />
                                </Border>
                            </StackPanel>
                            <TextBlock
                                Margin="2,6,0,0"
                                FontFamily="Albert Sans Thin"
                                FontSize="13"
                                Foreground="#9B8FC6"
                                Text="Sit back, relax, and let us prepare your app"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="30,22,30,20">
                    <ProgressBar x:Name="ProgressBar" Style="{StaticResource StartupProgressBar}" />

                    <Grid
                        Height="72"
                        Margin="0,18,0,0"
                        ClipToBounds="True">
                        <StackPanel x:Name="StepPanel">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="PrevStepText"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="12"
                                    Foreground="#6E639A"
                                    Text=""
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="PrevStepTime"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="11"
                                    Foreground="#5A5185"
                                    Text="" />
                            </Grid>

                            <Grid Height="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="3"
                                    Height="15"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="#C3A9FF"
                                    CornerRadius="2" />
                                <TextBlock
                                    x:Name="CurrentStepText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="Comfortaa Light"
                                    FontSize="14"
                                    Foreground="White"
                                    Text=""
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="CurrentStepTime"
                                    Grid.Column="2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="11"
                                    Foreground="#9B8FC6"
                                    Text="" />
                            </Grid>

                            <Grid Height="22">
                                <TextBlock
                                    x:Name="NextStepText"
                                    Margin="13,0,0,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="12"
                                    Foreground="#6E639A"
                                    Text=""
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Padding="30,14"
                    Background="#110823"
                    BorderBrush="#2A1E4E"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="BylineText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            d:Opacity="1"
                            Opacity="0"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="Albert Sans Thin"
                                FontSize="12"
                                Foreground="#6A5F94"
                                Text="by" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Comfortaa Light"
                                FontSize="14"
                                Text="BoiHanny">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#9ED4DE" />
                                        <GradientStop Offset="1" Color="#C0AAF0" />
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>

                        <Button
                            x:Name="CancelButton"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Click="CancelButton_Click"
                            Content="Cancel"
                            Style="{StaticResource StartupGhostButton}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>

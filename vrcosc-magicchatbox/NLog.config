<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

	<targets>
		<target xsi:type="AsyncWrapper" name="fileTarget">
			<target xsi:type="File"
					fileName="${specialfolder:folder=LocalApplicationData}/Vrcosc-MagicChatbox/logs/${shortdate}.log"
					keepFileOpen="true"
					createDirs="true"
					archiveAboveSize="10485760"
					maxArchiveFiles="5"
					archiveNumbering="Rolling"
					layout="${longdate} || ${uppercase:${level}} [ThreadID:${threadid}] || ${message} ${exception:format=ToString,StackTrace}"/>
		</target>

		<target xsi:type="AsyncWrapper" name="errorTarget">
			<target xsi:type="File"
					fileName="${specialfolder:folder=LocalApplicationData}/Vrcosc-MagicChatbox/logs/errors-${shortdate}.log"
					keepFileOpen="true"
					createDirs="true"
					archiveAboveSize="10485760"
					maxArchiveFiles="3"
					archiveNumbering="Rolling"
					layout="${longdate} || ${uppercase:${level}} [ThreadID:${threadid}] || ${message} ${exception:format=ToString,StackTrace}"/>
		</target>
	</targets>

	<rules>
		<logger name="*" minlevel="Debug" writeTo="fileTarget" />
		<logger name="*" minlevel="Error" writeTo="errorTarget" />
	</rules>
</nlog>

                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
                            <Border
                                x:Name="CheckBorder"
                                Grid.Column="1"
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Background="#FF3A2F54"

        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="CornerRadius" Value="5,0,0,5" />
        <Setter Property="BorderBrush" Value="#7B5BBB" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>

    <Style
        x:Key="OptionNestedCardStyle"
        BasedOn="{StaticResource OptionCardStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="20,4,0,6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--
        Subsection header. Size goes 15 -> 16 to break a tie: field labels are also 15, so the
        header was separated from the thing it labels by weight and a slightly brighter brush
        alone. One step of size makes the hierarchy survive a squint.
    -->
    <!--
        The top bar tabs.
        
        Hover and selected drive SEPARATE elements on purpose. Sharing them means the later
        storyboard wins on a contested property, so hovering the tab you are already on dimmed it -
        the hover animation was overwriting the selected one. Kept apart, hovering the current tab
        simply adds glow on top of it and nothing fights.
        
        Hover is deliberately fast - in at 90ms, out at 170ms. In wants to feel instant, out wants to
        feel like it is trailing your cursor rather than being switched off.
        
        Everything animated is a scale or an opacity. Both compose on the render thread, so the bar
        keeps moving while the UI thread is busy, which during a scan tick it often is; animating
        width or colour would stutter in exactly the moments the app is working hardest.
    -->
    <Style x:Key="TopBarTabStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="Foreground" Value="{StaticResource TextLightPurpleBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent" ClipToBounds="False">

                        <!--
                            SELECTED: the wash. Brightest at the bottom, so the tab reads as lit
                            from its underline upward.
                        -->
                        <Border x:Name="ActiveWash" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00AEA7ED" />
                                    <GradientStop Offset="1" Color="#42AEA7ED" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!--  HOVER: blurred rather than drawn, so it has no edge of its own.  -->
                        <Border
                            x:Name="HoverGlow"
                            Margin="8,4"
                            Background="#7FCBB9FF"
                            CornerRadius="12"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <BlurEffect KernelType="Gaussian" Radius="26" />
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GlowScale" ScaleX="0.75" ScaleY="0.75" />
                            </Border.RenderTransform>
                        </Border>

                        <ContentPresenter
                            x:Name="Label"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Focusable="False"
                            RecognizesAccessKey="True"
                            RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="LabelScale" />
                                    <TranslateTransform x:Name="LabelLift" />
                                </TransformGroup>
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>

                        <!--  HOVER: a short bar that darts out from the middle.  -->
                        <Border
                            x:Name="HoverUnderline"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Background="#FFCFC6FF"
                            CornerRadius="1"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="HoverUnderlineScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>

                        <!--  SELECTED: the full-width one, faded at both ends.  -->
                        <Border
                            x:Name="ActiveUnderline"
                            Height="3"
                            VerticalAlignment="Bottom"
                            CornerRadius="2"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#006E63C8" />
                                    <GradientStop Offset="0.5" Color="#FFDCD5FF" />
                                    <GradientStop Offset="1" Color="#006E63C8" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ActiveUnderlineScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverGlow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.09" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="GlowScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="GlowScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <QuarticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverUnderline"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.9"
                                            Duration="0:0:0.07" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverUnderlineScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.62"
                                            Duration="0:0:0.13">
                                            <DoubleAnimation.EasingFunction>
                                                <QuinticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelLift"
                                            Storyboard.TargetProperty="Y"
                                            To="-2"
                                            Duration="0:0:0.11">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.6" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.05"
                                            Duration="0:0:0.11" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.05"
                                            Duration="0:0:0.11" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverGlow"
                                            Storyboard.TargetProperty="Opacity"
                                            Duration="0:0:0.17" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="GlowScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.75"
                                            Duration="0:0:0.17" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="GlowScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.75"
                                            Duration="0:0:0.17" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverUnderline"
                                            Storyboard.TargetProperty="Opacity"
                                            Duration="0:0:0.17" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverUnderlineScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            Duration="0:0:0.17" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelLift"
                                            Storyboard.TargetProperty="Y"
                                            Duration="0:0:0.17" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.17" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.17" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>

                        <Trigger Property="xaml:ButtonProperties.IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ActiveWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.22" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ActiveUnderline"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ActiveUnderlineScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.4" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ActiveWash"
                                            Storyboard.TargetProperty="Opacity"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ActiveUnderline"
                                            Storyboard.TargetProperty="Opacity"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="ActiveUnderlineScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <!--  A press should feel like the tab takes the weight.  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.95"
                                            Duration="0:0:0.05" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.95"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.05"
                                            Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.8" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation
                                            Storyboard.TargetName="LabelScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.05"
                                            Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.8" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="OptionSubsectionHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="2,8,0,5" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubheading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSectionHeaderBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        This style was dead - defined here, referenced nowhere - which is why there are ~107
        hand-rolled field labels across Options/*. It also disagreed with every one of them at
        13px, so the size is corrected to the 15 they all actually use. Medium (500) sits one
        deliberate step under the SemiBold (600) headers: a label names a control, it does not
        compete with the thing that names a section.
        
        Call sites vary in Margin - preserve any local Margin as a local override when adopting.
    -->
    <Style x:Key="OptionFieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Live numeric values (heart rate, battery %, component and network stats). Weight only,
        deliberately no FontSize, so each call site keeps the size its context needs while the
        number still catches a scanning eye ahead of its label.
        
        Do NOT pair this with Typography.NumeralAlignment="Tabular" to stop digits jittering -
        neither font ships a `tnum` feature (checked both GSUB feature lists), so the property
        compiles, runs, and does nothing. Give the readout a fixed-width container instead.
    -->
    <Style x:Key="NumericReadoutStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="OptionHelpTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="2,3,0,6" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OptionActionRowStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <!--
        A row of mutually exclusive choices where a dropdown would hide the alternatives. Every
        option stays on screen, so the cost of each one is readable without opening anything.
        Put the buttons in a bordered container and give them a shared GroupName.
    -->
    <Style x:Key="SegmentedChoiceContainerStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceDarkBrush}" />
        <Setter Property="BorderBrush" Value="#5B4A86" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SegmentedChoiceStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCompact}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border
                        x:Name="segment"
                        Background="Transparent"
                        CornerRadius="3">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                            TextOptions.TextRenderingMode="ClearType" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="segment" Property="Background" Value="#3A2F5C" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="segment" Property="Background" Value="{StaticResource AccentLightPurpleBrush}" />
                            <Setter Property="Foreground" Value="#FF241243" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="segment" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="segment" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <ControlTemplate x:Key="DarkSliderThumb" TargetType="{x:Type Thumb}">
        <Ellipse
            x:Name="thumb"
            Width="14"
            Height="14"
            Fill="#FF9B90D1"
            Stroke="#FF4A3580"
            StrokeThickness="1" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumb" Property="Fill" Value="#FFBDAEE2" />
                <Setter TargetName="thumb" Property="Stroke" Value="#FF6B5CA0" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="thumb" Property="Fill" Value="#FF7C5CBF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="thumb" Property="Fill" Value="#FF4A3F63" />
                <Setter TargetName="thumb" Property="Stroke" Value="Transparent" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center">
                        <Border
                            Height="4"
                            VerticalAlignment="Center"
                            Background="#FF160F2D"
                            CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border
                                                Height="4"
                                                Background="#FF7C5CBF"
                                                CornerRadius="2,0,0,2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Template="{StaticResource DarkSliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="CustomSlider"
        BasedOn="{StaticResource {x:Type Slider}}"
        TargetType="{x:Type Slider}" />

    <Style x:Key="CustomizePillButton" TargetType="Button">
        <Setter Property="Background" Value="#FF2C2148" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="Content" Value="Customize ›" />
        <Setter Property="Padding" Value="10,3,8,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="pillBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="#FF3A2D5A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="#FF221A3C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The quieter sibling of CustomizePillButton: same height and corner radius so tile rows do not
        change height, but dimmer so it never competes with Customize. Content must be overridden
        because the base style hardcodes "Customize ›".
    -->
    <Style
        x:Key="HideTilePillButton"
        BasedOn="{StaticResource CustomizePillButton}"
        TargetType="Button">
        <Setter Property="Content" Value="👁" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        A hidden tile reads as a small, quiet object you can pick back up: soft gradient, hairline
        edge, and an accent edge on hover so it clearly invites a click.
    -->
    <Style x:Key="HiddenTileChipButton" TargetType="Button">
        <Setter Property="Foreground" Value="#D6C9F2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,2,5,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="chip"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="#4A3C72"
                        BorderThickness="1"
                        CornerRadius="9"
                        SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FF362B59" />
                                <GradientStop Offset="1" Color="#FF2A2146" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="#A97BFF" />
                            <Setter TargetName="chip" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#FF453770" />
                                        <GradientStop Offset="1" Color="#FF362B59" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="#3FE0D2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Integration tile palette. The old surface ran DarkSlateBlue to deep purple, which sat flat and
        slightly muddy; this keeps the same violet family but adds depth across the diagonal and lets
        the title stay the brightest thing on the tile.
    -->
    <SolidColorBrush
        x:Key="TileDescriptionBrush"
        po:Freeze="True"
        Color="#FFBCB1DD" />
    <SolidColorBrush
        x:Key="TileIconFrameBrush"
        po:Freeze="True"
        Color="#26A98CFF" />
    <SolidColorBrush
        x:Key="TileIconFrameBorderBrush"
        po:Freeze="True"
        Color="#33C3A9FF" />

    <!--
        Outline for the expanded control panel a tile drops open underneath itself. Deeper than the
        icon frame on purpose: the frame sits inside the tile and should recede, while this one has
        to close a panel that hangs below the tile's own edge.
    -->
    <SolidColorBrush
        x:Key="TilePanelBorderBrush"
        po:Freeze="True"
        Color="#FF3A1F73" />


    <!--
        Integration tile title and description. These were 16 + 16 identical inline blocks in
        IntegrationsPage.xaml where title and description differed by size and colour only, with
        no weight separation at all - the gap that prompted this pass.
        
        SemiBold (600), not Bold (700), even though Comfortaa reaches 700 for real. Comfortaa is
        a rounded display face with generous stroke contrast; at 20px over the TileSurfaceBrush
        gradient with a drop shadow on top, 700 blooms and the counters in a/o/e close up. Ink
        width Regular->SemiBold is +6%, ->Bold +8.4%, so 600 buys nearly all the contrast and
        keeps 700 in reserve for something that genuinely needs to be louder.
        
        Effect uses DynamicResource on purpose: TextBlockShadowEffect lives in App.xaml, and
        Theme.xaml is merged INTO App, so a StaticResource lookup from in here cannot see it.
    -->
    <Style x:Key="TileTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource FontSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Effect" Value="{DynamicResource TextBlockShadowEffect}" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
    </Style>

    <Style x:Key="TileDescriptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource FontSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSecondary}" />
        <Setter Property="Foreground" Value="{StaticResource TileDescriptionBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Effect" Value="{DynamicResource TextBlockShadowEffect}" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
    </Style>

    <LinearGradientBrush x:Key="TileSurfaceBrush" po:Freeze="True" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF4A3E85" />
        <GradientStop Offset="0.55" Color="#FF3A2E6B" />
        <GradientStop Offset="1" Color="#FF2C2252" />
    </LinearGradientBrush>

    <!--
        One look for every "what is this doing right now" line beside a tile title. They were a mix of
        italic grey, teal and plain white at three different sizes; this makes them read as one kind of
        thing without touching what each tile binds to.
    -->
    <Style x:Key="TileStatusPill" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="9,1,0,0" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#C6B9E8" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="260" />
    </Style>

    <Style x:Key="HiddenStripToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#9C8DC4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource FontSecondary}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,2,6,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="summaryBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="summaryBorder" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HiddenTileActionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="4,2,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="linkBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="linkBorder" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        Deck tokens live here, beside the deck styles: a merged dictionary cannot resolve a
        StaticResource declared in its parent.
    -->
    <SolidColorBrush
        x:Key="DeckSurfaceBrush"
        po:Freeze="True"
        Color="#FF2C2148" />
    <SolidColorBrush
        x:Key="DeckSurfaceHoverBrush"
        po:Freeze="True"
        Color="#FF3A2D5A" />
    <SolidColorBrush
        x:Key="DeckSurfacePressedBrush"
        po:Freeze="True"
        Color="#FF221A3C" />
    <SolidColorBrush
        x:Key="DeckEdgeBrush"
        po:Freeze="True"
        Color="#FF4A3C72" />
    <SolidColorBrush
        x:Key="DeckEdgeHoverBrush"
        po:Freeze="True"
        Color="#FFA97BFF" />
    <SolidColorBrush
        x:Key="DeckTextBrush"
        po:Freeze="True"
        Color="#FFC6B9E8" />
    <SolidColorBrush
        x:Key="DeckTextMutedBrush"
        po:Freeze="True"
        Color="#FF9689B8" />
    <SolidColorBrush
        x:Key="DeckTextOnBrush"
        po:Freeze="True"
        Color="#FF17102E" />
    <SolidColorBrush
        x:Key="RouteOnBrush"
        po:Freeze="True"
        Color="#FFB9A6EE" />
    <SolidColorBrush
        x:Key="RouteOnEdgeBrush"
        po:Freeze="True"
        Color="#FFD3C4FF" />
    <SolidColorBrush
        x:Key="FeatureOnFillBrush"
        po:Freeze="True"
        Color="#3DB96BFF" />
    <SolidColorBrush
        x:Key="FeatureOnEdgeBrush"
        po:Freeze="True"
        Color="#FFB96BFF" />
    <SolidColorBrush
        x:Key="FeatureOnTextBrush"
        po:Freeze="True"
        Color="#FFEFE4FF" />

    <!--
        One sound, as small as it can be and still be readable and hittable. A soundboard is a wall
        of these, so everything that is not the name earns its pixels: the play glyph only appears
        under the pointer, and the star only when the sound is actually pinned. Sizing follows the
        deck chip family so a wall of these sits next to the route chips without looking foreign.
    -->
    <!--
        The seat a sound's thumbnail sits in. Lighter than the blob so the slot reads as "picture
        pending" before one arrives, which also means the space is already there and nothing shifts
        when it does.
    -->
    <SolidColorBrush
        x:Key="SoundThumbnailSeatBrush"
        po:Freeze="True"
        Color="#26FFFFFF" />

    <Style x:Key="SoundBlobButton" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="MaxWidth" Value="188" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="face"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="{StaticResource DeckEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="9"
                        SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FF362B59" />
                                <GradientStop Offset="1" Color="#FF2A2146" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource DeckEdgeHoverBrush}" />
                            <Setter TargetName="face" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#FF453770" />
                                        <GradientStop Offset="1" Color="#FF362B59" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="face" Property="Background" Value="{StaticResource DeckSurfacePressedBrush}" />
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource AccentTealBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="face" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Sits inside a blob. Nesting a ButtonBase is what keeps the two targets apart: the inner one
        marks the mouse event handled, so starring a sound never also plays it.
    -->
    <Style x:Key="SoundBlobStarButton" TargetType="ToggleButton">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="4,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource DeckTextMutedBrush}" />
        <Setter Property="Content" Value="★" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border
                            x:Name="starFace"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True" />
                        <ContentPresenter
                            x:Name="starGlyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="starFace" Property="Background" Value="#26FFFFFF" />
                            <Setter TargetName="starFace" Property="BorderBrush" Value="{StaticResource DeckEdgeHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
                        </Trigger>
                        <!--  Pinned reads as a filled badge, not a slightly different glyph colour.  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="starFace" Property="Background" Value="{StaticResource FeatureOnFillBrush}" />
                            <Setter TargetName="starFace" Property="BorderBrush" Value="{StaticResource FeatureOnEdgeBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource FeatureOnTextBrush}" />
                        </Trigger>
                        <!--  A transform is not a nameable trigger target, so replace it wholesale.  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="starGlyph" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============================================================================================
        THE CONTROL DECK. One height (22), one radius (6), one font. What a control DOES is carried
        by its fill, not its size: routes are solid when lit, features are tinted outlines, doors and
        hide are filled and borderless, and only the master switch wears the accent ramp.
        
        Every existing Glowy* / CustomizePillButton style is left untouched - seven of them are used
        by MainWindow, StatusPage, ChattingPage and the Options sections.
        ============================================================================================
    -->

    <!--
        The link icons that sit beside the tabs. Quiet by default so they never compete with the tab
        you are actually on, and they only take on a surface when pointed at.
    -->
    <Style x:Key="TopBarLinkButton" TargetType="Button">
        <Setter Property="Width" Value="25" />
        <Setter Property="Height" Value="25" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="link"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="link" Property="Background" Value="#24FFFFFF" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="link" Property="Background" Value="#33000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        MinWidth, not Width. The deck sits in an Auto column whose right edge is pinned by the switch
        beside it, so the alignment that matters - every tile's mode chips on the same x - comes from
        being right-anchored, not from a fixed width. Pinning the width as well only meant a tile with
        one chip too many clipped its leftmost control instead of growing into the description slack.
    -->
    <Style x:Key="TileControlDeck" TargetType="StackPanel">
        <Setter Property="MinWidth" Value="246" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,6,2,0" />
    </Style>

    <!--
        Rows are right-anchored and the fixed-position control is LAST, so variable width is absorbed
        on the left where it reads as margin. That is what keeps the mode chips on the same x across
        all sixteen tiles without reserving empty slots.
    -->
    <Style x:Key="DeckOutputRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="DeckChromeRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!--
        These are the route/feature chips on every integration tile - the most-seen chips in the
        app - and they were in Bahnschrift SemiLight, a system font that is not guaranteed to be
        present or identical on every machine. Size goes 10 -> 11 because Albert Sans has a
        smaller body than Bahnschrift at the same nominal size.
    -->
    <Style x:Key="DeckChipBase" TargetType="ToggleButton">
        <Setter Property="Height" Value="22" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
        <!--
            WPF suppresses tooltips on disabled elements, and a disabled chip is exactly when the
            user most needs to know why.
        -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <!--
        DESKTOP and VR are two INDEPENDENT booleans, so they stay two separate chips with a real gap.
        Fusing them into one segmented pill would read as a mutually-exclusive picker and remove the
        mis-click buffer between two un-undoable toggles.
    -->
    <Style
        x:Key="RouteChip"
        BasedOn="{StaticResource DeckChipBase}"
        TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="route"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="{StaticResource DeckEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="route" Property="Background" Value="#1FFFFFFF" />
                            <Setter TargetName="route" Property="BorderBrush" Value="{StaticResource DeckEdgeHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="route" Property="Background" Value="{StaticResource DeckSurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="route" Property="Background" Value="{StaticResource RouteOnBrush}" />
                            <Setter TargetName="route" Property="BorderBrush" Value="{StaticResource RouteOnEdgeBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DeckTextOnBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RouteChipDesktop"
        BasedOn="{StaticResource RouteChip}"
        TargetType="ToggleButton">
        <Setter Property="Width" Value="58" />
        <Setter Property="Content" Value="DESKTOP" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="AutomationProperties.Name" Value="Show on desktop" />
        <Setter Property="ToolTip" Value="Show this integration while you're on desktop." />
    </Style>

    <Style
        x:Key="RouteChipVr"
        BasedOn="{StaticResource RouteChip}"
        TargetType="ToggleButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Content" Value="VR" />
        <Setter Property="AutomationProperties.Name" Value="Show in VR" />
        <Setter Property="ToolTip" Value="Show this integration while you're in VR." />
    </Style>

    <!--
        The honest-absence answer. A ContentControl, not a Border: Border has no Content property, so
        a Border style cannot carry its own label. Wears the live chips' ground so it reads as the
        same kind of object rather than a hole.
    -->
    <Style x:Key="RouteChipStatic" TargetType="ContentControl">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Content" Value="VR ONLY" />
        <!--  matches DeckChipBase: this sits in the same chip row and must not read as a different face  -->
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="Foreground" Value="{StaticResource DeckTextMutedBrush}" />
        <Setter Property="ToolTip" Value="This integration only appears while you're in VR. It has no desktop mode." />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border
                        Background="{StaticResource DeckSurfaceBrush}"
                        BorderBrush="{StaticResource DeckEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="FeatureChip"
        BasedOn="{StaticResource DeckChipBase}"
        TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="chip"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        BorderBrush="{StaticResource DeckEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource DeckEdgeHoverBrush}" />
                            <Setter TargetName="chip" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{StaticResource DeckSurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="chip" Property="Background" Value="{StaticResource FeatureOnFillBrush}" />
                            <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource FeatureOnEdgeBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource FeatureOnTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="chip" Property="BorderBrush" Value="#1FFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource DeckTextMutedBrush}" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ============================================================================================
        THE CHAT PAGE. Borrows the deck's edges and accent so a sent message, an integration tile and
        a settings group all read as the same product. What is new here is the vocabulary of state:
        a message is either the live one or history, and the page has to say which at a glance.
        ============================================================================================
    -->
    <SolidColorBrush
        x:Key="ChatCardBrush"
        po:Freeze="True"
        Color="#FF332951" />
    <SolidColorBrush
        x:Key="ChatCardHoverBrush"
        po:Freeze="True"
        Color="#FF3C3160" />
    <SolidColorBrush
        x:Key="ChatCardLiveBrush"
        po:Freeze="True"
        Color="#FF3A2C63" />
    <SolidColorBrush
        x:Key="ChatTextBrush"
        po:Freeze="True"
        Color="#FFE2DCF2" />
    <SolidColorBrush
        x:Key="ChatEditTextBrush"
        po:Freeze="True"
        Color="#FF9FE4FF" />

    <!--
        The live message and the history behind it. Only the ground and the edge change: keeping the
        geometry identical is what makes the accent bar the thing the eye lands on.
    -->
    <Style x:Key="ChatMessageCard" TargetType="Border">
        <Setter Property="Margin" Value="8,0,8,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource ChatCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DeckEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter Property="Background" Value="{StaticResource ChatCardLiveBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource FeatureOnEdgeBrush}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ChatCardHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Row actions sit quiet until the row is pointed at. They are always on screen - hiding them
        outright would make editing undiscoverable - but they are not competing with the message.
    -->
    <Style x:Key="ChatRowActions" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Opacity" Value="0.55" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="Opacity"
                                To="0.55"
                                Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChatRowButton" TargetType="Button">
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="face"
                        Padding="{TemplateBinding Padding}"
                        Background="#14FFFFFF"
                        BorderBrush="{StaticResource DeckEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="Background" Value="#2BFFFFFF" />
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource DeckEdgeHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="face" Property="Background" Value="{StaticResource DeckSurfacePressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChatRowToggle" TargetType="ToggleButton">
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="face"
                        Padding="{TemplateBinding Padding}"
                        Background="#14FFFFFF"
                        BorderBrush="{StaticResource DeckEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="Background" Value="#2BFFFFFF" />
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource DeckEdgeHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="face" Property="Background" Value="{StaticResource FeatureOnFillBrush}" />
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource FeatureOnEdgeBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource FeatureOnTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The composer is one object, not a text box with things parked on top of it. Everything inside
        shares its focus ring, so the whole strip lights up when the caret is in the box.
    -->
    <Style x:Key="ChatComposerShell" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="#FF3A3060" />
        <Setter Property="BorderBrush" Value="{StaticResource DeckEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#FF7C5CBF" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="#FF443A70" />
                <Setter Property="BorderBrush" Value="#FF9B7FDF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        LIVE. Reaches for the same accent as an enabled feature chip because that is what it is, but
        it is wider and taller: it sits inside the composer and has to be hittable without aiming.
    -->
    <Style x:Key="LiveTypingChip" TargetType="ToggleButton">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="Foreground" Value="{StaticResource DeckTextMutedBrush}" />
        <Setter Property="Content" Value="LIVE" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="face"
                        Background="#14FFFFFF"
                        BorderBrush="{StaticResource DeckEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Ellipse
                                x:Name="dot"
                                Width="6"
                                Height="6"
                                Margin="0,0,5,0"
                                Fill="{StaticResource DeckTextMutedBrush}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="Background" Value="#2BFFFFFF" />
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource DeckEdgeHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="face" Property="Background" Value="{StaticResource FeatureOnFillBrush}" />
                            <Setter TargetName="face" Property="BorderBrush" Value="{StaticResource FeatureOnEdgeBrush}" />
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource FeatureOnEdgeBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource FeatureOnTextBrush}" />
                        </Trigger>
                        <!--
                            The pulse is the only thing on the page that says "this is going out right
                            now", and it repeats forever. Visibility is a condition rather than just
                            IsChecked because the checked state comes from a saved setting that outlives
                            the page: leaving the page never unchecks it, so a pulse keyed on IsChecked
                            alone would never reach its stop action and would go on animating a chip
                            nobody can see.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsVisible" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Name="LivePulse">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            AutoReverse="True"
                                            Storyboard.TargetName="dot"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.25"
                                            Duration="0:0:0.75" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LivePulse" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Icon-only affordances inside the composer: no chrome until pointed at.  -->
    <Style x:Key="ChatComposerIconButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="face"
                        Background="Transparent"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            x:Name="glyph"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.65" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="face" Property="Background" Value="#22FFFFFF" />
                            <Setter TargetName="glyph" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="face" Property="Background" Value="{StaticResource DeckSurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TileDoorButton" TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="Background" Value="{StaticResource DeckSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
        <!--  matches DeckChipBase: this sits in the same chip row and must not read as a different face  -->
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="Padding" Value="11,0,10,0" />
        <Setter Property="Content" Value="CUSTOMIZE ›" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="door"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="door" Property="Background" Value="{StaticResource DeckSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="door" Property="Background" Value="{StaticResource DeckSurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Its own template rather than BasedOn TileDoorButton: a derived style cannot retarget the base
        template's parts, so inheriting would leave the base hover trigger fighting this one.
    -->
    <Style x:Key="TileHideButton" TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="{StaticResource DeckSurfaceBrush}" />
        <!--  Muted where CUSTOMIZE is not: both sit in this row, but hiding is the lesser action.  -->
        <Setter Property="Foreground" Value="{StaticResource DeckTextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="Padding" Value="11,0,10,0" />
        <Setter Property="Content" Value="HIDE" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="eye"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="eye" Property="Background" Value="{StaticResource DeckSurfaceHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DeckTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="eye" Property="Background" Value="{StaticResource DeckSurfacePressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        The one sanctioned exception. Because every other chip is now uniform, the holo treatment
        reads as deliberately special rather than as a fourth unrelated style. Re-cut to the deck's
        22px / radius 6. The sheen animates the element's own RenderTransform: a TranslateTransform
        named inside a TransformGroup gets frozen by WPF and throws the moment it is animated.
    -->
    <Style
        x:Key="FeatureChipLyrics"
        BasedOn="{StaticResource DeckChipBase}"
        TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border
                            x:Name="chipBase"
                            Background="Transparent"
                            CornerRadius="6"
                            SnapsToDevicePixels="True" />

                        <Border
                            x:Name="holoFill"
                            CornerRadius="6"
                            Opacity="0"
                            SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#3FE0D2" />
                                    <GradientStop Offset="0.35" Color="#6E9BFF" />
                                    <GradientStop Offset="0.65" Color="#B96BFF" />
                                    <GradientStop Offset="1" Color="#FF6FC7" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Border
                            x:Name="sheenClip"
                            ClipToBounds="True"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Border
                                x:Name="sheen"
                                Width="16"
                                HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.5" Color="#A6FFFFFF" />
                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.LayoutTransform>
                                    <SkewTransform AngleX="-20" />
                                </Border.LayoutTransform>
                                <Border.RenderTransform>
                                    <TranslateTransform X="-24" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                        <Border
                            x:Name="holoEdge"
                            BorderThickness="1"
                            CornerRadius="6"
                            IsHitTestVisible="False"
                            Opacity="0.55"
                            SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#5FE6D8" />
                                    <GradientStop Offset="0.5" Color="#A97BFF" />
                                    <GradientStop Offset="1" Color="#FF8AD2" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chipBase" Property="Background" Value="#3D3852" />
                            <Setter TargetName="holoEdge" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="holoFill" Property="Opacity" Value="1" />
                            <Setter TargetName="holoEdge" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FF1B1030" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard FillBehavior="Stop">
                                        <DoubleAnimation
                                            Storyboard.TargetName="sheenClip"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            BeginTime="0:0:0.15"
                                            Storyboard.TargetName="sheen"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            From="-24"
                                            To="90"
                                            Duration="0:0:0.7" />
                                        <DoubleAnimation
                                            BeginTime="0:0:0.7"
                                            Storyboard.TargetName="sheenClip"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The lyrics Gap/Hold stepper row. It appears twice - on the Integrations ribbon and on the
        Options timing card - and had drifted to two type scales and two button sizes. Keyed here so
        both sites render the same widget instead of two hand-kept copies.
        
        DataContext contract: a LyricsSectionViewModel (NudgeGapThresholdCommand,
        NudgeLineHoldCommand, Settings.GapThresholdSeconds, Settings.LineHoldSeconds). On the
        Options card that is already the ambient DataContext (Content="{Binding}"); on the
        Integrations page it hangs off the page VM (Content="{Binding LyricsTuning}").
        
        Status_Button_style lives in App.xaml, which merges this dictionary before defining it, so
        the reference has to be DynamicResource - StaticResource would be a forward reference and
        would throw at load.
    -->
    <!--  The sync offset as a stepper, same shape as the gap and hold row below.  -->
    <DataTemplate x:Key="LyricsOffsetRowTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Width="34"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextMutedBrush}"
                Text="Sync" />
            <Button
                Width="26"
                Height="26"
                Margin="0,0,4,0"
                Command="{Binding NudgeOffsetCommand}"
                CommandParameter="-100"
                Content="−"
                Style="{DynamicResource Status_Button_style}"
                ToolTip="Hold the words back by 100 ms." />
            <!--  Wider than the gap and hold readouts: has to fit "+100 ms" and "in sync".  -->
            <TextBlock
                Width="56"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextLightPurpleBrush}"
                Text="{Binding OffsetChip}"
                TextAlignment="Center"
                ToolTip="{Binding OffsetSummary}" />
            <Button
                Width="26"
                Height="26"
                Margin="4,0,0,0"
                Command="{Binding NudgeOffsetCommand}"
                CommandParameter="100"
                Content="+"
                Style="{DynamicResource Status_Button_style}"
                ToolTip="Bring the words forward by 100 ms." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LyricsTimingRowTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock
                Width="34"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextMutedBrush}"
                Text="Gap" />
            <Button
                Width="26"
                Height="26"
                Margin="0,0,4,0"
                Command="{Binding NudgeGapThresholdCommand}"
                CommandParameter="-1"
                Content="−"
                Style="{DynamicResource Status_Button_style}"
                ToolTip="A silence must be longer than this before it counts as an instrumental break." />
            <TextBlock
                Width="34"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextLightPurpleBrush}"
                Text="{Binding Settings.GapThresholdSeconds, StringFormat='{}{0}s'}"
                TextAlignment="Center" />
            <Button
                Width="26"
                Height="26"
                Margin="4,0,18,0"
                Command="{Binding NudgeGapThresholdCommand}"
                CommandParameter="1"
                Content="+"
                Style="{DynamicResource Status_Button_style}"
                ToolTip="A silence must be longer than this before it counts as an instrumental break." />

            <TextBlock
                Width="34"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextMutedBrush}"
                Text="Hold" />
            <Button
                Width="26"
                Height="26"
                Margin="0,0,4,0"
                Command="{Binding NudgeLineHoldCommand}"
                CommandParameter="-1"
                Content="−"
                Style="{DynamicResource Status_Button_style}"
                ToolTip="How long the last line stays up before the ♪ break marker takes over." />
            <TextBlock
                Width="34"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource TextLightPurpleBrush}"
                Text="{Binding Settings.LineHoldSeconds, StringFormat='{}{0}s'}"
                TextAlignment="Center" />
            <Button
                Width="26"
                Height="26"
                Margin="4,0,0,0"
                Command="{Binding NudgeLineHoldCommand}"
                CommandParameter="1"
                Content="+"
                Style="{DynamicResource Status_Button_style}"
                ToolTip="How long the last line stays up before the ♪ break marker takes over." />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>

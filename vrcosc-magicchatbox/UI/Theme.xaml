        x:Key="TextAccentBrush"
        po:Freeze="True"
        Color="#BDAEE2" />
    <SolidColorBrush
        x:Key="TextDarkBrush"
        po:Freeze="True"
        Color="#FF240E54" />

    <SolidColorBrush
        x:Key="SurfacePrimaryBrush"
        po:Freeze="True"
        Color="#FF2D1265" />
    <SolidColorBrush
        x:Key="SurfaceDarkBrush"
        po:Freeze="True"
        Color="#FF240E54" />

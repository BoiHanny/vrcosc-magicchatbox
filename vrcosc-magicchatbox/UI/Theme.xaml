        BasedOn="{StaticResource {x:Type CheckBox}}"
        TargetType="{x:Type CheckBox}" />

    <Style x:Key="OptionCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="CornerRadius" Value="5,0,0,5" />
        <Setter Property="BorderBrush" Value="#7B5BBB" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>

    <Style
        x:Key="OptionNestedCardStyle"
        BasedOn="{StaticResource OptionCardStyle}"
        TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="20,4,0,6" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="{StaticResource SurfaceVariantBrush}" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="OptionSubsectionHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="2,8,0,5" />
        <Setter Property="FontFamily" Value="Albert Sans Thin" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSectionHeaderBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OptionFieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="FontFamily" Value="Albert Sans Thin" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OptionHelpTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="2,3,0,6" />
        <Setter Property="FontFamily" Value="Albert Sans Thin" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style x:Key="OptionActionRowStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>


    <ControlTemplate x:Key="DarkSliderThumb" TargetType="{x:Type Thumb}">
        <Ellipse
            x:Name="thumb"
            Width="14"
            Height="14"
            Fill="#FF9B90D1"
            Stroke="#FF4A3580"
            StrokeThickness="1" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumb" Property="Fill" Value="#FFBDAEE2" />
                <Setter TargetName="thumb" Property="Stroke" Value="#FF6B5CA0" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="thumb" Property="Fill" Value="#FF7C5CBF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="thumb" Property="Fill" Value="#FF4A3F63" />
                <Setter TargetName="thumb" Property="Stroke" Value="Transparent" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type Slider}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid VerticalAlignment="Center">
                        <Border
                            Height="4"
                            VerticalAlignment="Center"
                            Background="#FF160F2D"
                            CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border
                                                Height="4"
                                                Background="#FF7C5CBF"
                                                CornerRadius="2,0,0,2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Template="{StaticResource DarkSliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="CustomSlider"
        BasedOn="{StaticResource {x:Type Slider}}"
        TargetType="{x:Type Slider}" />

    <Style x:Key="CustomizePillButton" TargetType="Button">
        <Setter Property="Background" Value="#FF2C2148" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="Albert Sans Thin" />
        <Setter Property="Content" Value="Customize ›" />
        <Setter Property="Padding" Value="10,3,8,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="pillBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="#FF3A2D5A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="#FF221A3C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The quieter sibling of CustomizePillButton: same height and corner radius so tile rows do not
          change height, but dimmer so it never competes with Customize. Content must be overridden
          because the base style hardcodes "Customize ›".  -->
    <Style
        x:Key="HideTilePillButton"
        BasedOn="{StaticResource CustomizePillButton}"
        TargetType="Button">
        <Setter Property="Content" Value="👁" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  A hidden tile reads as a small, quiet object you can pick back up: soft gradient, hairline
          edge, and an accent edge on hover so it clearly invites a click.  -->
    <Style x:Key="HiddenTileChipButton" TargetType="Button">
        <Setter Property="Foreground" Value="#D6C9F2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="Albert Sans Thin" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,2,5,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="chip"
                        Padding="{TemplateBinding Padding}"
                        BorderBrush="#4A3C72"
                        BorderThickness="1"
                        CornerRadius="9"
                        SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FF362B59" />
                                <GradientStop Offset="1" Color="#FF2A2146" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="#A97BFF" />
                            <Setter TargetName="chip" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#FF453770" />
                                        <GradientStop Offset="1" Color="#FF362B59" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="#3FE0D2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Integration tile palette. The old surface ran DarkSlateBlue to deep purple, which sat flat and
          slightly muddy; this keeps the same violet family but adds depth across the diagonal and lets
          the title stay the brightest thing on the tile.  -->
    <SolidColorBrush x:Key="TileDescriptionBrush" Color="#FFAEA1D6" />
    <SolidColorBrush x:Key="TileIconFrameBrush" Color="#26A98CFF" />
    <SolidColorBrush x:Key="TileIconFrameBorderBrush" Color="#33C3A9FF" />

    <LinearGradientBrush x:Key="TileSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF4A3E85" />
        <GradientStop Offset="0.55" Color="#FF3A2E6B" />
        <GradientStop Offset="1" Color="#FF2C2252" />
    </LinearGradientBrush>

    <!--  One look for every "what is this doing right now" line beside a tile title. They were a mix of
          italic grey, teal and plain white at three different sizes; this makes them read as one kind of
          thing without touching what each tile binds to.  -->
    <Style x:Key="TileStatusPill" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="9,1,0,0" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="FontFamily" Value="Albert Sans Thin" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#C6B9E8" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="260" />
    </Style>

    <Style x:Key="HiddenStripToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#9C8DC4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="Comfortaa Light" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,2,6,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="summaryBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="summaryBorder" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="HiddenTileActionButton"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="Albert Sans Thin" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="4,2,0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="linkBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="linkBorder" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

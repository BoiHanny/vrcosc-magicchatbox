<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:xaml="clr-namespace:vrcosc_magicchatbox.Classes"
    mc:Ignorable="po">

    <!--
        Both files are OpenType VARIABLE fonts with a real `wght` axis - verified with
        Fonts.GetFontFamilies + Typeface.IsBoldSimulated == false at every step, not with
        GlyphTypeface (which only ever reports the default 400 instance of a variable font).

            Albert Sans   wght 100..900 - Thin/ExtraLight/Light/Regular/Medium/SemiBold/Bold/ExtraBold/Black
            Comfortaa     wght 300..700 - Light/Regular/Medium/SemiBold/Bold

        So DO NOT ship static AlbertSans-Bold.ttf / Comfortaa-Bold.ttf and do not add
        <Resource> lines for them: the whole range already ships in these two files, and a
        second family registered at the same /Fonts/ location makes weight resolution
        non-deterministic. Just set FontWeight against FontPrimary / FontSecondary.

        CEILING: Comfortaa stops at 700. FontWeight="ExtraBold" or "Black" on any
        FontSecondary element silently clamps to Bold - there is no warning and no error.
    -->
    <FontFamily x:Key="FontPrimary">/Fonts/#Albert Sans</FontFamily>
    <FontFamily x:Key="FontSecondary">/Fonts/#Comfortaa</FontFamily>

    <!--
        The type scale. The app had drifted to 21 distinct font sizes; these are the eight
        steps everything should land on. Sizes 8, 9, 11.5, 12.5, 13.5, 17, 19, 21, 22, 23
        and 25 are orphans - retire them opportunistically, nearest step wins.
    -->
    <sys:Double x:Key="FontSizeDisplay">27</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeHeading">18</sys:Double>
    <sys:Double x:Key="FontSizeSubheading">16</sys:Double>
    <sys:Double x:Key="FontSizeBody">15</sys:Double>
    <!--  14 and 10 are the two steps the pages actually reach for that the scale could not express.  -->
    <sys:Double x:Key="FontSizeCompact">14</sys:Double>
    <sys:Double x:Key="FontSizeSecondary">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeMicro">11</sys:Double>
    <sys:Double x:Key="FontSizeFine">10</sys:Double>

    <!--
        Lifted from #FFA997BA, which measured exactly 4.50:1 on cards (#FF3B3054) and only
        4.12:1 on the gradient (#FF40365B) - i.e. ~108 field labels sat on or under the AA
        floor. #FFB3A3C4 measures 5.16:1 on cards and 4.72:1 on the gradient. Do not darken.
    -->

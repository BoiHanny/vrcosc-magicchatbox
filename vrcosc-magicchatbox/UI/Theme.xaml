                Grid.ColumnSpan="2"
                Background="#FF2C2148"
                BorderBrush="#FF4A3580"
                BorderThickness="2,0"
                CornerRadius="0" />
            <Path
                x:Name="Arrow"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Data="M 0 0 L 4 4 L 8 0 Z"
                Fill="#FF9B90D1" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#FF6B5CA0" />
                <Setter TargetName="Arrow" Property="Fill" Value="#FFBDAEE2" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="Background" Value="#FF352A52" />
                <Setter TargetName="Border" Property="BorderBrush" Value="#FF7C5CBF" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Border" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


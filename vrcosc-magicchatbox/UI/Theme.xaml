        x:Key="StatusWarningBackgroundBrush"
        po:Freeze="True"
        Color="#33FFC107" />
    <SolidColorBrush
        x:Key="StatusInfoBackgroundBrush"
        po:Freeze="True"
        Color="#2AA98CFF" />
    <SolidColorBrush
        x:Key="StatusSuccessBackgroundBrush"

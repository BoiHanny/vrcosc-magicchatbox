<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:vrcosc_magicchatbox.Classes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:StatusPageViewModel,
                                     IsDesignTimeCreatable=False}"
    Background="{StaticResource SurfaceCardBrush}"
    FontFamily="{DynamicResource FontPrimary}"
    mc:Ignorable="d po">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="StatusDropdownToggleStyle"
                BasedOn="{StaticResource Status_Toggle_style}"
                TargetType="ToggleButton">
                <Setter Property="Foreground" Value="#FFB9B5C1" />
                <Setter Property="FontFamily" Value="/Fonts/#Albert Sans" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="border"
                                Background="{StaticResource Button.Static.Background3}"
                                BorderBrush="{StaticResource Button.Static.Border3}"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Button.MouseOver.Background2}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Button.MouseOver.Border2}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Button.Pressed.Background2}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Button.Pressed.Border2}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF7C5CBF" />
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Button.Pressed.Background2}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusPopupMiniToggleStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="#E7DDFB" />
                <Setter Property="FontFamily" Value="/Fonts/#Albert Sans" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="border"
                                Background="#271D41"
                                BorderBrush="#4A386E"
                                BorderThickness="1"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#332652" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#7155A8" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#9E82DD" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#C8B7F7" />
                                    <Setter Property="Foreground" Value="#28184B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusPopupIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#24134E" />
                <Setter Property="BorderBrush" Value="#4B3386" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#E7DDFB" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#321B68" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#6B48B8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3A2275" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusPopupGroupNameStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#283A2A60" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3A4B3A75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="StatusItemEditToggleStyle"
                BasedOn="{StaticResource Editbutton}"
                TargetType="ToggleButton">
                <Setter Property="Background" Value="#24134E" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="4,0,0,4"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#321B68" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#3A2275" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#9E82DD" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource SurfaceVariantBrush}">
            <Grid Visibility="{Binding IsSelectionMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ComboBox
                        x:Name="SortCombo"
                        Width="115"
                        VerticalContentAlignment="Center"
                        SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="Recently used" Tag="0" />
                        <ComboBoxItem Content="My 💛 cycles" Tag="1" />
                        <ComboBoxItem
                            Content="Creation date"
                            IsSelected="True"
                            Tag="2" />
                        <ComboBoxItem Content="Edit date" Tag="3" />
                    </ComboBox>
                    <Button
                        Width="25"
                        Height="25"
                        Margin="3,0,0,0"
                        Command="{Binding ToggleSortDirectionCommand}"
                        Content="{Binding SortDirectionSymbol}"
                        FontSize="13"
                        Style="{DynamicResource Status_Button_style}"
                        ToolTip="Toggle sort direction" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        FontFamily="/Fonts/#Albert Sans"
                        FontSize="11"
                        Foreground="#66FFFFFF"
                        Text="Group:" />
                    <ToggleButton
                        x:Name="GroupToggle"
                        Height="25"
                        Padding="8,0"
                        Click="GroupToggle_Click"
                        FontSize="12"
                        IsChecked="{Binding IsGroupDropdownOpen, Mode=TwoWay}"
                        Style="{StaticResource StatusDropdownToggleStyle}">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,3,10,0" Text="{Binding SelectedGroupDisplayName}" />
                            <TextBlock
                                Margin="0,0,0,0"
                                FontSize="15"
                                Opacity="0.7"
                                Text="▾" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup
                        AllowsTransparency="True"
                        Closed="GroupPopup_Closed"
                        DataContext="{Binding DataContext, ElementName=GroupToggle}"
                        IsOpen="{Binding IsGroupDropdownOpen, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=GroupToggle}"
                        StaysOpen="False">
                        <Border
                            MinWidth="260"
                            Padding="4"
                            CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#FF221D38" />
                                    <GradientStop Offset="1" Color="#FF1A1630" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FF4A3580" />
                                    <GradientStop Offset="1" Color="#FF2D2050" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>
                                <Thickness>1</Thickness>
                            </Border.BorderThickness>
                            <StackPanel>
                                <Button
                                    Margin="2,2,2,4"
                                    Padding="8,5"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding SelectGroupCommand}"
                                    CommandParameter="{x:Null}"
                                    Style="{StaticResource StatusPopupGroupNameStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            FontSize="13"
                                            Foreground="#9E82DD"
                                            Text="☰" />
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="Normal"
                                            Foreground="WhiteSmoke"
                                            Text="All groups" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            FontSize="11"
                                            Foreground="#9E82DD"
                                            Opacity="0.8"
                                            Text="✓"
                                            Visibility="{Binding IsAllGroupsSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Button>
                                <Separator Margin="4,0,4,6" Background="#3F2970" />
                                <ItemsControl x:Name="GroupListControl" ItemsSource="{Binding ChatStatus.GroupList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                x:Name="GroupRowBorder"
                                                Margin="2,1"
                                                Padding="3"
                                                Background="Transparent"
                                                CornerRadius="5"
                                                Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPopupSelected}" Value="True">
                                                                <Setter Property="Background" Value="#1A9E82DD" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="auto" />
                                                        <ColumnDefinition Width="50" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        Grid.Column="0"
                                                        Padding="4,3"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StatusPopupGroupNameStyle}"
                                                        Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock
                                                                FontSize="13"
                                                                Foreground="WhiteSmoke"
                                                                Text="{Binding Name}" />
                                                            <TextBlock
                                                                Margin="8,0,0,0"
                                                                FontSize="11"
                                                                Foreground="#9E82DD"
                                                                Opacity="0.8"
                                                                Text="✓"
                                                                Visibility="{Binding IsPopupSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <TextBox
                                                        Grid.Column="0"
                                                        Padding="4,2"
                                                        VerticalContentAlignment="Center"
                                                        Background="#2C2148"
                                                        BorderBrush="#7C5CBF"
                                                        BorderThickness="1"
                                                        FontSize="13"
                                                        Foreground="WhiteSmoke"
                                                        KeyDown="RenameGroupTextBox_KeyDown"
                                                        MaxLength="50"
                                                        Tag="{Binding}"
                                                        Text="{Binding RenameBuffer, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBox.Resources>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="CornerRadius" Value="3" />
                                                            </Style>
                                                        </TextBox.Resources>
                                                    </TextBox>
                                                    <Button
                                                        Grid.Column="1"
                                                        Width="20"
                                                        Height="20"
                                                        Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource Deletebutton}"
                                                        ToolTip="Delete group"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <Image
                                                            Width="11"
                                                            Height="11"
                                                            Source="/MagicChatbox;component/Img/Icons/Delete_ico.png" />
                                                    </Button>
                                                    <Button
                                                        Grid.Column="2"
                                                        Width="20"
                                                        Height="20"
                                                        Click="BeginRenameGroup_Click"
                                                        Style="{StaticResource StatusPopupIconButtonStyle}"
                                                        Tag="{Binding}"
                                                        ToolTip="Rename group"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <Image
                                                            Width="11"
                                                            Height="11"
                                                            Source="/MagicChatbox;component/Img/Icons/Edit_ico.png" />
                                                    </Button>
                                                    <Button
                                                        Grid.Column="3"
                                                        Width="20"
                                                        Height="20"
                                                        Command="{Binding DataContext.ShareGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="📤"
                                                        FontSize="10"
                                                        Style="{StaticResource StatusPopupIconButtonStyle}"
                                                        ToolTip="Export this group" />
                                                    <ToggleButton
                                                        Grid.Column="4"
                                                        Width="44"
                                                        Height="22"
                                                        Command="{Binding DataContext.ToggleGroupCycleActiveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="CYCLE"
                                                        FontSize="10"
                                                        IsChecked="{Binding IsActiveForCycle}"
                                                        Style="{StaticResource StatusPopupMiniToggleStyle}"
                                                        ToolTip="Include in status cycle" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="4,6,4,4" Background="#3F2970" />
                                <StackPanel
                                    Margin="2,2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBox
                                        x:Name="NewGroupTextBox"
                                        Width="135"
                                        Height="26"
                                        Padding="5,0"
                                        VerticalContentAlignment="Center"
                                        FontSize="12"
                                        Foreground="WhiteSmoke"
                                        KeyDown="NewGroupTextBox_KeyDown"
                                        MaxLength="50"
                                        Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Width="30"
                                        Height="26"
                                        Margin="3,0,0,0"
                                        Command="{Binding ConfirmAddGroupCommand}"
                                        Content="+"
                                        FontSize="16"
                                        Style="{DynamicResource Status_Button_style}"
                                        ToolTip="Create group" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button
                        Width="25"
                        Height="25"
                        Margin="4,0,0,0"
                        Command="{Binding ShareCurrentGroupCommand}"
                        Content="📤"
                        FontSize="12"
                        Style="{DynamicResource Status_Button_style}"
                        ToolTip="Export current group" />
                    <Button
                        Width="25"
                        Height="25"
                        Margin="3,0,0,0"
                        Command="{Binding ImportStatusCommand}"
                        Content="📥"
                        FontSize="12"
                        Style="{DynamicResource Status_Button_style}"
                        ToolTip="Import status messages" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="25"
                        Margin="0,0,3,0"
                        Padding="6,0"
                        Command="{Binding EnterSelectionModeCommand}"
                        Content="⊞  Select"
                        Style="{DynamicResource Status_Button_style}"
                        ToolTip="Enter selection mode" />
                    <ToggleButton
                        Width="90"
                        Height="25"
                        Margin="0,0,3,0"
                        Content="Auto 💛 cycle"
                        IsChecked="{Binding AppSettings.CycleStatus, Mode=TwoWay}"
                        Style="{StaticResource GlowyToggleButton}"
                        ToolTip="Automatically cycle through your statuses" />
                    <ToggleButton
                        Width="30"
                        Height="25"
                        Margin="0,0,3,0"
                        Command="{Binding ToggleCycleOverrideCommand}"
                        Content="📌"
                        FontSize="13"
                        IsChecked="{Binding AppSettings.CycleOverrideCurrentGroup, Mode=TwoWay}"
                        IsEnabled="{Binding AppSettings.CycleStatus}"
                        Style="{StaticResource GlowyToggleButton}"
                        ToolTip="Pin: Only cycle items from the currently selected group" />
                    <Button
                        Margin="0"
                        Command="{Binding ActivateSettingCommand}"
                        CommandParameter="Settings_Status"
                        Opacity="0.6"
                        Style="{DynamicResource LINK_Button_style}"
                        ToolTip="Customize status settings">
                        <Image
                            Width="18"
                            Height="18"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/MagicChatbox;component/Img/Icons/Next_ico.png" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Height="25"
                    Margin="8,0,0,0"
                    Padding="8,0"
                    Command="{Binding ExitSelectionModeCommand}"
                    Content="✕  Cancel"
                    Style="{DynamicResource Status_Button_style}" />
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        Height="25"
                        Margin="0,0,8,0"
                        Padding="8,0"
                        Command="{Binding SelectNoneCommand}"
                        Content="Deselect"
                        Style="{DynamicResource Status_Button_style}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="/Fonts/#Albert Sans"
                        FontSize="13"
                        Foreground="#AAA3B7"
                        Text="{Binding SelectedItems.Count, StringFormat='{}{0} selected'}" />
                    <Button
                        Height="25"
                        Margin="8,0,0,0"
                        Padding="8,0"
                        Command="{Binding SelectAllCommand}"
                        Content="Select All"
                        Style="{DynamicResource Status_Button_style}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Height="25"
                        Margin="0,0,3,0"
                        Padding="6,0"
                        Command="{Binding DeleteSelectedCommand}"
                        Content="🗑 Delete"
                        Style="{DynamicResource Status_Button_style}"
                        ToolTip="Delete selected statuses" />
                    <Button
                        Height="25"
                        Margin="0,0,3,0"
                        Padding="6,0"
                        Command="{Binding CloneSelectedCommand}"
                        Content="⧉ Clone"
                        Style="{DynamicResource Status_Button_style}"
                        ToolTip="Duplicate selected statuses" />
                    <Button
                        Height="25"
                        Margin="0,0,3,0"
                        Padding="6,0"
                        Command="{Binding ShareSelectedItemsCommand}"
                        Style="{DynamicResource Status_Button_style}"
                        ToolTip="Export selected statuses">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📤 Share " />
                            <TextBlock Text="{Binding SelectedItems.Count, StringFormat='({0})'}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="MoveToGroupToggle"
                        Height="25"
                        Padding="6,0"
                        Click="MoveToggle_Click"
                        Style="{StaticResource StatusDropdownToggleStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Move to…" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontSize="9"
                                Opacity="0.7"
                                Text="▾" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup
                        AllowsTransparency="True"
                        Closed="MovePopup_Closed"
                        DataContext="{Binding DataContext, ElementName=MoveToGroupToggle}"
                        IsOpen="{Binding IsChecked, ElementName=MoveToGroupToggle}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=MoveToGroupToggle}"
                        StaysOpen="False">
                        <Border
                            MinWidth="160"
                            Padding="6"
                            Background="#1E1B33"
                            BorderBrush="#3F2970"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel>
                                <TextBlock
                                    Margin="6,2,6,6"
                                    FontFamily="/Fonts/#Albert Sans"
                                    FontSize="10"
                                    Foreground="#66FFFFFF"
                                    Text="Move selected items to:" />
                                <ItemsControl ItemsSource="{Binding ChatStatus.GroupList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="2,1"
                                                Padding="10,6"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.MoveSelectedToGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Style="{StaticResource StatusPopupGroupNameStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Opacity="0.5"
                                                        Text="📁 " />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="#D0C8E4"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="#80A39BB6"
                IsHitTestVisible="False" />
        </Grid>

        <ListBox
            Name="Statusitems"
            Grid.Row="1"
            Margin="5"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding FilteredView}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.CacheLength="2"
            VirtualizingPanel.CacheLengthUnit="Page"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.Resources>
                <DropShadowEffect
                    x:Key="StatusEditTextShadow"
                    po:Freeze="True"
                    BlurRadius="18"
                    Opacity="0.9"
                    RenderingBias="Performance"
                    ShadowDepth="0"
                    Color="{StaticResource AccentLightBlueColor}" />

                <!--
                    Top-to-bottom on purpose, not corner-to-corner: at this row's own height every x
                    position along a line of text sees the same background color, so the card can go
                    richer than a flat fill without any letter landing on a lighter patch than its
                    neighbour. A corner-to-corner gradient tried that first and read as washed-out,
                    because different parts of the same line of text sat on different parts of it.
                -->
                <LinearGradientBrush x:Key="StatusRowSurfaceBrush" po:Freeze="True" StartPoint="0,0.5" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF4A4070" />
                    <GradientStop Offset="1" Color="#FF2C2448" />
                </LinearGradientBrush>
                <LinearGradientBrush x:Key="StatusRowSelectedBrush" po:Freeze="True" StartPoint="0,0.5" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF5C5296" />
                    <GradientStop Offset="1" Color="#FF3A3162" />
                </LinearGradientBrush>

                <Style x:Key="ActiveStatusText" TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextSuccessLightBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Foreground" Value="LightGray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style
                    x:Key="ActiveStatusTextEdit"
                    BasedOn="{StaticResource InlineTransparentTextBox}"
                    TargetType="TextBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextSuccessLightBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Foreground" Value="LightGray" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style
                    x:Key="ActiveStatusTextEditShadow"
                    BasedOn="{StaticResource ActiveStatusTextEdit}"
                    TargetType="TextBox">
                    <Setter Property="Effect" Value="{StaticResource StatusEditTextShadow}" />
                    <Setter Property="CacheMode">
                        <Setter.Value>
                            <BitmapCache RenderAtScale="1.0" />
                        </Setter.Value>
                    </Setter>
                </Style>

                <!--
                    The row card itself. IsMouseOver only ever brightens the border - the same touch
                    ChatComposerShell uses - because a hover state that changed the fill on top of a
                    gradient would fight the gradient every frame; a border is one solid color and costs
                    nothing extra to swap.
                -->
                <Style x:Key="StatusRowCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource StatusRowSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="#FF150C33" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource StatusRowSelectedBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentLightPurpleBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderAccentPurpleBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="5"
                        ClipToBounds="True"
                        CornerRadius="5"
                        MouseLeftButtonUp="StatusItemRow_MouseLeftButtonUp"
                        Style="{StaticResource StatusRowCardStyle}"
                        Tag="{Binding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                No separate live-rail here: it would sit at the same edge the activate
                                icon already fills edge to edge, so it would never be visible behind it.
                                The green-bordered icon that replaces the plain activate button already
                                says "this one is live" on its own.
                            -->
                            <Grid Grid.Column="0" Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Border
                                    Background="{StaticResource SurfaceButtonDarkBrush}"
                                    BorderBrush="#B170C5"
                                    BorderThickness="2,1.5,2,1.5"
                                    CornerRadius="4,0,0,4">
                                    <Image
                                        Width="22"
                                        Height="22"
                                        Source="/MagicChatbox;component/Img/Icons/ActivatedStatus_ico.png"
                                        Stretch="Uniform" />
                                </Border>
                                <Button
                                    Name="Activatebutton"
                                    Width="35"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceButtonDarkBrush}"
                                    Command="{Binding DataContext.ActivateStatusCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    Style="{DynamicResource Activatebutton}"
                                    Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <Image
                                        Width="22"
                                        Height="22"
                                        Source="/MagicChatbox;component/Img/Icons/ActivateStatus_ico.png"
                                        Stretch="Uniform" />
                                </Button>
                            </Grid>

                            <CheckBox
                                Grid.Column="0"
                                Margin="6,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="StatusItemCheckBox_Click"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                Style="{DynamicResource SettingsCheckbox}"
                                Tag="{Binding}"
                                Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <Button
                                x:Name="Deletebutton"
                                Grid.Column="1"
                                Width="30"
                                Height="35"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="#3F2970"
                                Click="DeleteButton_Click"
                                Cursor="Hand"
                                Style="{DynamicResource Deletebutton}"
                                Tag="{Binding}"
                                Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Image
                                    Width="20"
                                    Height="20"
                                    Source="/MagicChatbox;component/Img/Icons/Delete_ico.png" />
                            </Button>

                            <TextBlock
                                Grid.Column="2"
                                Margin="10,0,6,0"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Comfortaa"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Style="{StaticResource ActiveStatusText}"
                                Text="{Binding msg}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Name="EditTextBox"
                                Grid.Column="2"
                                Margin="7,0,30,0"
                                VerticalAlignment="Center"
                                local:TextBoxBehaviour.HandleEnterKey="True"
                                Background="Transparent"
                                FontFamily="/Fonts/#Comfortaa"
                                FontSize="16"
                                FontWeight="Medium"
                                IsReadOnly="{Binding IsEditing, Converter={StaticResource InvertBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ActiveStatusTextEditShadow}"
                                Text="{Binding editMsg}"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Name="CancelEditbutton"
                                Grid.Column="2"
                                Width="20"
                                Height="20"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{StaticResource StatusErrorDarkBrush}"
                                Click="CancelEditbutton_Click"
                                Cursor="Hand"
                                Style="{DynamicResource CancelEditbutton}"
                                Tag="{Binding}"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <Image
                                    Width="15"
                                    Height="15"
                                    Source="/MagicChatbox;component/Img/Icons/Cross_ico.png" />
                            </Button>

                            <ToggleButton
                                x:Name="Editbutton"
                                Grid.Column="3"
                                Width="25"
                                Height="35"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceButtonPanelBrush}"
                                Checked="Editbutton_Checked"
                                Cursor="Hand"
                                IsChecked="{Binding IsEditing}"
                                Style="{StaticResource StatusItemEditToggleStyle}"
                                Tag="{Binding}"
                                Unchecked="Editbutton_Checked"
                                Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Image
                                    Width="15"
                                    Height="15"
                                    RenderOptions.BitmapScalingMode="Linear"
                                    Source="/MagicChatbox;component/Img/Icons/Edit_ico.png" />
                            </ToggleButton>

                            <ComboBox
                                Grid.Column="4"
                                Width="90"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Name"
                                FontSize="12"
                                ItemsSource="{Binding DataContext.ChatStatus.GroupList, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                SelectedValue="{Binding GroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="GroupId"
                                Style="{StaticResource FlatComboBoxStyle}"
                                ToolTip="Assign to group"
                                Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                            <Button
                                Name="Favbutton"
                                Grid.Column="5"
                                Width="35"
                                Height="35"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Click="Favbutton_Click"
                                Cursor="Hand"
                                Style="{DynamicResource Favbutton}"
                                Visibility="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Image Width="22" Height="22">
                                    <Image.Style>
                                        <Style>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseInCycle}" Value="True">
                                                    <Setter Property="Image.Source" Value="/MagicChatbox;component/Img/Icons/Unfavorite_ico.png" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UseInCycle}" Value="False">
                                                    <Setter Property="Image.Source" Value="/MagicChatbox;component/Img/Icons/Favorite_ico.png" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Background="{StaticResource SurfaceVariantBrush}">
            <Border
                Height="1"
                VerticalAlignment="Top"
                Background="#80A39BB6"
                IsHitTestVisible="False" />
            <TextBlock
                Margin="16,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="/Fonts/#Albert Sans"
                FontSize="16"
                Foreground="{StaticResource TextLabelBrush}"
                Text="{Binding ChatStatus.StatusTopBarTxt}" />
        </Grid>

        <Grid
            Grid.Row="3"
            Height="auto"
            Margin="10,10"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox
                    x:Name="NewFavText"
                    MinHeight="40"
                    Padding="4,0,58,0"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    FontSize="15"
                    KeyDown="FavBox_KeyDown"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    Style="{StaticResource LightInputTextBox}"
                    Text="{Binding ChatStatus.NewStatusItemTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextAlignment="Left"
                    TextChanged="NewFavText_TextChanged" />
                <TextBlock
                    Width="auto"
                    Margin="0,0,8,0"
                    Padding="0,3,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="/Fonts/#Albert Sans"
                    FontSize="12"
                    Foreground="{Binding ChatStatus.StatusBoxColor}"
                    Text="{Binding ChatStatus.StatusBoxCount}" />
                <TextBlock
                    Margin="0,0,58,0"
                    Padding="12,0,5,0"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Foreground="{StaticResource TextDarkMutedBrush}"
                    IsHitTestVisible="False"
                    Text="Create here a new status"
                    TextAlignment="Left">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=NewFavText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button
                x:Name="AddFav"
                Grid.Column="1"
                Width="75"
                Margin="8,0,0,0"
                Click="AddFav_Click"
                Content="Create"
                Style="{DynamicResource Status_Button_style}" />
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.WeatherSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modules="clr-namespace:vrcosc_magicchatbox.Classes.Modules"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=sections:WeatherSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_Weather, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Weather options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>
        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_Weather, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>
                <StackPanel
                    Width="auto"
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left">

                    <!--
                        Nine placeholders and no feedback loop was the worst of it: the only way to
                        find out what a template produced was to join a world and read the chatbox.
                        Built from fixed sample readings, so it works before the first sync.
                    -->
                    <controls:SegmentPreview
                        Width="420"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Left"
                        Caption="What goes in your chatbox (sample weather)"
                        Line="{Binding OutputPreview}" />

                    <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Check the weather every (minutes)" />
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <TextBox
                            x:Name="WeatherRefreshInterval"
                            Width="40"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WeatherSettings.WeatherUpdateIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Name="WeatherSyncNow"
                            Width="60"
                            Height="26"
                            Margin="6,0,0,0"
                            Padding="6,0,6,0"
                            Command="{Binding WeatherSyncCommand}"
                            Style="{StaticResource Status_Button_style}">
                            <TextBlock FontSize="{StaticResource FontSizeCaption}" Text="Check now" />
                        </Button>
                        <TextBlock
                            Margin="8,3,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSecondary}"
                            Foreground="{StaticResource TextLabelBrush}"
                            Text="{Binding IntegrationDisplay.WeatherLastSyncDisplay}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Which place to report" />
                    <ComboBox
                        Width="220"
                        Margin="2,4"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Source={x:Static modules:WeatherSettings.AvailableLocationModes}}"
                        SelectedItem="{Binding WeatherSettings.WeatherLocationMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding WeatherSettings.WeatherLocationModeIsIPBased, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <CheckBox
                            x:Name="WeatherAllowIPLocation_checkbox"
                            Margin="0,0,0,0"
                            IsChecked="{Binding WeatherSettings.WeatherAllowIPLocation, Mode=TwoWay}">
                            Work out my place from my internet connection (uses ipapi.co)
                        </CheckBox>
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="You have not allowed this, so the fallback city below is used instead."
                            Visibility="{Binding WeatherSettings.WeatherIpConsentMissing, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding WeatherSettings.WeatherLocationModeUsesCity, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="City"
                            Visibility="{Binding WeatherSettings.WeatherLocationModeIsCustomCity, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="City to fall back on"
                            Visibility="{Binding WeatherSettings.WeatherLocationModeIsIPBased, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                            <ToggleButton
                                Width="26"
                                Height="26"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceButtonPanelBrush}"
                                BorderBrush="{StaticResource BorderAccentPurpleBrush}"
                                IsChecked="{Binding WeatherSettings.WeatherLocationEditing, Mode=TwoWay}"
                                Style="{DynamicResource Editbutton}"
                                ToolTip="Edit city">
                                <Image
                                    Width="19"
                                    Height="19"
                                    Source="/Img/Icons/admin.png" />
                            </ToggleButton>
                            <Grid Width="200" HorizontalAlignment="Left">

                                <TextBox
                                    x:Name="WeatherCityPreview"
                                    Padding="5,0,0,0"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    IsHitTestVisible="False"
                                    IsReadOnly="True"
                                    Text="{Binding WeatherSettings.WeatherLocationCity, Converter={StaticResource MaskedWeatherCityConverter}}">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource TileRightTextBox}" TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WeatherSettings.WeatherLocationEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBox
                                    x:Name="WeatherCityEditor"
                                    Padding="5,0,0,0"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding WeatherSettings.WeatherLocationCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Style>
                                        <Style BasedOn="{StaticResource TileRightTextBox}" TargetType="TextBox">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WeatherSettings.WeatherLocationEditing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Default: London" />
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding WeatherSettings.WeatherLocationModeIsCustomCoordinates, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Coordinates (latitude, longitude)" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox
                                x:Name="WeatherLatitude"
                                Width="80"
                                Margin="0,3,6,0"
                                Padding="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding WeatherSettings.WeatherLocationLatitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Name="WeatherLongitude"
                                Width="80"
                                Margin="0,3,0,0"
                                Padding="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding WeatherSettings.WeatherLocationLongitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Example: 51.5074, -0.1278" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="One line or two" />
                    <ComboBox
                        Width="200"
                        Margin="2,4"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Source={x:Static modules:WeatherSettings.AvailableLayoutModes}}"
                        SelectedItem="{Binding WeatherSettings.WeatherLayoutMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding WeatherSettings.WeatherTemplateIsEmpty, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Which comes first" />
                        <ComboBox
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Source={x:Static modules:WeatherSettings.AvailableOrders}}"
                            SelectedItem="{Binding WeatherSettings.WeatherOrder, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="What goes between the clock and the weather" />
                        <TextBox
                            x:Name="WeatherSeparator"
                            Width="120"
                            Margin="0,3,0,0"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WeatherSettings.WeatherSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <!--
                            Honest about a limit the preview would otherwise make look like a bug:
                            the chatbox builder keeps the clock and the weather as two separate
                            pieces and joins them itself, so these two reach the Discord line only.
                        -->
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="This box and 'Which comes first' shape your Discord status. In the chatbox the clock and the weather are separate pieces that the app joins itself, so neither one moves the preview." />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="What goes between each weather value" />
                        <TextBox
                            x:Name="WeatherStatsSeparator"
                            Width="120"
                            Margin="0,3,0,0"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WeatherSettings.WeatherStatsSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Sits between the temperature, the sky, feels-like, wind and humidity." />
                    </StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Write your own line" />
                    <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="Type anything you like and drop these in where you want the values: {time}, {weather}, {temp}, {unit}, {tempWithUnit}, {condition}, {humidity}, {wind}, {feels}. Leave it empty to use the boxes above instead." />
                    <TextBox
                        x:Name="WeatherTemplate"
                        Width="360"
                        Margin="0,3,0,0"
                        Padding="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        FontSize="{StaticResource FontSizeBody}"
                        Text="{Binding WeatherSettings.WeatherTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Your line is in charge now, so the separator boxes above are ignored."
                        Visibility="{Binding WeatherSettings.WeatherTemplateHasValue, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Tip: type \n where you want the rest to start on a new line." />
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What to include" />
                    <CheckBox
                        x:Name="ShowWeatherCondition_checkbox"
                        Margin="0,12,0,6"
                        Content="Say what the sky is doing (Overcast, Showers)"
                        IsChecked="{Binding WeatherSettings.ShowWeatherCondition, Mode=TwoWay}" />
                    <CheckBox
                        x:Name="WeatherCustomOverridesEnabled_checkbox"
                        Margin="0,0,0,6"
                        Content="Use my own icons and wording for each kind of weather"
                        IsChecked="{Binding WeatherSettings.WeatherCustomOverridesEnabled, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Your wording"
                        Visibility="{Binding WeatherSettings.WeatherCustomOverridesEnabled, Converter={StaticResource InverseBoolToHiddenConverter}}" />
                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Leave a box empty to keep the standard wording."
                        Visibility="{Binding WeatherSettings.WeatherCustomOverridesEnabled, Converter={StaticResource InverseBoolToHiddenConverter}}" />
                    <ItemsControl
                        Margin="0,2,0,8"
                        IsEnabled="{Binding WeatherSettings.WeatherCustomOverridesEnabled}"
                        ItemsSource="{Binding WeatherOverride.Items}"
                        Visibility="{Binding WeatherSettings.WeatherCustomOverridesEnabled, Converter={StaticResource InverseBoolToHiddenConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="220"
                                    Margin="0,0,10,10"
                                    Padding="6"
                                    CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                                            <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                                            <GradientStop Offset="1" Color="{StaticResource GradientDeepPurpleColor}" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            Style="{StaticResource OptionFieldLabelStyle}"
                                            Text="{Binding DisplayLabel}" />
                                        <Border
                                            Padding="4"
                                            Background="{StaticResource SurfaceVariantBrush}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource WeatherOverrideFieldLabel}"
                                                    Text="Icon" />
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    Style="{StaticResource WeatherOverrideFieldLabel}"
                                                    Text="Words" />
                                                <TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Padding="0"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Style="{StaticResource WeatherOverrideInput}"
                                                    Text="{Binding CustomIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    VerticalContentAlignment="Center"
                                                    Style="{StaticResource WeatherOverrideInput}"
                                                    Text="{Binding CustomText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Left box replaces the icon, right box replaces the words."
                        Visibility="{Binding WeatherSettings.WeatherCustomOverridesEnabled, Converter={StaticResource InverseBoolToHiddenConverter}}" />
                    <CheckBox
                        x:Name="ShowWeatherEmoji_checkbox"
                        Margin="0,0,0,6"
                        Content="Show a weather icon"
                        IsChecked="{Binding WeatherSettings.ShowWeatherEmoji, Mode=TwoWay}" />
                    <CheckBox
                        x:Name="WeatherUseDecimal_checkbox"
                        Margin="0,0,0,0"
                        Content="Show one decimal place (21.4 instead of 21)"
                        IsChecked="{Binding WeatherSettings.WeatherUseDecimal, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Temperature in" />
                    <ComboBox
                        Width="200"
                        Margin="0,4"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Source={x:Static modules:WeatherSettings.AvailableUnitOverrides}}"
                        SelectedItem="{Binding WeatherSettings.WeatherUnitOverride, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Wind speed in" />
                    <ComboBox
                        Width="220"
                        Margin="0,4"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Source={x:Static modules:WeatherSettings.AvailableWindUnitOverrides}}"
                        SelectedItem="{Binding WeatherSettings.WeatherWindUnitOverride, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox
                        x:Name="ShowWeatherHumidity_checkbox"
                        Margin="0,12,0,6"
                        Content="Show humidity"
                        IsChecked="{Binding WeatherSettings.ShowWeatherHumidity, Mode=TwoWay}" />
                    <CheckBox
                        x:Name="ShowWeatherWind_checkbox"
                        Margin="0,0,0,6"
                        Content="Show wind speed"
                        IsChecked="{Binding WeatherSettings.ShowWeatherWind, Mode=TwoWay}" />
                    <CheckBox
                        x:Name="ShowWeatherFeelsLike_checkbox"
                        Margin="0,0,0,6"
                        Content="Show what it feels like"
                        IsChecked="{Binding WeatherSettings.ShowWeatherFeelsLike, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="When the weather cannot be fetched" />
                    <ComboBox
                        Width="200"
                        Margin="0,4"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Source={x:Static modules:WeatherSettings.AvailableFallbackModes}}"
                        SelectedItem="{Binding WeatherSettings.WeatherFallbackMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

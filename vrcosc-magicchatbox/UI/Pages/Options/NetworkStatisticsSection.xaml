<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.NetworkStatisticsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:NetworkStatisticsSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_NetworkStatistics, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Network statistics options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>
        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,0,0,0"
            Visibility="{Binding AppSettings.Settings_NetworkStatistics, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>
                <!--  The readings run to a handful of characters each, so the line is the only
                      honest way to show what turning one on costs.  -->
                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What goes in the chatbox" />
                        <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="Example numbers — yours will differ, but the wording and the length will look like this." />
                        <controls:SegmentPreview Line="{Binding PreviewLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Right now" />
                        <CheckBox
                            x:Name="NetworkStats_ShowCurrentDown_checkbox"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.ShowCurrentDown, Mode=TwoWay}">
                            Show how fast you are downloading
                        </CheckBox>
                        <CheckBox
                            x:Name="NetworkStats_ShowCurrentUp_checkbox"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.ShowCurrentUp, Mode=TwoWay}">
                            Show how fast you are uploading
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Best and total since the app started" />
                        <CheckBox
                            x:Name="NetworkStats_ShowMaxDown_checkbox"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.ShowMaxDown, Mode=TwoWay}">
                            Show your fastest download so far
                        </CheckBox>
                        <CheckBox
                            x:Name="NetworkStats_ShowMaxUp_checkbox"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.ShowMaxUp, Mode=TwoWay}">
                            Show your fastest upload so far
                        </CheckBox>
                        <CheckBox
                            x:Name="NetworkStats_ShowTotalDown_checkbox"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.ShowTotalDown, Mode=TwoWay}">
                            Show how much you have downloaded in total
                        </CheckBox>
                        <CheckBox
                            x:Name="NetworkStats_ShowTotalUp_checkbox"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.ShowTotalUp, Mode=TwoWay}">
                            Show how much you have uploaded in total
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="How busy your connection is" />
                        <CheckBox
                            x:Name="NetworkStats_ShowNetworkUtilization_checkbox"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.ShowNetworkUtilization, Mode=TwoWay}">
                            Show how much of your connection is in use, as a percentage
                        </CheckBox>
                        <TextBlock
                            Margin="7,2,0,4"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="The percentage needs something to be a percentage of. Leave the box below unticked and it is measured against your own fastest download so far; tick it and it is measured against the speed your network adapter says it can do, which is usually much higher, so the percentage will look lower." />
                        <CheckBox
                            x:Name="NetworkStats_UseInterfaceMaxSpeed"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.UseInterfaceMaxSpeed, Mode=TwoWay}">
                            Compare against the adapter's rated speed instead
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Margin="7,0,0,4"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Shrinks the words next to the numbers so the numbers stand out. Watch the preview above." />
                        <CheckBox
                            x:Name="NetworkStats_StyledCharacters_checkbox"
                            Margin="5"
                            IsChecked="{Binding NetworkStatsModule.Settings.StyledCharacters, Mode=TwoWay}">
                            Small raised labels — ᵈᵒʷⁿ instead of Down
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

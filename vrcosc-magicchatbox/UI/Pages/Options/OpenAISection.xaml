<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.OpenAISection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=sections:OpenAISectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_OpenAI, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="OpenAI options"
                TextOptions.TextRenderingMode="ClearType" />
            <TextBlock
                x:Name="LearnMoreAboutOpenAIbtn"
                Width="auto"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Cursor="Hand"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource AccentTealBrush}"
                MouseUp="LearnMoreAboutOpenAIbtn_MouseUp"
                Text="Terms of use"
                TextDecorations="Underline" />
            <TextBlock
                x:Name="MyUsageBtn"
                Width="auto"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Cursor="Hand"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource AccentTealBrush}"
                MouseUp="MyUsageBtn_MouseUp"
                Text="My usage"
                TextDecorations="Underline" />

        </StackPanel>
        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,0,0,0"
            Visibility="{Binding AppSettings.Settings_OpenAI, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>

                <Border Margin="0,5,0,10" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="ConnectWithOpenAI"
                            Width="auto"
                            Height="30"
                            Padding="5"
                            Click="ConnectWithOpenAI_Click"
                            Style="{StaticResource Status_Button_style}"
                            Visibility="{Binding OpenAI.Connected, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="21"
                                            Height="18"
                                            Margin="0,0,3,0"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="/Img/Icons/OpenAI.png" />
                                        <TextBlock
                                            Margin="0,-2,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeCompact}"
                                            Text="Connect with OpenAI" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button
                            x:Name="ConnectedWithOpenAI"
                            Width="185"
                            Height="30"
                            Padding="5"
                            HorizontalAlignment="Left"
                            d:Visibility="Visible"
                            Style="{StaticResource Status_Button_style}"
                            Visibility="{Binding OpenAI.Connected, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="2,0,5,0"
                                            VerticalAlignment="Center"
                                            Source="/Img/Icons/yes.png" />
                                        <TextBlock
                                            Margin="0,-2,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeCompact}"
                                            Text="Connected with OpenAI" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button
                            x:Name="DisconnectOpenAI"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="20"
                            Height="30"
                            Margin="-5,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            d:Visibility="Visible"
                            Background="{StaticResource StatusErrorDarkerBrush}"
                            BorderThickness="0"
                            Command="{Binding DisconnectOpenAICommand}"
                            Cursor="Hand"
                            Style="{DynamicResource DisconnectPulsoid}"
                            Visibility="{Binding OpenAI.Connected, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <Grid>
                                <Image
                                    Width="15"
                                    Height="15"
                                    RenderOptions.BitmapScalingMode="Linear"
                                    Source="/Img/Icons/Cross_v1_ico.png" />
                            </Grid>
                        </Button>
                        <TextBlock
                            Width="400"
                            Padding="10,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeBody}"
                            Foreground="{StaticResource TextDangerRedBrush}"
                            Text="{Binding OpenAI.AccessErrorTxt, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            Visibility="{Binding OpenAI.AccessError, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <CheckBox
                            x:Name="PerformModerationCheck"
                            IsChecked="{Binding Modules.IntelliChat.Settings.IntelliChatPerformModeration, Mode=TwoWay}">
                            Check messages with OpenAI's free content filter before they are used
                        </CheckBox>

                    </StackPanel>
                </Border>


                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Padding="2,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionSubsectionHeaderStyle}"
                            Text="Rewrite what you typed" />

                        <TextBlock
                            Width="auto"
                            Padding="2,3,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="The wand button in the chat box rewrites your message in the style you pick here. Your text is sent to OpenAI to do it." />
                        <TextBlock
                            Width="auto"
                            Padding="2,14,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Style" />
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <ComboBox
                                x:Name="WritingStylesComboBox"
                                Width="200"
                                Margin="2,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DisplayMemberPath="StyleName"
                                ItemsSource="{Binding Modules.IntelliChat.Settings.SupportedWritingStyles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedItem="{Binding Modules.IntelliChat.Settings.SelectedWritingStyle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Width="auto"
                                Padding="2,2,0,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeCaption}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="{Binding Modules.IntelliChat.Settings.SelectedWritingStyle.StyleDescription}" />
                        </StackPanel>

                        <TextBlock
                            Width="auto"
                            Padding="2,7,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Model" />
                        <ComboBox
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Modules.IntelliChat.AvailableChatModels}"
                            SelectedValue="{Binding Modules.IntelliChat.Settings.PerformBeautifySentenceModel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>



                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Padding="2,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionSubsectionHeaderStyle}"
                            Text="Translate what you typed" />

                        <TextBlock
                            Width="auto"
                            Padding="2,3,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="The translate button in the chat box turns your message into the language you pick here." />

                        <CheckBox
                            x:Name="AutoDetectLang"
                            Margin="2,14,0,0"
                            IsChecked="{Binding Modules.IntelliChat.Settings.AutolanguageSelection, Mode=TwoWay}"
                            Visibility="Collapsed">
                            Work out the language on its own (costs less)
                        </CheckBox>

                        <TextBlock
                            Width="auto"
                            Padding="2,14,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Translate into" />

                        <ComboBox
                            x:Name="SelectedTranslateLanguageComboBox"
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Language"
                            ItemsSource="{Binding Modules.IntelliChat.Settings.SupportedLanguages, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding Modules.IntelliChat.Settings.SelectedTranslateLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                        <TextBlock
                            Width="auto"
                            Padding="2,7,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Model" />
                        <ComboBox
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Modules.IntelliChat.AvailableChatModels}"
                            SelectedValue="{Binding Modules.IntelliChat.Settings.PerformLanguageTranslationModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>


                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Padding="2,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionSubsectionHeaderStyle}"
                            Text="Talk instead of typing" />

                        <TextBlock
                            Width="auto"
                            Padding="2,3,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Records from your microphone and drops what you said into the chat box as text." />
                        <TextBlock
                            Width="auto"
                            Padding="2,14,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Microphone" />
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <ComboBox
                                x:Name="SelectedDeviceComboBox"
                                Width="200"
                                Margin="2,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DisplayMemberPath="DeviceName"
                                ItemsSource="{Binding Modules.Whisper.Settings.AvailableDevices}"
                                SelectedValue="{Binding Modules.Whisper.Settings.SelectedDeviceIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="DeviceIndex" />

                        </StackPanel>
                        <TextBlock
                            Width="auto"
                            Padding="2,7,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Model" />
                        <ComboBox
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Modules.Whisper.Settings.AvailableSTTModels}"
                            SelectedValue="{Binding Modules.Whisper.Settings.SpeechToTextModel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock
                            Width="600"
                            Padding="2,14,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Speak whichever language you like - the model works it out. Switch translation on below to have it come out in one particular language instead."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Width="600"
                            Margin="0"
                            Padding="2,0,0,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Only the Whisper model can translate"
                            TextWrapping="Wrap" />
                        <CheckBox
                            x:Name="TranslateToCustomLanguage"
                            Margin="4,0,4,4"
                            IsChecked="{Binding Modules.Whisper.Settings.TranslateToCustomLanguage, Mode=TwoWay}">
                            Translate what I say into another language
                        </CheckBox>
                        <TextBlock
                            Width="auto"
                            Padding="2,8,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Into"
                            Visibility="{Binding Modules.Whisper.Settings.TranslateToCustomLanguage, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding Modules.Whisper.Settings.TranslateToCustomLanguage, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox
                                x:Name="SelectedSpeechToTextLanguageComboBox"
                                Width="200"
                                Margin="2,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                DisplayMemberPath="Language"
                                ItemsSource="{Binding Modules.Whisper.Settings.SpeechToTextLanguages}"
                                SelectedValue="{Binding Modules.Whisper.Settings.SelectedSpeechToTextLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>

                        <StackPanel Margin="0,5,0,4" Orientation="Horizontal">
                            <TextBlock
                                Width="auto"
                                Padding="3,10,0,0"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Stop listening after" />
                            <TextBox
                                x:Name="SilenceAutoTurnOffDurationINT"
                                Width="auto"
                                Margin="4,3,3,0"
                                Padding="3,0,3,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Modules.Whisper.Settings.SilenceAutoTurnOffDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Width="auto"
                                Padding="0,10,0,0"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="milliseconds of quiet" />


                        </StackPanel>

                        <CheckBox
                            x:Name="SendAftersilence"
                            Margin="4,10,4,4"
                            IsChecked="{Binding Modules.Whisper.Settings.SendAftersilence, Mode=TwoWay}">
                            Send it as soon as I stop talking
                        </CheckBox>

                        <TextBlock
                            Width="auto"
                            Margin="0"
                            Padding="4,16,0,5"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="How loud you have to be before it starts listening" />

                        <StackPanel Margin="4,0,0,7" Orientation="Horizontal">
                            <Slider
                                x:Name="NoiseGateThreshold"
                                Width="134.5"
                                Height="12"
                                Margin="2.2,0,4.5,0"
                                IsSnapToTickEnabled="True"
                                Maximum="1.0"
                                Minimum="0.0"
                                SmallChange="0.01"
                                Style="{StaticResource CustomSlider}"
                                TickFrequency="0.01"
                                Value="{Binding Modules.Whisper.Settings.NoiseGateThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Width="auto"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeBody}"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="{Binding Modules.Whisper.Settings.NoiseGateThreshold, UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>


                    </StackPanel>
                </Border>
                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock
                            Padding="2,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionSubsectionHeaderStyle}"
                            Text="Which model does what" />

                        <TextBlock
                            Width="auto"
                            Padding="2,3,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Every helper can use a different model. Smaller ones answer faster and cost less; larger ones write better." />


                        <TextBlock
                            Width="auto"
                            Padding="2,7,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Suggest something to say" />
                        <ComboBox
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Modules.IntelliChat.AvailableChatModels}"
                            SelectedValue="{Binding Modules.IntelliChat.Settings.GenerateConversationStarterModel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock
                            Width="auto"
                            Padding="2,7,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Make it fit the chatbox" />
                        <ComboBox
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Modules.IntelliChat.AvailableChatModels}"
                            SelectedValue="{Binding Modules.IntelliChat.Settings.PerformShortenTextModel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock
                            Width="auto"
                            Padding="2,7,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Fix spelling and grammar" />
                        <ComboBox
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Modules.IntelliChat.AvailableChatModels}"
                            SelectedValue="{Binding Modules.IntelliChat.Settings.PerformSpellingCheckModel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock
                            Width="auto"
                            Padding="2,7,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Finish my sentence" />
                        <ComboBox
                            Width="200"
                            Margin="2,4"
                            HorizontalAlignment="Left"
                            ItemsSource="{Binding Modules.IntelliChat.AvailableChatModels}"
                            SelectedValue="{Binding Modules.IntelliChat.Settings.PerformTextCompletionModel, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>



                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <CheckBox
                            x:Name="HideOpenAITools"
                            IsChecked="{Binding ChatSettings.HideOpenAITools, Mode=TwoWay}">
                            Hide the AI buttons above the chat box
                        </CheckBox>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

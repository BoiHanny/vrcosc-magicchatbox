<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.DiscordSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:DiscordSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_Discord, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Discord voice options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>

        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_Discord, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>

                <Border
                    Margin="0,0,0,6"
                    Padding="10,8"
                    BorderThickness="0"
                    CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                            <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                            <GradientStop Offset="1" Color="{StaticResource GradientDeepPurpleColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSecondary}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentLightPurpleBrush}"
                            Text="What each feature does" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Padding="8"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="5">
                                <StackPanel>
                                    <TextBlock
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{StaticResource AccentDiscordBrush}"
                                        Text="🎮  Rich Presence" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeMicro}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Puts what you are doing in VRChat under your name in Discord, for your friends to see. The RICH toggle on the integrations page turns it on."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeMicro}"
                                        Foreground="{StaticResource StatusSuccessBrush}"
                                        Text="✔  No setup required" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                Padding="8"
                                Background="{StaticResource SurfaceCardBrush}"
                                CornerRadius="5">
                                <StackPanel>
                                    <TextBlock
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Foreground="{StaticResource AccentTealBrush}"
                                        Text="🎙  Who is talking" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeMicro}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Puts the names of whoever is speaking in your Discord call into your VRChat chatbox. The DESKTOP and VR toggles turn it on."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeMicro}"
                                        Foreground="{StaticResource StatusWarningBrush}"
                                        Text="⚠  Needs Discord's permission, and Discord does not always grant it"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button
                                Width="auto"
                                Height="30"
                                Padding="5"
                                Command="{Binding ConnectDiscordCommand}"
                                IsEnabled="{Binding IsConnecting, Converter={StaticResource InvertBooleanConverter}}"
                                Style="{StaticResource Status_Button_style}"
                                Visibility="{Binding HasSavedToken, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                Width="21"
                                                Height="18"
                                                Margin="0,0,3,0"
                                                Source="/Img/Icons/Discord.png" />
                                            <TextBlock
                                                Margin="0,-2,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeCompact}"
                                                Text="Connect with Discord" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button
                                Width="auto"
                                Height="30"
                                Padding="5"
                                Command="{Binding ConnectDiscordCommand}"
                                Style="{StaticResource Status_Button_style}"
                                Visibility="{Binding HasSavedToken, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                Width="15"
                                                Height="15"
                                                Margin="2,0,5,0"
                                                VerticalAlignment="Center"
                                                Source="/Img/Icons/yes.png" />
                                            <TextBlock
                                                Margin="0,-2,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="{StaticResource FontSizeCompact}"
                                                Text="Connected with Discord" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button
                                Width="20"
                                Height="30"
                                Margin="-5,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{StaticResource StatusErrorDarkerBrush}"
                                BorderThickness="0"
                                Command="{Binding DisconnectDiscordCommand}"
                                Cursor="Hand"
                                Style="{DynamicResource DisconnectPulsoid}"
                                Visibility="{Binding HasSavedToken, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <Grid>
                                    <Image
                                        Width="15"
                                        Height="15"
                                        RenderOptions.BitmapScalingMode="Linear"
                                        Source="/Img/Icons/Cross_v1_ico.png" />
                                </Grid>
                            </Button>
                        </StackPanel>

                    </Grid>
                </Border>

                <TextBlock
                    Width="auto"
                    Margin="2,0,0,4"
                    Style="{StaticResource OptionHelpTextStyle}"
                    Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged}" />

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="🎙  Setting up who-is-talking (you only do this once)" />
                        <TextBlock
                            Margin="0,2,0,8"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Discord guards the list of who is talking and does not hand it to every app. MagicChatbox asks for it first; if Discord says no, it connects the ordinary way instead, so your Discord profile still works but the speaker names do not appear."
                            TextWrapping="Wrap" />

                        <Border
                            Margin="0,0,0,6"
                            Padding="10,8"
                            BorderThickness="0"
                            CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                                    <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                                    <GradientStop Offset="1" Color="{StaticResource GradientDeepPurpleColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentLightPurpleBrush}"
                                    Text="Step 1 — Choose a Discord Application ID" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="Click" />
                                    <Run FontWeight="SemiBold" Text="Open Developer Portal" />
                                    <Run Text="→ log in → click" />
                                    <Run FontWeight="SemiBold" Text="New Application" />
                                    <Run Text="→ give it any name (e.g. MagicChatbox) → click" />
                                    <Run FontWeight="SemiBold" Text="Create" />
                                    <Run Text="." />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="You can use the bundled ID or copy the" />
                                    <Run FontWeight="SemiBold" Text="Application ID" />
                                    <Run Text="from the General Information page and paste it in the field below. A custom app does not guarantee Discord will grant private voice/RPC scope." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,0,0,6"
                            Padding="10,8"
                            BorderThickness="0"
                            CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                                    <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                                    <GradientStop Offset="1" Color="{StaticResource GradientDeepPurpleColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentLightPurpleBrush}"
                                    Text="Step 2 — Add the Redirect URI" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="In your Developer Portal app, go to" />
                                    <Run FontWeight="SemiBold" Text="OAuth2" />
                                    <Run Text="→ scroll to" />
                                    <Run FontWeight="SemiBold" Text="Redirects" />
                                    <Run Text="→ click" />
                                    <Run FontWeight="SemiBold" Text="Add Redirect" />
                                    <Run Text="→ paste the Redirect URI shown below → click" />
                                    <Run FontWeight="SemiBold" Text="Save Changes" />
                                    <Run Text="." />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Foreground="{StaticResource StatusWarningBrush}"
                                    Text="⚠  The URI must match exactly — copy it using the button below."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,0,0,6"
                            Padding="10,8"
                            BorderThickness="0"
                            CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                                    <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                                    <GradientStop Offset="1" Color="{StaticResource GradientDeepPurpleColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <TextBlock
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentLightPurpleBrush}"
                                    Text="Step 3 — Connect" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="Click" />
                                    <Run FontWeight="SemiBold" Text="Connect with Discord" />
                                    <Run Text="at the top. Your browser will open Discord authorization — approve it. If Discord rejects the voice/RPC scope, MagicChatbox automatically retries with basic authorization." />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="Note: Discord opens a local page in your browser. If fallback happens, a second Discord tab may open and voice detection can remain unavailable."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock
                                Width="105"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Application ID" />
                            <Grid
                                Width="260"
                                Height="28"
                                Margin="8,0,8,0"
                                ToolTip="Stored encrypted on this Windows account. Click Edit to reveal/change it.">
                                <TextBox
                                    Padding="5,0,0,0"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeSecondary}"
                                    IsReadOnly="True"
                                    Text="{Binding Modules.Discord.Settings.VoiceClientId, Mode=OneWay, Converter={StaticResource MaskedWeatherCityConverter}}"
                                    Visibility="{Binding Modules.Discord.Settings.VoiceClientIdEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBox
                                    Padding="5,0,0,0"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeSecondary}"
                                    Text="{Binding Modules.Discord.Settings.VoiceClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding Modules.Discord.Settings.VoiceClientIdEditing, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <ToggleButton
                                Width="54"
                                Height="28"
                                Margin="0,0,6,0"
                                Content="Edit"
                                IsChecked="{Binding Modules.Discord.Settings.VoiceClientIdEditing, Mode=TwoWay}"
                                Style="{StaticResource Status_Toggle_style}" />
                            <Button
                                Width="150"
                                Height="28"
                                Command="{Binding OpenDiscordDeveloperPortalCommand}"
                                Content="Open Developer Portal"
                                Style="{StaticResource Status_Button_style}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                            <TextBlock
                                Width="105"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Redirect URI" />
                            <TextBox
                                Width="260"
                                Margin="8,0,8,0"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeSecondary}"
                                IsReadOnly="True"
                                Text="{Binding RedirectUri, Mode=OneWay}" />
                            <Button
                                Width="80"
                                Height="28"
                                Margin="0,0,6,0"
                                Command="{Binding CopyRedirectUriCommand}"
                                Content="Copy"
                                Style="{StaticResource Status_Button_style}" />
                            <Button
                                Width="80"
                                Height="28"
                                Command="{Binding CheckRedirectPortCommand}"
                                Content="Check port"
                                Style="{StaticResource Status_Button_style}" />
                        </StackPanel>

                        <TextBlock
                            Margin="113,0,0,4"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeMicro}"
                            Foreground="{StaticResource TextLabelBrush}"
                            Text="{Binding RedirectPortStatus}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <CheckBox Margin="0,4,0,0" IsChecked="{Binding Modules.Discord.Settings.AutoConnectOnStartup, Mode=TwoWay}">
                            Connect to Discord as soon as MagicChatbox starts
                        </CheckBox>
                        <TextBlock
                            Margin="20,0,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Only works once you have connected once by hand, above." />
                    </StackPanel>
                </Border>

                <Border Margin="0,8,0,0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="🌐 What your Discord profile says you are doing" />
                        <TextBlock
                            Margin="0,2,0,6"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="The two lines under your name in Discord, where friends see what you are up to. This is separate from your VRChat chatbox and can carry the same live numbers — the world you are in, your heart rate, what is playing, and more."
                            TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding Modules.Discord.Settings.EnableRichPresence, Mode=TwoWay}">Show this on my Discord profile</CheckBox>

                        <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Discord.Settings.EnableRichPresence, Converter={StaticResource InverseBoolToHiddenConverter}}">

                            <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Start from a ready-made one" />
                            <ComboBox
                                MinWidth="200"
                                MaxWidth="300"
                                HorizontalAlignment="Left"
                                FontSize="{StaticResource FontSizeCaption}"
                                ItemsSource="{Binding RpPresetNames}"
                                SelectedItem="{Binding SelectedRpPresetName, Mode=TwoWay}"
                                ToolTip="Fills both lines in for you. Change them afterwards however you like." />

                            <TextBlock
                                Margin="0,10,0,3"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="First line" />
                            <TextBox
                                MinWidth="250"
                                Padding="4,2"
                                FontSize="{StaticResource FontSizeCaption}"
                                Text="{Binding Modules.Discord.Settings.RichPresenceDetails, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Margin="0,6,0,3"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Second line" />
                            <TextBox
                                MinWidth="250"
                                Padding="4,2"
                                FontSize="{StaticResource FontSizeCaption}"
                                Text="{Binding Modules.Discord.Settings.RichPresenceState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Margin="0,6,0,4"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="Type these where you want that piece to appear — {world} the world you are in · {count} people there · {type} whether it is public or private · {region} the server region · {status} your status message · {mode} desktop or VR · {time} the clock · {media} what is playing · {unique} people you have met · {peak} the busiest it got · {worlds} worlds visited · {heart_rate} your heart rate · {cpu} your PC load · {window} the app you are using · {weather} the weather · {network} your connection · {viewers} your Twitch viewers · {vr_battery} your headset battery. Anything with nothing behind it is quietly removed, and each line holds 128 characters."
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,2,0,0"
                                IsChecked="{Binding Modules.Discord.Settings.RichPresenceShowElapsed, Mode=TwoWay}">
                                Show how long I have been in this world
                            </CheckBox>
                            <CheckBox
                                Margin="0,2,0,0"
                                IsChecked="{Binding Modules.Discord.Settings.RichPresenceShowJoinButton, Mode=TwoWay}">
                                Give friends a Join button when the world is open to everyone
                            </CheckBox>
                            <TextBlock
                                Margin="20,1,0,4"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="A join link is only ever made for public worlds. Private, Friends+ and Invite+ worlds are never shared." />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="{StaticResource FontSizeFine}"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="💡 This stops on its own whenever the master switch is off."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What goes in your VRChat chatbox" />
                        <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                            <TextBox
                                Width="340"
                                Padding="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Modules.Discord.Settings.Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Width="130"
                                Margin="8,0,0,0"
                                FontSize="{StaticResource FontSizeCaption}"
                                ItemsSource="{Binding PresetNames}"
                                SelectedItem="{Binding SelectedPresetName, Mode=TwoWay}"
                                ToolTip="Pick a ready-made layout to start from" />
                        </StackPanel>
                        <TextBlock
                            Width="auto"
                            Margin="2,4,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Type these where you want that piece to appear — {channel} the call you are in · {count} how many people are in it · {speaking} who is talking · {speaking_count} how many are talking · {mute_emoji} your mute or deafen icon · {mute_state} the words muted or unmuted · {voice_state} the words speaking or quiet · \n starts a new line"
                            TextWrapping="Wrap" />

                        <!--
                            Stand-in names until Discord hands over real ones, so the template is
                            never edited against a blank line.
                        -->
                        <controls:SegmentPreview Caption="While you are in a call" Line="{Binding OutputPreview}" />
                        <controls:SegmentPreview Caption="When you are not in a call — empty means Discord shows nothing" Line="{Binding NotInVcPreview}" />

                        <StackPanel Style="{StaticResource OptionActionRowStyle}">
                            <Button
                                Width="105"
                                Height="25"
                                HorizontalAlignment="Left"
                                Command="{Binding CopyTemplateTokensCommand}"
                                Content="Copy the list"
                                Style="{StaticResource Status_Button_style}" />
                            <Button
                                Width="110"
                                Height="25"
                                Margin="8,0,0,0"
                                Command="{Binding CopyOutputPreviewCommand}"
                                Content="Copy the preview"
                                Style="{StaticResource Status_Button_style}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="How many names to list at once" />
                        <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                            <Slider
                                Width="134.5"
                                Height="12"
                                Margin="2.2,0,4.5,0"
                                IsSnapToTickEnabled="True"
                                Maximum="10"
                                Minimum="1"
                                Style="{StaticResource CustomSlider}"
                                TickFrequency="1"
                                Value="{Binding Modules.Discord.Settings.MaxSpeakingUsersToShow, Mode=TwoWay}" />
                            <TextBlock
                                Width="auto"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="{Binding Modules.Discord.Settings.MaxSpeakingUsersToShow}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Wait this long before dropping a name" />
                        <TextBlock
                            Width="auto"
                            Margin="2,0,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="People pause between words. Waiting a moment stops names blinking in and out every time somebody takes a breath." />
                        <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                            <Slider
                                Width="134.5"
                                Height="12"
                                Margin="2.2,0,4.5,0"
                                IsSnapToTickEnabled="True"
                                Maximum="2000"
                                Minimum="200"
                                Style="{StaticResource CustomSlider}"
                                TickFrequency="100"
                                Value="{Binding Modules.Discord.Settings.SpeakerDebounceMs, Mode=TwoWay}" />
                            <TextBlock
                                Width="auto"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="{Binding Modules.Discord.Settings.SpeakerDebounceMs}" />
                            <TextBlock
                                Width="auto"
                                Margin="-2,5"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="ms" />
                        </StackPanel>

                        <CheckBox IsChecked="{Binding Modules.Discord.Settings.HideSelfFromSpeakers, Mode=TwoWay}">
                            Leave my own name out of the list
                        </CheckBox>

                        <CheckBox IsChecked="{Binding Modules.Discord.Settings.ShowUserCountOnly, Mode=TwoWay}">
                            Show only how many are talking, never their names
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Say this when the call is quiet" />
                        <TextBox
                            Width="200"
                            Margin="0,3,0,5"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding Modules.Discord.Settings.EmptySpeakingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Say this when you are not in a call" />
                        <TextBlock
                            Width="auto"
                            Margin="2,0,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Leave it empty to drop Discord out of the chatbox entirely whenever you are not in a call." />
                        <TextBox
                            Width="200"
                            Margin="0,3,0,0"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding Modules.Discord.Settings.NotInVcText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Modules.Discord.Settings.ShowMuteDeafenEmoji, Mode=TwoWay}">
                            Show a small icon when my mic or sound is off
                        </CheckBox>
                        <TextBlock
                            Width="auto"
                            Margin="20,0,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Only appears where your layout has {mute_emoji} in it." />

                        <StackPanel
                            Margin="2,4,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding Modules.Discord.Settings.ShowMuteDeafenEmoji, Converter={StaticResource InverseBoolToHiddenConverter}}">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Mic off:" />
                            <TextBox
                                Width="45"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Modules.Discord.Settings.MuteEmoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="10,0,5,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Sound off:" />
                            <TextBox
                                Width="45"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Modules.Discord.Settings.DeafenEmoji, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Let your avatar react" />
                        <TextBlock
                            Width="auto"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="For avatars built to respond to this. Nothing shows in the chatbox — the avatar has to be made to listen for the names below, and nothing happens if it was not."
                            TextWrapping="Wrap" />
                        <CheckBox IsChecked="{Binding Modules.Discord.Settings.SendMuteDeafenOsc, Mode=TwoWay}">
                            Tell my avatar when my mic or sound is off
                        </CheckBox>
                        <TextBlock
                            Width="auto"
                            Margin="20,0,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="/avatar/parameters/DiscordMuted (true or false)&#x0a;/avatar/parameters/DiscordDeafened (true or false)" />

                        <CheckBox
                            Margin="0,6,0,0"
                            IsChecked="{Binding Modules.Discord.Settings.SendVoiceStateOsc, Mode=TwoWay}">
                            Tell my avatar about the call I am in
                        </CheckBox>
                        <TextBlock
                            Width="auto"
                            Margin="20,0,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="/avatar/parameters/DiscordInVC (true or false)&#x0a;/avatar/parameters/DiscordVCCount (a number)&#x0a;/avatar/parameters/DiscordSpeaking (true or false)" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

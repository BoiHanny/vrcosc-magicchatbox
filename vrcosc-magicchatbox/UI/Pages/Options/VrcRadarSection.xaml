<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.VrcRadarSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modules="clr-namespace:vrcosc_magicchatbox.Classes.Modules"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:VrcRadarSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_VrcRadar, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="VRChat radar options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>

        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_VrcRadar, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>

                <Border
                    Margin="0,0,0,8"
                    Padding="8,5"
                    Style="{StaticResource OptionCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextBodyBrush}"
                                Text="🌎 " />
                            <TextBlock
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextBodyBrush}"
                                Text="{Binding Modules.VrcRadar.CurrentWorldName, FallbackValue='Not in a world'}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="👥 " />
                            <TextBlock
                                FontSize="{StaticResource FontSizeSecondary}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="{Binding Modules.VrcRadar.PlayerCount, FallbackValue='0'}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="{Binding Modules.VrcRadar.InstanceType, FallbackValue=''}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="{Binding Modules.VrcRadar.Region, FallbackValue=''}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Width="auto"
                                Height="26"
                                Padding="8,3"
                                Command="{Binding StartRadarCommand}"
                                Content="▶ Start"
                                FontSize="{StaticResource FontSizeCaption}"
                                Style="{StaticResource Status_Button_style}"
                                Visibility="{Binding Modules.VrcRadar.IsRadarRunning, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}" />
                            <Button
                                Width="auto"
                                Height="26"
                                Padding="8,3"
                                Command="{Binding StopRadarCommand}"
                                Content="⏹ Stop"
                                FontSize="{StaticResource FontSizeCaption}"
                                Style="{StaticResource Status_Button_style}"
                                Visibility="{Binding Modules.VrcRadar.IsRadarRunning, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What the radar puts in the chatbox" />
                <ComboBox
                    Width="280"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left"
                    FontSize="{StaticResource FontSizeCaption}"
                    ItemsSource="{Binding DisplayModes}"
                    SelectedItem="{Binding RadarSettings.DisplayMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock
                    Style="{StaticResource OptionHelpTextStyle}"
                    Text="The first three all show where you are and briefly hand the line over whenever something happens. The fourth shows nothing until something happens. The last one ignores the layout you write further down and shows a short fixed line instead."
                    TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What to say about the room" />
                <CheckBox IsChecked="{Binding RadarSettings.ShowInstanceType, Mode=TwoWay}">Say whether the room is public, private or a group</CheckBox>
                <CheckBox IsChecked="{Binding RadarSettings.ShowRegion, Mode=TwoWay}">Say which part of the world the room is hosted in</CheckBox>

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What to say when something happens" />
                <CheckBox IsChecked="{Binding RadarSettings.AnnounceJoins, Mode=TwoWay}">Say when someone walks in</CheckBox>
                <CheckBox IsChecked="{Binding RadarSettings.AnnounceLeaves, Mode=TwoWay}">Say when someone leaves</CheckBox>
                <CheckBox IsChecked="{Binding RadarSettings.AnnounceScreenshots, Mode=TwoWay}">Say when I take a photo</CheckBox>
                <CheckBox IsChecked="{Binding RadarSettings.ShowWorldDownload, Mode=TwoWay}">Show how far a world has loaded</CheckBox>

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Knowing when you have stopped playing" />
                <CheckBox IsChecked="{Binding RadarSettings.UseWindowDetection, Mode=TwoWay}">Also check whether VRChat is still open</CheckBox>
                <TextBlock
                    Margin="20,1,0,3"
                    Style="{StaticResource OptionHelpTextStyle}"
                    Text="Watching for the VRChat program itself, on top of watching its log, makes MagicChatbox better at noticing you have finished for the night. It needs the Window activity permission."
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding RadarSettings.UseWindowDetection, Converter={StaticResource InverseBoolToHiddenConverter}}">
                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextLabelBrush}"
                        Text="VRChat is: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="#FF66BB6A"
                        Text="open"
                        Visibility="{Binding Modules.VrcRadar.IsVrchatProcessRunning, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextLabelBrush}"
                        Opacity="0.6"
                        Text="not open"
                        Visibility="{Binding Modules.VrcRadar.IsVrchatProcessRunning, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}" />
                </StackPanel>
                <StackPanel Margin="0,6,0,3" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Call it a night after nothing happens for: " />
                    <Slider
                        Width="180"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="90"
                        Minimum="5"
                        TickFrequency="5"
                        Value="{Binding RadarSettings.SessionTimeoutMinutes, Mode=TwoWay}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="{Binding RadarSettings.SessionTimeoutMinutes, StringFormat='{}{0} min'}" />
                </StackPanel>
                <TextBlock
                    Margin="20,0,0,6"
                    Style="{StaticResource OptionHelpTextStyle}"
                    Text="Once nothing at all has happened for this long, MagicChatbox decides your session is over and starts the counters again next time."
                    TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Running into the same people again" />
                <CheckBox IsChecked="{Binding RadarSettings.DetectSeenAgain, Mode=TwoWay}">Notice people who turn up in more than one room with me</CheckBox>
                <CheckBox Margin="20,2,0,0" IsChecked="{Binding RadarSettings.ShowEncounterTable, Mode=TwoWay}">
                    Keep a list of them here while I play
                </CheckBox>
                <TextBlock
                    Margin="20,2,0,3"
                    Style="{StaticResource OptionHelpTextStyle}"
                    Text="Nothing is sent anywhere — the list is only in this window and it is thrown away when you close MagicChatbox. It is off unless you turn it on."
                    TextWrapping="Wrap" />
                <StackPanel
                    Margin="20,3,0,5"
                    Orientation="Horizontal"
                    Visibility="{Binding RadarSettings.DetectSeenAgain, Converter={StaticResource InverseBoolToHiddenConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Only count it if it happens within (minutes): " />
                    <TextBox
                        Width="50"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.SeenAgainWindowMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel
                    Margin="0,6,0,2"
                    Orientation="Horizontal"
                    Visibility="{Binding RadarSettings.ShowEncounterTable, Converter={StaticResource InverseBoolToHiddenConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Only list people I have met at least: " />
                    <Slider
                        Width="120"
                        Margin="4,0,4,0"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="10"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{Binding RadarSettings.MinEncounterCount, Mode=TwoWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextLabelBrush}"
                        Text="{Binding RadarSettings.MinEncounterCount, StringFormat='{}{0}×'}" />
                </StackPanel>
                <Border
                    MaxHeight="220"
                    Margin="0,6,0,0"
                    Padding="0"
                    Background="{StaticResource SurfaceCardBrush}"
                    CornerRadius="4"
                    Visibility="{Binding RadarSettings.ShowEncounterTable, Converter={StaticResource InverseBoolToHiddenConverter}}">
                    <DataGrid
                        AutoGenerateColumns="False"
                        Background="Transparent"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        FontSize="{StaticResource FontSizeMicro}"
                        Foreground="{StaticResource TextBodyBrush}"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Modules.VrcRadar.FilteredEncountersView}"
                        RowBackground="Transparent"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextLabelBrush}" />
                                <Setter Property="FontSize" Value="{StaticResource FontSizeFine}" />
                                <Setter Property="Padding" Value="6,3" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{StaticResource SurfaceVariantBrush}" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding PlayerName}"
                                Header="Who" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding LastWorldName}"
                                Header="Last seen in" />
                            <DataGridTextColumn
                                Width="50"
                                Binding="{Binding TimesSeenThisSession}"
                                Header="Times met" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding TimeTogetherFormatted}"
                                Header="Time together" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="How your session is going" />
                <Border
                    Margin="0,0,0,4"
                    Padding="8,6"
                    Background="{StaticResource SurfaceDarkBrush}"
                    BorderBrush="{StaticResource SurfaceVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,16,0">
                            <TextBlock
                                FontSize="{StaticResource FontSizeHeading}"
                                Foreground="{StaticResource TextBodyBrush}"
                                Style="{StaticResource NumericReadoutStyle}"
                                Text="{Binding Modules.VrcRadar.WorldsVisited, FallbackValue='0'}" />
                            <TextBlock
                                FontSize="{StaticResource FontSizeFine}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Worlds" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,16,0">
                            <TextBlock
                                FontSize="{StaticResource FontSizeHeading}"
                                Foreground="{StaticResource TextBodyBrush}"
                                Style="{StaticResource NumericReadoutStyle}"
                                Text="{Binding Modules.VrcRadar.UniquePlayersCount, FallbackValue='0'}" />
                            <TextBlock
                                FontSize="{StaticResource FontSizeFine}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="People met" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,0,16,0">
                            <TextBlock
                                FontSize="{StaticResource FontSizeHeading}"
                                Foreground="{StaticResource TextBodyBrush}"
                                Style="{StaticResource NumericReadoutStyle}"
                                Text="{Binding Modules.VrcRadar.PeakPlayerCountThisSession, FallbackValue='0'}" />
                            <TextBlock
                                FontSize="{StaticResource FontSizeFine}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Busiest room" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="3"
                            Margin="0,0,16,0">
                            <TextBlock
                                FontSize="{StaticResource FontSizeHeading}"
                                Foreground="{StaticResource TextBodyBrush}"
                                Style="{StaticResource NumericReadoutStyle}"
                                Text="{Binding Modules.VrcRadar.TotalJoinEvents, FallbackValue='0'}" />
                            <TextBlock
                                FontSize="{StaticResource FontSizeFine}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Joins" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock
                                FontSize="{StaticResource FontSizeHeading}"
                                Foreground="{StaticResource TextBodyBrush}"
                                Style="{StaticResource NumericReadoutStyle}"
                                Text="{Binding Modules.VrcRadar.TotalLeaveEvents, FallbackValue='0'}" />
                            <TextBlock
                                FontSize="{StaticResource FontSizeFine}"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Leaves" />
                        </StackPanel>
                    </Grid>
                </Border>

                <CheckBox IsChecked="{Binding RadarSettings.ShowSessionStatsInChatbox, Mode=TwoWay}">Put these numbers in the chatbox each time I change world</CheckBox>

                <StackPanel
                    Margin="20,4,0,0"
                    Orientation="Horizontal"
                    Visibility="{Binding RadarSettings.ShowSessionStatsInChatbox, Converter={StaticResource InverseBoolToHiddenConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Keep it on screen for: " />
                    <Slider
                        Width="120"
                        IsSnapToTickEnabled="True"
                        Maximum="120"
                        Minimum="5"
                        TickFrequency="5"
                        Value="{Binding RadarSettings.SessionStatsDuration, Mode=TwoWay}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextLabelBrush}">
                        <Run Text="{Binding RadarSettings.SessionStatsDuration, FallbackValue='15'}" />
                        <Run Text="s" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Pop-ups on your desktop" />

                <CheckBox IsChecked="{Binding RadarSettings.ShowSeenAgainNotification, Mode=TwoWay}">Tell me when someone turns up in my next world too</CheckBox>
                <CheckBox Margin="0,2,0,0" IsChecked="{Binding RadarSettings.WarnOnAvatarBlocked, Mode=TwoWay}">
                    Tell me when VRChat hides an avatar for being too heavy
                </CheckBox>

                <StackPanel
                    Margin="20,4,0,4"
                    Orientation="Horizontal"
                    Visibility="{Binding RadarSettings.WarnOnAvatarBlocked, Converter={StaticResource InverseBoolToHiddenConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Keep it on screen for: " />
                    <Slider
                        Width="80"
                        IsSnapToTickEnabled="True"
                        Maximum="20"
                        Minimum="3"
                        TickFrequency="1"
                        Value="{Binding RadarSettings.AvatarBlockedDuration, Mode=TwoWay}" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextLabelBrush}">
                        <Run Text="{Binding RadarSettings.AvatarBlockedDuration, FallbackValue='6'}" />
                        <Run Text="s" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="How each line reads" />
                <TextBlock
                    Style="{StaticResource OptionHelpTextStyle}"
                    Text="Type these where you want that piece to appear — {world} the world name · {count} people in it · {peak} the most it has held · {peak_session} the most you have seen tonight · {type} public or private · {region} where it is hosted · {owner} who made the room · {master} your owner icon · {session_time} how long you have been in this world · {app_session} how long MagicChatbox has been running · {offline} time spent away · {worlds} worlds visited tonight · {players} people met tonight · {user} the person the line is about · {size} and {speed} how big a world is and how fast it is loading · \n starts a new line"
                    TextWrapping="Wrap" />
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,2"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Where I am:" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,2"
                        Orientation="Horizontal">
                        <TextBox
                            MinWidth="200"
                            Padding="3,0"
                            FontSize="{StaticResource FontSizeCaption}"
                            Text="{Binding RadarSettings.TemplateWorld, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Width="100"
                            Margin="6,0,0,0"
                            FontSize="{StaticResource FontSizeMicro}"
                            ItemsSource="{Binding WorldPresetNames}"
                            SelectedItem="{Binding SelectedWorldPresetName, Mode=TwoWay}"
                            ToolTip="Pick a ready-made layout to start from" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,2"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Someone walks in:" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,2"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.TemplateJoin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,2"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Someone leaves:" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,2"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.TemplateLeave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,2"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="I take a photo:" />
                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,2"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.TemplateScreenshot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,2"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="A world is loading:" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,2"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.TemplateDownload, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="0,2"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="I run into someone again:" />
                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="0,2"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.TemplateSeenAgain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="0,2"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="How my session went:" />
                    <TextBox
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="0,2"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.TemplateSessionStats, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Margin="0,2"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="An avatar was hidden:" />
                    <TextBox
                        Grid.Row="7"
                        Grid.Column="1"
                        Margin="0,2"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.TemplateAvatarBlocked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--
                    Three of the lines above previewed against a stand-in room, because the radar
                    only has real data once you are in VRChat - and that is the last moment anyone
                    wants to be editing these boxes.
                -->
                <controls:SegmentPreview Caption="Where I am — as it would look in a room of 14" Line="{Binding WorldSamplePreview}" />
                <controls:SegmentPreview Caption="Someone walking in" Line="{Binding JoinSamplePreview}" />
                <controls:SegmentPreview Caption="How my session went" Line="{Binding SessionStatsSamplePreview}" />
                <controls:SegmentPreview Caption="In your chatbox right now" Line="{Binding Modules.VrcRadar.CurrentOutputPreview, FallbackValue=''}" />

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Icon shown when I own the room: " />
                    <TextBox
                        Width="60"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.MasterIcon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Let your avatar react" />
                <TextBlock
                    Style="{StaticResource OptionHelpTextStyle}"
                    Text="For avatars built to respond to this. Nothing shows in the chatbox — the avatar has to be made to listen for the name below, and nothing happens if it was not."
                    TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding RadarSettings.SendCameraFlashOsc, Mode=TwoWay}">Set off a camera flash when I take a photo</CheckBox>
                <StackPanel
                    Margin="20,2,0,5"
                    Orientation="Horizontal"
                    Visibility="{Binding RadarSettings.SendCameraFlashOsc, Converter={StaticResource InverseBoolToHiddenConverter}}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="Name the avatar listens for: " />
                    <TextBox
                        Width="250"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.OscCameraFlashParam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Border Height="10" />

                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Going easy on your PC" />
                <StackPanel Margin="0,4,0,4" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextBodyBrush}"
                        Text="How much of the old log to read at startup (MB): " />
                    <TextBox
                        Width="60"
                        Padding="3,0"
                        FontSize="{StaticResource FontSizeCaption}"
                        Text="{Binding RadarSettings.MaxBackfillSizeMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeMicro}"
                        Foreground="{StaticResource TextSubtleBrush}"
                        Text="(1–200)" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.WindowActivitySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modules="clr-namespace:vrcosc_magicchatbox.Classes.Modules"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=sections:WindowActivitySectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,1">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_WindowActivity, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Window activity options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>


        <Grid
            Grid.Row="1"
            Width="auto"
            Margin="20,5,2,0"
            Visibility="{Binding AppSettings.Settings_WindowActivity, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock
                    Width="auto"
                    Padding="0,10,0,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeBody}"
                    Foreground="{StaticResource TextDangerRedBrush}"
                    Text="{Binding WindowActivity.ErrorInWindowActivityMsg, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    Visibility="{Binding WindowActivity.ErrorInWindowActivity, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    x:Name="enhancedapp_checkbox"
                    Margin="0,6,0,0"
                    IsChecked="{Binding WindowActivitySettings.ApplicationHookV2, Mode=TwoWay}">
                    Look up friendlier app names
                </CheckBox>
                <CheckBox
                    x:Name="WindowActivityTitleScan_checkbox"
                    Margin="0,6,0,0"
                    IsChecked="{Binding WindowActivitySettings.TitleScan, Mode=TwoWay}">
                    Show the window title as well as the app name
                </CheckBox>
                <StackPanel Visibility="{Binding WindowActivitySettings.TitleScan, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <CheckBox
                        x:Name="AutoShowTitleOnNewAppn_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding WindowActivitySettings.AutoShowTitleOnNewApp, Mode=TwoWay}">
                        Turn the title on by itself for apps you have not used before
                    </CheckBox>
                    <CheckBox
                        x:Name="TitleOnAppVR_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding WindowActivitySettings.TitleOnAppVR, Mode=TwoWay}">
                        Show titles while you are in VR too
                    </CheckBox>
                    <CheckBox
                        x:Name="LimitTitleOnApp_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding WindowActivitySettings.LimitTitleOnApp, Mode=TwoWay}">
                        Shorten long titles
                    </CheckBox>
                    <StackPanel Margin="0,10,0,-10" Visibility="{Binding WindowActivitySettings.LimitTitleOnApp, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock
                            Grid.Column="0"
                            Padding="0,0,0,0"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Cut titles after this many characters" />
                        <TextBox
                            x:Name="MaxShowTitleCount_INT"
                            Width="40"
                            Margin="0,3,0,10"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WindowActivitySettings.MaxShowTitleCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox
                        x:Name="LimitTitleOnsApp_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding WindowActivitySettings.ShowFocusedApp, Mode=TwoWay}">
                        Name the app, not just 'On desktop'
                    </CheckBox>
                    <CheckBox
                        Margin="0,6,0,0"
                        IsChecked="{Binding WindowActivitySettings.ShowRegexColumn, Mode=TwoWay}">
                        Show a per-app rewrite box in the list below
                    </CheckBox>
                    <CheckBox
                        Margin="0,6,0,0"
                        IsChecked="{Binding WindowActivitySettings.UseGlobalRegex, Mode=TwoWay}">
                        Rewrite every window title with one rule
                    </CheckBox>
                    <StackPanel
                        Margin="24,4,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding WindowActivitySettings.UseGlobalRegex, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Rewrite rule" />
                        <TextBox
                            Width="300"
                            Padding="5,2"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeSecondary}"
                            Text="{Binding WindowActivitySettings.GlobalRegex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Applied to every window title. Use either a capture regex or pattern =&gt; replacement. Example: ^(.+?)(?:\s*[-–—]\s*[^-–—]+\s*[-–—]\s*(.+)|\s*[-–—]\s*[^-–—]+)?$ =&gt; $1 $2" />
                    </StackPanel>

                    <CheckBox
                        Margin="0,10,0,0"
                        IsChecked="{Binding WindowActivitySettings.EnableTitleFilters, Mode=TwoWay}">
                        Hide or cut parts of window titles
                    </CheckBox>
                    <StackPanel Margin="24,4,0,0" Visibility="{Binding WindowActivitySettings.EnableTitleFilters, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Rules here apply to every app. To set one for a single app, use the 'What to hide' box in the list below." />
                        <TextBlock
                            Margin="0,0,0,6"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Type words or phrases separated by commas. Hide drops the whole title when it matches; Only show keeps it only when it matches; Cut out removes just the matching words and keeps the rest." />
                        <ItemsControl ItemsSource="{Binding WindowActivitySettings.TitleFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                            ToolTip="Turn this rule on or off" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Width="180"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding Source={x:Static modules:TitleFilterRule.FilterModes}}"
                                            SelectedItem="{Binding Mode, Mode=TwoWay}"
                                            Style="{StaticResource DarkComboBoxStyle}"
                                            ToolTip="Hide: drop the whole title when it matches.&#x0a;Only show: keep it only when it matches.&#x0a;Cut out: remove the matching words and keep the rest.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox
                                            Grid.Column="2"
                                            MinWidth="120"
                                            Margin="0,0,6,0"
                                            Padding="6,4"
                                            VerticalContentAlignment="Center"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Comma-separated words/phrases or regex:&lt;pattern&gt;. Example remove regex: regex:\s*[-–—]\s*dif\s*[-–—]\s*" />
                                        <Button
                                            Grid.Column="3"
                                            Width="24"
                                            Height="24"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Command="{Binding DataContext.RemoveTitleFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="✕"
                                            FontSize="{StaticResource FontSizeMicro}"
                                            Style="{StaticResource CircleButton}"
                                            ToolTip="Delete this rule" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!--
                            Status_Button_style_Small before this, which is not a size - it is the
                            style for a button sitting on a status item, hidden until its InAppAction
                            matches the list it is in. Neither of those exists here, so it defaulted
                            to collapsed and had to be forced visible, while its conditions went on
                            asking every status item question against a settings view model.
                        -->
                        <Button
                            Width="140"
                            Height="24"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding AddTitleFilterCommand}"
                            Content="＋ Add a rule"
                            FontSize="{StaticResource FontSizeSecondary}"
                            Style="{StaticResource Status_Button_style}"
                            ToolTip="Add a rule that applies to every app" />
                    </StackPanel>
                    <CheckBox
                        Margin="0,10,0,0"
                        IsChecked="{Binding WindowActivitySettings.HideOutputWhenPrivateApp, Mode=TwoWay}"
                        ToolTip="Otherwise the app is replaced by the private label you set below, and the line still appears.">
                        Show nothing at all for apps marked private
                    </CheckBox>

                    <TextBlock
                        Width="auto"
                        Padding="0,10,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="What the line says on desktop" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            x:Name="WindowActivityDesktopTitle"
                            Width="auto"
                            Margin="0,3,0,0"
                            Padding="5,0,5,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WindowActivitySettings.DesktopTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="WindowActivityDesktopFocusTitle"
                            Width="auto"
                            Margin="5,3,0,0"
                            Padding="5,0,5,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WindowActivitySettings.DesktopFocusTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding WindowActivitySettings.ShowFocusedApp, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="PrivateAppCustom"
                            Width="auto"
                            Margin="4,3,0,0"
                            Padding="5,0,5,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WindowActivitySettings.PrivateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding WindowActivitySettings.ShowFocusedApp, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="The boxes above are, in order: the opening words, the word joining them to the app, and what to say instead of the app name when it is marked private." />
                    <!--  Three boxes with no labels and no example was the whole of this setting.  -->
                    <controls:SegmentPreview Caption="On desktop, with an app called Firefox:" Line="{Binding DesktopPreviewLine}" />

                    <CheckBox
                        x:Name="IntgrScanFsorc_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding IntegrationSettings.IntgrScanForce, Mode=TwoWay}">
                        Name the app while you are in VR
                    </CheckBox>
                    <TextBlock
                        Width="auto"
                        Padding="0,10,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="What the line says in VR" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox
                            x:Name="WindowActivityVRTitle"
                            Width="auto"
                            Margin="0,3,0,0"
                            Padding="5,0,5,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WindowActivitySettings.VrTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="WindowActivityVRFocusTitle"
                            Width="auto"
                            Margin="5,3,0,0"
                            Padding="5,0,5,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WindowActivitySettings.VrFocusTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IntegrationSettings.IntgrScanForce, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            x:Name="PrivateAppCustomVR"
                            Width="auto"
                            Margin="4,3,0,0"
                            Padding="5,0,5,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding WindowActivitySettings.PrivateNameVR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding IntegrationSettings.IntgrScanForce, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="Same three boxes, for when you are in VR. The window title only rides along here if 'Show titles while you are in VR too' is ticked above." />
                    <controls:SegmentPreview Caption="In VR, with an app called Firefox:" Line="{Binding VrPreviewLine}" />

                </StackPanel>

            </StackPanel>
            <TextBlock
                Grid.Row="1"
                Margin="0,15,0,5"
                Style="{StaticResource OptionFieldLabelStyle}"
                Text="Forget apps you have used" />
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button
                    x:Name="SmartClearnup"
                    Width="60"
                    Height="25"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Left"
                    Command="{Binding SmartCleanupCommand}"
                    Content="Smart"
                    Style="{DynamicResource Status_Button_style}" />
                <Button
                    x:Name="ClearnupKeepSettings"
                    Width="150"
                    Height="25"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Left"
                    Command="{Binding CleanupKeepSettingsCommand}"
                    Content="Keep only the ones I changed"
                    Style="{DynamicResource Status_Button_style}" />
                <Button
                    x:Name="ResetWindowActivity"
                    Width="50"
                    Height="25"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Left"
                    Command="{Binding ResetWindowActivityCommand}"
                    Content="Reset"
                    Style="{DynamicResource Status_Button_style}" />
                <TextBlock
                    Margin="0,3,0,0"
                    Style="{StaticResource OptionFieldLabelStyle}"
                    Text="{Binding WindowActivity.DeletedAppslabel, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel
                Grid.Row="3"
                Margin="0,15,0,0"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource OptionFieldLabelStyle}"
                    Text="Find an app" />
                <TextBox
                    Width="190"
                    Margin="0,0,8,0"
                    Padding="5,0"
                    VerticalContentAlignment="Center"
                    FontSize="{StaticResource FontSizeCompact}"
                    Text="{Binding WindowActivity.AppFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Type part of an app's name" />
                <CheckBox
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding WindowActivity.ShowImportantAppsOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Only apps you have changed something on, or used more than once.">
                    Important only
                </CheckBox>
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource OptionFieldLabelStyle}"
                    Text="Used at least" />
                <TextBox
                    Width="45"
                    Margin="0,0,8,0"
                    Padding="5,0"
                    VerticalContentAlignment="Center"
                    FontSize="{StaticResource FontSizeCompact}"
                    Text="{Binding WindowActivity.MinimumFocusCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Hide apps you have used fewer times than this" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeCompact}"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="{Binding WindowActivity.FilteredAppsSummary, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Border
                Grid.Row="4"
                Width="auto"
                MinWidth="745"
                Margin="0,15,1,0"
                HorizontalAlignment="Stretch"
                CornerRadius="5">
                <Border.Background>
                    <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                        <GradientStop Offset="1" Color="{StaticResource GradientDeepPurpleColor}" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="185" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Margin="3,0"
                        Command="{Binding WindowActivity.SortByProcessNameCommand}"
                        Style="{StaticResource Sort_Button_style}">
                        <TextBlock
                            Padding="5"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Text="App" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        Margin="3,0"
                        Command="{Binding WindowActivity.SortByFocusCountCommand}"
                        Style="{StaticResource Sort_Button_style}">
                        <TextBlock
                            Padding="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Text="Focused" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Margin="3,0"
                        Command="{Binding WindowActivity.SortByUsedNewMethodCommand}"
                        Style="{StaticResource Sort_Button_style}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Text="Friendly name" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Margin="3,0"
                        Command="{Binding WindowActivity.SortByIsShowInfoAppCommand}"
                        Style="{StaticResource Sort_Button_style}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Text="Show title" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        Margin="3,0"
                        Command="{Binding WindowActivity.SortByIsPrivateAppCommand}"
                        Style="{StaticResource Sort_Button_style}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Text="Private" />
                    </Button>
                    <Button
                        Grid.Column="5"
                        Margin="3,0"
                        Command="{Binding WindowActivity.SortByApplyCustomAppNameCommand}"
                        Style="{StaticResource Sort_Button_style}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Text="Call it instead" />
                    </Button>
                    <Button
                        Grid.Column="6"
                        MinWidth="200"
                        Margin="3,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource Sort_Button_style}"
                        ToolTip="Applies to this app only: hide the title when it matches, show it only when it matches, or cut the matching words out."
                        Visibility="{Binding WindowActivitySettings.EnableTitleFilters, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Text="What to hide" />
                    </Button>
                    <Button
                        Grid.Column="7"
                        Margin="3,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource Sort_Button_style}"
                        Visibility="{Binding WindowActivitySettings.ShowRegexColumn, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Text="Rewrite…"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="A rewrite rule for this app only" />
                    </Button>
                </Grid>
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Direction="0"
                        Opacity="0.5"
                        RenderingBias="Performance"
                        ShadowDepth="0"
                        Color="black" />
                </Border.Effect>
            </Border>
                <!--  The scroll viewer lives inside the template: an ItemsControl wrapped in an outer one
                      hands its panel an infinite height, so every row realizes and virtualization does nothing.  -->
                <ItemsControl
                    Grid.Row="5"
                    MaxHeight="600"
                    HorizontalAlignment="Stretch"
                    ScrollViewer.CanContentScroll="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ItemsSource="{Binding WindowActivity.ScannedAppsView, UpdateSourceTrigger=PropertyChanged, NotifyOnTargetUpdated=True}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProcessInfo}">
                        <Border
                            Margin="0,6,0,0"
                            CornerRadius="5"
                            RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Border.Background>
                                <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                                    <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                                    <GradientStop Offset="1" Color="{StaticResource GradientDeepPurpleColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="185" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSubheading}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding ProcessName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSubheading}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding FocusCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSubheading}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding UsedNewMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox
                                    x:Name="ShowTitle"
                                    Grid.Column="3"
                                    Width="23"
                                    HorizontalAlignment="Center"
                                    IsChecked="{Binding ShowTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox
                                    x:Name="IsPrivateApp"
                                    Grid.Column="4"
                                    Width="23"
                                    HorizontalAlignment="Center"
                                    IsChecked="{Binding IsPrivateApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal">
                                    <CheckBox
                                        x:Name="ApplyCustomAppName"
                                        Width="23"
                                        Margin="5,0,0,0"
                                        IsChecked="{Binding ApplyCustomAppName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        Width="173"
                                        Margin="5,0,0,0"
                                        Padding="5,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        FontSize="{StaticResource FontSizeBody}"
                                        GotKeyboardFocus="ScannedAppTextBox_GotKeyboardFocus"
                                        IsEnabled="{Binding ApplyCustomAppName}"
                                        LostKeyboardFocus="ScannedAppTextBox_LostKeyboardFocus"
                                        Text="{Binding CustomAppName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="6"
                                    MinWidth="200"
                                    Orientation="Horizontal"
                                    Visibility="{Binding DataContext.WindowActivitySettings.EnableTitleFilters, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <!--  Wide enough to read the choice; the room comes off the box beside it.  -->
                                    <ComboBox
                                        Width="110"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        SelectedIndex="{Binding ContentFilterMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DarkComboBoxStyle}"
                                        ToolTip="None: show the title as-is.&#x0a;Hide: drop it when it matches.&#x0a;Only show: keep it only when it matches.&#x0a;Cut out: remove the matching words and keep the rest.">
                                        <ComboBoxItem Content="Show as-is" />
                                        <ComboBoxItem Content="Hide title" />
                                        <ComboBoxItem Content="Only matches" />
                                        <ComboBoxItem Content="Cut out" />
                                    </ComboBox>
                                    <TextBox
                                        Width="80"
                                        Margin="4,0,0,0"
                                        Padding="4,2"
                                        VerticalContentAlignment="Center"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        GotKeyboardFocus="ScannedAppTextBox_GotKeyboardFocus"
                                        IsEnabled="{Binding ContentFilterEnabled}"
                                        LostKeyboardFocus="ScannedAppTextBox_LostKeyboardFocus"
                                        Text="{Binding ContentFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Comma-separated words/phrases or regex:&lt;pattern&gt;. To remove ' - dif - ' and keep after: regex:\s*[-–—]\s*dif\s*[-–—]\s*" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="7"
                                    Orientation="Horizontal"
                                    Visibility="{Binding DataContext.WindowActivitySettings.ShowRegexColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <CheckBox
                                        Width="23"
                                        Margin="5,0,0,0"
                                        IsChecked="{Binding UseCustomRegex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        MinWidth="100"
                                        Margin="5,0,5,0"
                                        Padding="5,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        FontSize="{StaticResource FontSizeCompact}"
                                        GotKeyboardFocus="ScannedAppTextBox_GotKeyboardFocus"
                                        IsEnabled="{Binding UseCustomRegex}"
                                        LostKeyboardFocus="ScannedAppTextBox_LostKeyboardFocus"
                                        Text="{Binding CustomRegex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{Binding CustomRegex}" />
                                </StackPanel>
                            </Grid>
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="10"
                                    Direction="0"
                                    Opacity="0.5"
                                    RenderingBias="Performance"
                                    ShadowDepth="0"
                                    Color="black" />
                            </Border.Effect>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
        </Grid>

    </Grid>
</UserControl>

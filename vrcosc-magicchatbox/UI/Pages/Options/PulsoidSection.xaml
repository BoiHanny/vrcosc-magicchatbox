<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.PulsoidSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=sections:PulsoidSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ToggleButton
                Grid.Column="0"
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_HeartRate, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Pulsoid heart rate options"
                TextOptions.TextRenderingMode="ClearType" />

            <TextBlock
                x:Name="LearnMoreAboutHeartbtn"
                Grid.Column="1"
                Width="auto"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Cursor="Hand"
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeCaption}"
                Foreground="{StaticResource AccentTealBrush}"
                MouseUp="LearnMoreAboutHeartbtn_MouseUp"
                Text="Learn more"
                TextDecorations="Underline" />
        </Grid>
        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_HeartRate, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>
                <Border
                    Width="500"
                    Height="auto"
                    Margin="0,0,10,15"
                    HorizontalAlignment="Left"
                    CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#3FE0D2" />
                            <GradientStop Offset="0.35" Color="#6E9BFF" />
                            <GradientStop Offset="0.65" Color="#B96BFF" />
                            <GradientStop Offset="1" Color="#FF6FC7" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="18"
                            Opacity="0.75"
                            RenderingBias="Performance"
                            ShadowDepth="0"
                            Color="#8FD6FF" />
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        BeginTime="0:0:0.25"
                                        Storyboard.TargetName="discountSheenClip"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0"
                                        To="1"
                                        Duration="0:0:0.08" />
                                    <DoubleAnimation
                                        BeginTime="0:0:0.25"
                                        Storyboard.TargetName="discountSheen"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                        From="-60"
                                        To="560"
                                        Duration="0:0:0.9" />
                                    <DoubleAnimation
                                        BeginTime="0:0:1.1"
                                        Storyboard.TargetName="discountSheenClip"
                                        Storyboard.TargetProperty="Opacity"
                                        From="1"
                                        To="0"
                                        Duration="0:0:0.12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid Margin="3">
                        <Border
                            x:Name="discountSheenClip"
                            Margin="-3"
                            ClipToBounds="True"
                            CornerRadius="5"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Panel.ZIndex="2">
                            <Border
                                x:Name="discountSheen"
                                Width="46"
                                HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.5" Color="#A6FFFFFF" />
                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.LayoutTransform>
                                    <SkewTransform AngleX="-20" />
                                </Border.LayoutTransform>
                                <Border.RenderTransform>
                                    <TranslateTransform X="-60" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>

                        <Border
                            Margin="-3"
                            BorderThickness="1"
                            CornerRadius="5"
                            IsHitTestVisible="False"
                            Opacity="0.75"
                            Panel.ZIndex="3"
                            SnapsToDevicePixels="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#5FE6D8" />
                                    <GradientStop Offset="0.5" Color="#A97BFF" />
                                    <GradientStop Offset="1" Color="#FF8AD2" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                        </Border>


                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Width="auto"
                                    Padding="5,5,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeTitle}"
                                    FontWeight="Bold"
                                    Foreground="#12002E"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="15% OFF"
                                    TextWrapping="Wrap">
                                </TextBlock>
                                <TextBlock
                                    Width="auto"
                                    Padding="5,5,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeTitle}"
                                    FontWeight="Bold"
                                    Foreground="#2A1650"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="every month on your"
                                    TextWrapping="Wrap">
                                </TextBlock>
                                <TextBlock
                                    Width="auto"
                                    Padding="5,5,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeTitle}"
                                    FontWeight="Bold"
                                    Foreground="#12002E"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="BRO PLAN"
                                    TextWrapping="Wrap">
                                </TextBlock>
                            </StackPanel>
                            <TextBlock
                                Width="auto"
                                Padding="7,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSecondary}"
                                FontStyle="Italic"
                                FontWeight="Medium"
                                Foreground="#3A2560"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Text="Discount applies to new subscriptions only (cancel possible)"
                                TextWrapping="Wrap">
                            </TextBlock>


                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Name="PulsoidLearnMoreAboutDiscount_btn"
                                Height="auto"
                                Margin="2,0,0,0"
                                VerticalAlignment="Stretch"
                                Command="{Binding PulsoidDiscountLearnMoreCommand}"
                                Opacity="0.8"
                                Style="{DynamicResource Status_Button_style}">
                                <Image
                                    Width="18"
                                    Margin="2"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="/Img/Icons/Info_ico.png" />
                            </Button>
                            <Button
                                Name="ApplyLinkPulsoid_btn"
                                Width="auto"
                                Height="auto"
                                Margin="2,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Command="{Binding PulsoidPricingCommand}"
                                Opacity="0.8"
                                Style="{DynamicResource Status_Button_style}">
                                <Image
                                    Width="25"
                                    Margin="2"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="/Img/Icons/Apply_ico.png" />
                            </Button>
                        </StackPanel>








                    </Grid>

                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="ConnectWithPulsoid"
                            Width="auto"
                            Height="30"
                            Padding="5"
                            Command="{Binding ConnectPulsoidCommand}"
                            Style="{StaticResource Status_Button_style}"
                            Visibility="{Binding Pulsoid.AuthConnected, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="21"
                                            Height="18"
                                            Margin="0,0,3,0"
                                            Source="/Img/Icons/Pulsoid.png" />
                                        <TextBlock
                                            Margin="0,-2,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeCompact}"
                                            Text="Connect with Pulsoid" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button
                            x:Name="ConnectedWithPulsoid"
                            Width="auto"
                            Height="30"
                            Padding="5"
                            d:Visibility="Visible"
                            Command="{Binding ConnectPulsoidCommand}"
                            Style="{StaticResource Status_Button_style}"
                            Visibility="{Binding Pulsoid.AuthConnected, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image
                                            Width="15"
                                            Height="15"
                                            Margin="2,0,5,0"
                                            VerticalAlignment="Center"
                                            Source="/Img/Icons/yes.png" />
                                        <TextBlock
                                            Margin="0,-2,5,0"
                                            VerticalAlignment="Center"
                                            FontSize="{StaticResource FontSizeCompact}"
                                            Text="Connected with Pulsoid" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button
                            x:Name="DisconnectPulsoid"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="20"
                            Height="30"
                            Margin="-5,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            d:Visibility="Visible"
                            Background="{StaticResource StatusErrorDarkerBrush}"
                            BorderThickness="0"
                            Command="{Binding DisconnectPulsoidCommand}"
                            Cursor="Hand"
                            Style="{DynamicResource DisconnectPulsoid}"
                            Visibility="{Binding Pulsoid.AuthConnected, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <Grid>
                                <Image
                                    Width="15"
                                    Height="15"
                                    RenderOptions.BitmapScalingMode="Linear"
                                    Source="/Img/Icons/Cross_v1_ico.png" />
                            </Grid>
                        </Button>
                        <Border Visibility="{Binding Modules.Pulsoid.PulsoidAccessError, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Effect="{StaticResource TextBlockShadowEffect}"
                                FontFamily="{StaticResource FontSecondary}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource TextMutedBrush}"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Text="No device connected"
                                Visibility="{Binding Modules.Pulsoid.PulsoidDeviceOnline, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>
                        <TextBlock
                            Width="400"
                            Padding="10,4,0,4"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeCompact}"
                            Foreground="{StaticResource TextDangerRedBrush}"
                            Text="{Binding Modules.Pulsoid.PulsoidAccessErrorTxt, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Modules.Pulsoid.PulsoidAccessError, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock
                        Margin="2,4,0,0"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextLabelBrush}"
                        Text="{Binding Pulsoid.AuthStatusText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border
                    Padding="0"
                    Opacity="0.8"
                    Style="{StaticResource OptionCardStyle}"
                    Visibility="{Binding Pulsoid.AuthConnected, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <StackPanel Margin="5">
                        <TextBlock
                            x:Name="ManualPulsoidAuthBtn"
                            Margin="0"
                            Padding="0,0,9,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseUp="ManualPulsoidAuthBtn_MouseUp"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Trouble signing in? Paste a token instead" />
                    </StackPanel>
                </Border>
                <!--  Everything below shapes one line. Sitting in the settings is exactly when the
                      band is not on, so the sample stands in for a live beat rather than leaving
                      every switch below with nothing to show for itself.  -->
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What goes in the chatbox" />
                        <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="An example beat of 88, with example stats. Yours will differ, but the wording and the length will look like this." />
                        <controls:SegmentPreview Line="{Binding PreviewLine}" />
                    </StackPanel>
                </Border>

                <Border Padding="0" Style="{StaticResource OptionCardStyle}">

                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="2,0,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Puts a little heart in front of the number, like ❤️ 88." />
                        <CheckBox
                            x:Name="MagicHeartRateICON_checkbox"
                            Margin="2,0"
                            IsChecked="{Binding Modules.Pulsoid.Settings.MagicHeartIconPrefix, Mode=TwoWay}">
                            Show a heart in front of the heart rate
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border
                    Padding="0"
                    Style="{StaticResource OptionCardStyle}"
                    Visibility="{Binding Modules.Pulsoid.Settings.MagicHeartIconPrefix, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="2,0,0,4"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Uses a different heart each time the number updates — ❤️ then 💖 then 💗, and so on." />
                        <CheckBox
                            x:Name="MagicHeartRateIcons_checkbox"
                            Margin="2,0"
                            IsChecked="{Binding Modules.Pulsoid.Settings.MagicHeartRateIcons, Mode=TwoWay}">
                            Change the heart every beat
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Stats over a longer period" />

                        <TextBlock
                            Width="auto"
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="As well as your heart rate right now, you can show what it has been doing over the last day, week or month." />

                        <CheckBox
                            x:Name="EnableStats"
                            Margin="4,4"
                            IsChecked="{Binding Modules.Pulsoid.Settings.PulsoidStatsEnabled, Mode=TwoWay}">
                            Show these longer-term stats
                        </CheckBox>

                        <StackPanel Visibility="{Binding Modules.Pulsoid.Settings.PulsoidStatsEnabled, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                Width="auto"
                                Margin="4,2"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="How far back to look." />
                            <ComboBox
                                x:Name="PulsoidTimeFrame_combo"
                                Width="100"
                                Margin="4,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Modules.Pulsoid.Settings.StatisticsTimeRanges, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedItem="{Binding Modules.Pulsoid.Settings.SelectedStatisticsTimeRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>



                            <TextBlock
                                Width="auto"
                                Padding="4,10,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="Pick what to show from that period. Each one you add costs room on the line — watch the counter in the preview above." />



                            <CheckBox
                                x:Name="ShowCalories"
                                Margin="4,4,2,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.ShowCalories, Mode=TwoWay}">
                                Show calories
                            </CheckBox>

                            <CheckBox
                                x:Name="AverageHeartRate"
                                Margin="4,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.ShowAverageHeartRate, Mode=TwoWay}">
                                Show average heart rate
                            </CheckBox>

                            <CheckBox
                                x:Name="MaximumHeartRate"
                                Margin="4,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.ShowMaximumHeartRate, Mode=TwoWay}">
                                Show maximum heart rate
                            </CheckBox>

                            <CheckBox
                                x:Name="MinimumHeartRate"
                                Margin="4,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.ShowMinimumHeartRate, Mode=TwoWay}">
                                Show minimum heart rate
                            </CheckBox>



                            <CheckBox
                                x:Name="RecordedTime"
                                Margin="4,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.ShowDuration, Mode=TwoWay}">
                                Show how long was recorded
                            </CheckBox>

                            <CheckBox
                                x:Name="ShowSelectTimeInRecordedTime"
                                Margin="4,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.ShowStatsTimeRange, Mode=TwoWay}"
                                Visibility="{Binding Modules.Pulsoid.Settings.ShowDuration, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                Say which period it covers — 'duration over 24h'
                            </CheckBox>

                            <CheckBox
                                x:Name="HideCurrentHeartRate"
                                Margin="4,12,4,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.HideCurrentHeartRate, Mode=TwoWay}">
                                Hide the live number and show only these stats
                            </CheckBox>
                            <CheckBox
                                x:Name="PlaceTrendIndicatorBehindStats"
                                Margin="4,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.TrendIndicatorBehindStats, Mode=TwoWay}">
                                Put the rising/falling arrow after the stats instead of in front
                            </CheckBox>


                        </StackPanel>





                    </StackPanel>
                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Sending your heart rate to your avatar" />

                        <TextBlock
                            Width="auto"
                            Margin="2,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Sends the number to VRChat itself, so an avatar built for it can react — a beating heart, a blush, a gauge. This is separate from the chatbox line above." />

                        <CheckBox
                            x:Name="EnableOSCStats"
                            Margin="4,4"
                            IsChecked="{Binding IntegrationSettings.IntgrHeartRate_OSC, Mode=TwoWay}">
                            Send my heart rate to my avatar
                        </CheckBox>

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IntegrationSettings.IntgrHeartRate_OSC, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <CheckBox
                                x:Name="sentMCBHeartrateInfo_checkbox"
                                Margin="4,4"
                                IsChecked="{Binding Modules.Pulsoid.Settings.SentMCBHeartrateInfo, Mode=TwoWay}">
                                Also send the extras: rising/falling, and the highest, lowest and average
                            </CheckBox>
                            <CheckBox
                                x:Name="sentMCBHeartrateInfoLegacy_checkbox"
                                Margin="4,2"
                                IsChecked="{Binding Modules.Pulsoid.Settings.SentMCBHeartrateInfoLegacy, Mode=TwoWay}"
                                Visibility="{Binding Modules.Pulsoid.Settings.SentMCBHeartrateInfo, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                Send those extras the old way as well, for older avatars
                            </CheckBox>

                            <CheckBox
                                x:Name="SmoothOSCHeartRate_checkbox"
                                Margin="4,10,4,0"
                                IsChecked="{Binding Modules.Pulsoid.Settings.SmoothOSCHeartRate, Mode=TwoWay}">
                                Even out the number sent to the avatar
                            </CheckBox>

                            <StackPanel Margin="4,4,0,0" Visibility="{Binding Modules.Pulsoid.Settings.SmoothOSCHeartRate, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <StackPanel
                                    Margin="0,5,0,5"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource OptionFieldLabelStyle}"
                                        Text="Average the last" />
                                    <TextBox
                                        x:Name="SmoothOSCHeartRate_INT"
                                        Width="auto"
                                        MinWidth="20"
                                        Margin="5,0"
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeBody}"
                                        Text="{Binding Modules.Pulsoid.Settings.SmoothOSCHeartRateTimeSpan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource OptionFieldLabelStyle}"
                                        Text="readings together." />
                                </StackPanel>
                                <TextBlock
                                    Width="auto"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="A chest band sends far more readings per minute than a watch does, so it can be averaged over more of them." />
                            </StackPanel>
                        </StackPanel>





                    </StackPanel>
                </Border>
                <Border
                    Padding="0"
                    Style="{StaticResource OptionCardStyle}"
                    Visibility="{Binding Modules.Pulsoid.Settings.MagicHeartIconPrefix, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,3,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Adds a word next to the number when your heart rate is unusually low or high. The thresholds and the words are yours to set." />
                        <CheckBox
                            x:Name="ShowTemperatureText_checkbox"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.ShowTemperatureText, Mode=TwoWay}">
                            Show a word for how hard you are working
                        </CheckBox>
                        <StackPanel Margin="4,5,0,0" Visibility="{Binding Modules.Pulsoid.Settings.ShowTemperatureText, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    Padding="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Below" />
                                <TextBox
                                    x:Name="LowTemperatureThreshold"
                                    Width="35"
                                    Height="auto"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.LowTemperatureThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="0"
                                    Padding="5,0,5,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="show" />
                                <TextBox
                                    x:Name="LowHeartRateText"
                                    Height="auto"
                                    MinWidth="60"
                                    Padding="3,0"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.LowHeartRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,5,0,5" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    Padding="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Above" />
                                <TextBox
                                    x:Name="HighTemperatureThreshold"
                                    Width="35"
                                    Height="auto"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.HighTemperatureThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="0"
                                    Padding="5,0,4,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="show" />
                                <TextBox
                                    x:Name="HighwHeartRateText"
                                    Height="auto"
                                    MinWidth="60"
                                    Margin="0,0,0,0"
                                    Padding="3,0"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.HighHeartRateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,3,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Adds an arrow when your heart rate is climbing or dropping quickly. Nothing is shown while it is steady." />
                        <CheckBox
                            x:Name="ShowHeartRateTrendIndicator"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.ShowHeartRateTrendIndicator, Mode=TwoWay}">
                            Show an arrow when it is rising or falling
                        </CheckBox>
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Pulsoid.Settings.ShowHeartRateTrendIndicator, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Which arrows to use" />
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                <ComboBox
                                    x:Name="PulsoidTrendSymbols"
                                    Width="100"
                                    Margin="4,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="CombinedTrendSymbol"
                                    ItemsSource="{Binding Modules.Pulsoid.Settings.PulsoidTrendSymbols, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedItem="{Binding Modules.Pulsoid.Settings.SelectedPulsoidTrendSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel
                                Margin="4,5,0,10"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Look at the last" />
                                <TextBox
                                    x:Name="HeartRateTrendIndicatorSampleRate_INT"
                                    Width="auto"
                                    MinWidth="20"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.HeartRateTrendIndicatorSampleRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="readings to decide whether it is rising or falling." />
                            </StackPanel>


                            <TextBlock
                                Width="auto"
                                Margin="0"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="How big a change counts" />
                            <StackPanel Margin="3,0" Orientation="Horizontal">

                                <TextBlock
                                    Width="auto"
                                    Padding="2,5,5,5"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSecondary}"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="Small change" />
                                <Slider
                                    x:Name="HeartRateTrendIndicatorSensitivitySlider"
                                    Width="134.5"
                                    Height="12"
                                    Margin="2.2,0,4.5,0"
                                    Maximum="1"
                                    Minimum="0"
                                    Style="{StaticResource CustomSlider}"
                                    Value="{Binding Path=Modules.Pulsoid.Settings.HeartRateTrendIndicatorSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Width="auto"
                                    Padding="5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSecondary}"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="Big change" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,3,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Averages the last few readings so the number in the chatbox does not jump around." />
                        <CheckBox
                            x:Name="SmoothHeartRate_checkbox"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.SmoothHeartRate, Mode=TwoWay}">
                            Even out the number in the chatbox
                        </CheckBox>
                        <StackPanel Margin="4,4,0,0" Visibility="{Binding Modules.Pulsoid.Settings.SmoothHeartRate, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel
                                Margin="0,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Average the last" />
                                <TextBox
                                    x:Name="SmoothHeartRate_INT"
                                    Width="auto"
                                    MinWidth="20"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.SmoothHeartRateTimeSpan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="readings together." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,3,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Keeps the number from running away during a scare or a hard workout. Anything above the cap is squeezed into a small range just above it rather than shown as-is." />
                        <CheckBox
                            x:Name="ThrottleHR"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.ThrottleHR, Mode=TwoWay}">
                            Cap very high readings
                        </CheckBox>

                        <StackPanel Margin="4,5,0,0" Visibility="{Binding Modules.Pulsoid.Settings.ThrottleHR, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">



                            <StackPanel
                                Margin="0,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Stop counting normally above" />
                                <TextBox
                                    x:Name="throttleRangeMin"
                                    Width="auto"
                                    MinWidth="20"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.ThrottleHRMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="BPM" />

                            </StackPanel>

                            <StackPanel
                                Margin="0,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Squeeze the rest into a further" />

                                <TextBox
                                    x:Name="throttleHRMax"
                                    Width="auto"
                                    MinWidth="20"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.ThrottleMaxAdditional, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="BPM" />
                            </StackPanel>
                            <TextBlock
                                Width="auto"
                                Margin="0,0,0,5"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="So a reading well above the cap still moves the number a little, instead of sticking flat at the cap." />


                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,2,0,3"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Adds or subtracts a fixed amount from every reading. Use it if you know your sensor reads high or low — put a minus in front to subtract." />
                        <CheckBox
                            x:Name="ApplyHeartRateAdjustment_checkbox"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.ApplyHeartRateAdjustment, Mode=TwoWay}">
                            Correct a sensor that reads high or low
                        </CheckBox>

                        <StackPanel Margin="4,5,0,0" Visibility="{Binding Modules.Pulsoid.Settings.ApplyHeartRateAdjustment, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel
                                Margin="0,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Change every reading by" />
                                <TextBox
                                    x:Name="HeartRateAdjustment"
                                    Width="auto"
                                    MinWidth="20"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.HeartRateAdjustment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="BPM" />
                            </StackPanel>


                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,3,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="If the readings stop coming in — the band slipped, the battery died — the heart rate disappears from the chatbox instead of freezing on the last number." />
                        <CheckBox
                            x:Name="EnableHeartRateOfflineCheck_checkbox"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.EnableHeartRateOfflineCheck, Mode=TwoWay}">
                            Hide the heart rate when the sensor stops
                        </CheckBox>
                        <StackPanel Margin="4,5,0,0" Visibility="{Binding Modules.Pulsoid.Settings.EnableHeartRateOfflineCheck, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel
                                Margin="0,5,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="If nothing changes for" />
                                <TextBox
                                    x:Name="UnchangedHeartRateLimit_INT"
                                    Width="auto"
                                    MinWidth="20"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.UnchangedHeartRateTimeoutInSec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="seconds, treat the sensor as gone." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,3,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Puts ᵇᵖᵐ after the number, so it reads 88 ᵇᵖᵐ instead of just 88." />
                        <CheckBox
                            x:Name="ShowBPMSuffix_checkbox"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.ShowBPMSuffix, Mode=TwoWay}">
                            Show 'bpm' after the number
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,3,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Older avatars expect the heart rate under a second, older set of names. Turn this on to stop sending those — slightly less work, but an avatar built for the old names will stop reacting." />
                        <CheckBox
                            x:Name="DisableLegacyOSCSupport_checkbox"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.DisableLegacySupport, Mode=TwoWay}">
                            Stop sending the old avatar values
                        </CheckBox>
                    </StackPanel>
                </Border>
                <Border Padding="0" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Width="auto"
                            Margin="4,3,0,2"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Puts a few words in front of the number so it does not appear on its own." />
                        <CheckBox
                            x:Name="HeartRateTitle_checkbox"
                            Margin="4,2"
                            IsChecked="{Binding Modules.Pulsoid.Settings.HeartRateTitle, Mode=TwoWay}">
                            Put a label in front of the heart rate
                        </CheckBox>

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding Modules.Pulsoid.Settings.HeartRateTitle, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="Whatever you type here goes in front. Keep it short — it costs the same room as anything else on the line." />
                            <StackPanel
                                Margin="4,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Label" />
                                <TextBox
                                    x:Name="HeartRateTitleCustom"
                                    Width="auto"
                                    MinWidth="50"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding Modules.Pulsoid.Settings.CurrentHeartRateTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <CheckBox
                                x:Name="HeartRateTitleStackMethod_checkbox"
                                Margin="4,3"
                                IsChecked="{Binding Modules.Pulsoid.Settings.SeparateTitleWithEnter, Mode=TwoWay}">
                                Put the label on its own line
                            </CheckBox>

                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

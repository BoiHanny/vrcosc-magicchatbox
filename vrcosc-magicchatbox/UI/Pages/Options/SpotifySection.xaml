<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.SpotifySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:SpotifySectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>

        <ToggleButton
            Grid.Row="0"
            Width="Auto"
            Height="30"
            HorizontalAlignment="Left"
            IsChecked="{Binding AppSettings.Settings_Spotify, Mode=TwoWay}"
            Style="{StaticResource ExpandCollapseToggleButtonStyle}"
            Tag="Spotify options"
            TextOptions.TextRenderingMode="ClearType" />

        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_Spotify, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>
                <Border
                    Margin="0,0,0,10"
                    BorderBrush="#735A41"
                    BorderThickness="1"
                    CornerRadius="5"
                    Style="{StaticResource OptionCardStyle}">
                    <Border.Background>
                        <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                            <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                            <GradientStop Offset="1" Color="{StaticResource GradientDeepPurpleColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeSecondary}"
                        Foreground="{StaticResource StatusWarningBrush}"
                        TextWrapping="Wrap">
                        <Run Text="🧪 Still being tested: talking to Spotify directly is new in this version. Please report anything that goes wrong on" />
                        <Hyperlink
                            Foreground="{StaticResource AccentTealBrush}"
                            NavigateUri="https://github.com/BoiHanny/vrcosc-magicchatbox/issues/new/choose"
                            RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="GitHub" />
                        </Hyperlink>
                        <Run Text="or in our" />
                        <Hyperlink
                            Foreground="{StaticResource AccentTealBrush}"
                            NavigateUri="https://discord.gg/ZaSFwBfhvG"
                            RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="Discord server" />
                        </Hyperlink>
                        <Run Text="." />
                    </TextBlock>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Width="auto"
                                Height="30"
                                Padding="5"
                                Click="ConnectSpotify_Click"
                                IsEnabled="{Binding CanStartConnection}"
                                Style="{StaticResource Status_Button_style}"
                                Visibility="{Binding Display.IsConnected, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,5,0"
                                        Source="/Img/Icons/spotify_ico.png" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeCompact}"
                                        Text="Connect Spotify" />
                                </StackPanel>
                            </Button>
                            <Button
                                Width="auto"
                                Height="30"
                                Padding="5"
                                Command="{Binding DisconnectSpotifyCommand}"
                                Style="{StaticResource Status_Button_style}"
                                Visibility="{Binding Display.IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,5,0"
                                        Source="/Img/Icons/spotify_ico.png" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{StaticResource FontSizeCompact}"
                                        Text="Disconnect Spotify" />
                                </StackPanel>
                            </Button>
                            <Button
                                Width="auto"
                                Height="30"
                                Margin="6,0,0,0"
                                Padding="5"
                                Command="{Binding RefreshSpotifyCommand}"
                                Style="{StaticResource Status_Button_style}"
                                Visibility="{Binding Display.IsConnected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeCompact}"
                                    Text="Check Spotify now" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Margin="2,6,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="{Binding StatusText, UpdateSourceTrigger=PropertyChanged}" />
                        <Border
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="#33FFC107"
                            BorderBrush="{StaticResource StatusWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource StatusWarningBrush}"
                                    Text="★ The play, pause and skip buttons need Spotify Premium." />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="They also need Spotify to be open somewhere - your phone, the desktop app or the web player. If nothing happens when you press them, start Spotify there first." />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontFamily="{StaticResource FontPrimary}"
                                    FontSize="{StaticResource FontSizeSecondary}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding Display.ErrorText}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasDisplayError, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Setting up the connection" />
                        <TextBlock
                            Margin="0,3,0,6"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="MagicChatbox never sees your Spotify password. Pressing Connect Spotify opens your browser, you say yes there, and Spotify hands back a key that only lets this app read what you are playing." />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                Width="118"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Return address" />
                            <TextBox
                                Width="276"
                                Margin="0,0,8,0"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeSecondary}"
                                IsReadOnly="True"
                                Text="{Binding RedirectUri, Mode=OneWay}" />
                            <Button
                                Width="70"
                                Height="26"
                                Command="{Binding CopyRedirectUriCommand}"
                                Content="Copy"
                                Style="{StaticResource Status_Button_style}" />
                        </StackPanel>
                        <TextBlock
                            Margin="2,6,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="This is where Spotify sends you back to after you say yes. Copy it into the &quot;Redirect URI&quot; box of your app on the Spotify Developer Dashboard, or the connection will be refused." />
                        <CheckBox Margin="0,8,0,0" IsChecked="{Binding Settings.AutoConnectOnStartup, Mode=TwoWay}">
                            Connect again by itself when MagicChatbox starts
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="When Spotify and Media link are both on" />
                        <TextBlock
                            Margin="0,3,0,6"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Media link follows anything Windows plays, and that includes Spotify - so with both switched on the same song can end up in the chatbox twice. This decides what happens then." />
                        <ComboBox
                            Width="270"
                            HorizontalAlignment="Left"
                            FontSize="{StaticResource FontSizeSecondary}"
                            ItemsSource="{Binding MediaLinkCoexistenceModes}"
                            SelectedItem="{Binding Settings.MediaLinkCoexistence, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What the line says" />
                        <TextBlock
                            Margin="0,3,0,4"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Write the line however you like. Anything in curly brackets is swapped for the real thing as the song plays; everything else is printed as you typed it. Pick a ready-made one on the right if you would rather not." />
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="You can use: {play_icon}, {title}, {artist}, {album}, {device}, {volume}, {progress}, {seekbar}, {elapsed}, {duration}, {remaining}, {percent}, {liked_icon}, {explicit_icon}, {shuffle_icon}, {repeat_icon}, {queue}, {separator}" />
                        <Button
                            Width="140"
                            Height="25"
                            Margin="0,0,0,5"
                            HorizontalAlignment="Left"
                            Command="{Binding CopyTemplateTokensCommand}"
                            Content="Copy that list"
                            Style="{StaticResource Status_Button_style}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox
                                Width="420"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Settings.OutputTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Width="130"
                                Margin="8,0,0,0"
                                DisplayMemberPath="Name"
                                FontSize="{StaticResource FontSizeCaption}"
                                ItemsSource="{Binding TemplatePresets}"
                                SelectedValue="{Binding SelectedPresetName, Mode=TwoWay}"
                                SelectedValuePath="Name">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="IsEnabled" Value="True" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock
                            Margin="2,8,0,3"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="And when Party mode is on" />
                        <TextBox
                            Width="420"
                            HorizontalAlignment="Left"
                            Padding="5,0,0,0"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding Settings.PartyTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!--  Built by BuildOutputString(useSample: true), so the line is real even when
                              nothing is playing - the same trick every other music preview now uses.  -->
                        <controls:SegmentPreview Caption="With nothing playing, this is what would go out" Line="{Binding OutputPreview, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Icons, and what to say instead" />
                        <TextBlock
                            Margin="0,3,0,6"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="The little pieces the curly brackets above are swapped for. Leave an icon blank to hide it." />
                        <WrapPanel Margin="0,2,0,0">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Playing" />
                                <TextBox Width="46" Text="{Binding Settings.IconPlaying, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Paused" />
                                <TextBox Width="46" Text="{Binding Settings.IconPaused, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Explicit" />
                                <TextBox Width="46" Text="{Binding Settings.IconExplicit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Liked" />
                                <TextBox Width="46" Text="{Binding Settings.IconLiked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Not liked" />
                                <TextBox Width="46" Text="{Binding Settings.IconUnliked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Between pieces" />
                                <TextBox Width="80" Text="{Binding Settings.Separator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel Margin="0,3,0,0">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Say this when not connected" />
                                <TextBox Width="190" Text="{Binding Settings.DisconnectedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="...when nothing is playing" />
                                <TextBox Width="190" Text="{Binding Settings.EmptyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="...when paused" />
                                <TextBox Width="150" Text="{Binding Settings.PausedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="...when hiding what you play" />
                                <TextBox Width="120" Text="{Binding Settings.PrivacyHiddenText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What to show, and what to keep to yourself" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="These are two separate switches for each piece of the song, and a piece only appears when both of them are on. The first row is what MagicChatbox is allowed to say at all; the second is what this particular line includes." />

                        <TextBlock
                            Margin="2,8,0,3"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Allowed to leave your PC" />
                        <WrapPanel>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.AllowTrackTitleInOutput, Mode=TwoWay}">Song name</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.AllowArtistInOutput, Mode=TwoWay}">Artist</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.AllowAlbumInOutput, Mode=TwoWay}">Album</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.AllowDeviceInOutput, Mode=TwoWay}">Which speaker or phone</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.AllowVolumeInOutput, Mode=TwoWay}">Volume</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.AllowPlaybackStateInOutput, Mode=TwoWay}">Playing or paused</CheckBox>
                        </WrapPanel>
                        <CheckBox Margin="0,4,12,4" IsChecked="{Binding Settings.PrivacyMode, Mode=TwoWay}">
                            Hide it all for now, and say the words above instead
                        </CheckBox>

                        <TextBlock
                            Margin="2,10,0,3"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Included in the line" />
                        <WrapPanel>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowTitle, Mode=TwoWay}">Song name</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowArtist, Mode=TwoWay}">Artist</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowAlbum, Mode=TwoWay}">Album</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowProgress, Mode=TwoWay}">How far through</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowDevice, Mode=TwoWay}">Which speaker or phone</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowVolume, Mode=TwoWay}">Volume</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowExplicit, Mode=TwoWay}">Explicit mark</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowLiked, Mode=TwoWay}">Whether you liked it</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowShuffle, Mode=TwoWay}">Shuffle mark</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowRepeat, Mode=TwoWay}">Repeat mark</CheckBox>
                        </WrapPanel>
                        <CheckBox Margin="0,4,12,4" IsChecked="{Binding Settings.PartyModeEnabled, Mode=TwoWay}">
                            Use the Party mode line instead, for when you are the one picking the music
                        </CheckBox>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock
                                Margin="2,0,6,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="How to show it" />
                            <ComboBox
                                Width="230"
                                Margin="0,0,16,0"
                                ItemsSource="{Binding ProgressDisplayModes}"
                                SelectedItem="{Binding Settings.ProgressDisplayMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox IsChecked="{Binding Settings.AutoDowngradeProgress, Mode=TwoWay}">Use a shorter progress bar when the line runs out of room</CheckBox>
                        </StackPanel>
                        <StackPanel
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding IsSeekbarMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                                Margin="2,0,6,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Which progress bar" />
                            <ComboBox
                                Width="280"
                                DisplayMemberPath="StyleName"
                                ItemsSource="{Binding SeekbarStyles}"
                                SelectedItem="{Binding SelectedSeekbarStyle, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock
                            Margin="2,4,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Spotify shares its progress bars with Media link. Make your own, or load someone else's, in the Media link section just above." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Show it briefly, then hide it" />
                        <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="Announce each new song for a few seconds and then give the room back to your other integrations, instead of showing the song the whole time it plays. Media link has its own copy of this in its own section." />
                        <CheckBox Margin="3,7" IsChecked="{Binding Settings.ShowOnlyOnChange, Mode=TwoWay}">
                            Only show the song when it changes
                        </CheckBox>
                        <StackPanel
                            Margin="3,0"
                            Orientation="Horizontal"
                            Visibility="{Binding Settings.ShowOnlyOnChange, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Hide it again after" />
                            <TextBox
                                Width="40"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Settings.TransientDuration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="seconds" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="The Spotify panel in MagicChatbox" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="This is about the panel inside this app, not about your chatbox." />
                        <WrapPanel Margin="0,4,0,0">
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowWidgetProgress, Mode=TwoWay}">Show how far through</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowWidgetDevice, Mode=TwoWay}">Show which speaker or phone</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowWidgetControls, Mode=TwoWay}">Show the play and skip buttons</CheckBox>
                            <CheckBox Margin="0,0,12,4" IsChecked="{Binding Settings.ShowWidgetVolume, Mode=TwoWay}">Show the volume slider</CheckBox>
                        </WrapPanel>

                        <TextBlock
                            Margin="2,10,0,3"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="How often to ask Spotify what is playing" />
                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Smaller numbers keep the line more up to date and use more of your connection. Spotify starts refusing if you ask far too often." />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                            <TextBlock
                                Margin="2,0,6,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="While something is playing, every" />
                            <TextBox
                                Width="50"
                                Margin="0,0,6,0"
                                Text="{Binding Settings.PollingIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="seconds" />
                            <TextBlock
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="otherwise, every" />
                            <TextBox
                                Width="50"
                                Margin="0,0,6,0"
                                Text="{Binding Settings.IdlePollingIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="seconds" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

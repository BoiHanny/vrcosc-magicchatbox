<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.StatusSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:StatusSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                FontSize="15"
                FontWeight="Bold"
                Foreground="{StaticResource TextSectionHeaderBrush}"
                IsChecked="{Binding AppSettings.Settings_Status, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Status options"
                TextOptions.TextRenderingMode="ClearType" />

        </Grid>


        <Grid
            x:Name="Settings_Status_Grid"
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_Status, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel Margin="5">

                <Border Style="{StaticResource OptionCardStyle}">

                    <CheckBox
                        x:Name="StatusIconPrefix_checkbox"
                        Margin="5"
                        IsChecked="{Binding AppSettings.PrefixIconStatus, Mode=TwoWay}"
                        Style="{DynamicResource SettingsCheckbox}">
                        Add 💬 as prefix for the personal status
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource OptionCardStyle}">

                    <StackPanel>
                        <CheckBox
                            x:Name="EnableEmojiShuffle_checkbox"
                            Margin="5"
                            IsChecked="{Binding AppSettings.EnableEmojiShuffle, Mode=TwoWay}"
                            Style="{DynamicResource SettingsCheckbox}">
                            Enable custom prefix icon shuffle
                        </CheckBox>
                        <StackPanel Visibility="{Binding AppSettings.EnableEmojiShuffle, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                Width="auto"
                                Padding="4,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="13"
                                Foreground="{StaticResource TextLabelBrush}"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="Make sure to add the emojis you want to cycle through in the text box below, separated by a space or comma." />
                            <TextBox
                                MinWidth="50"
                                MaxWidth="630"
                                Margin="4,3,0,10"
                                Padding="5,0,5,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="15"
                                Text="{Binding Emojis.EmojiListString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Width="auto"
                                Padding="4,5,0,0"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="13"
                                Foreground="{StaticResource TextLabelBrush}"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="Here you can add your custom emojis to cycle through." />
                            <StackPanel Orientation="Horizontal">

                                <TextBox
                                    x:Name="EmojiNew"
                                    Width="auto"
                                    Height="30"
                                    MinWidth="25"
                                    Margin="5"
                                    Padding="5,0,5,0"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="15"
                                    PreviewKeyUp="EmojiNew_PreviewKeyUp"
                                    Text="" />
                                <Button
                                    x:Name="AddEmojiButton"
                                    Width="auto"
                                    Height="30"
                                    Padding="5"
                                    Click="AddEmojiButton_Click"
                                    Style="{StaticResource Status_Button_style}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Width="21"
                                                    Height="18"
                                                    Margin="0,0,3,0"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    Source="/Img/Icons/Add.png" />
                                                <TextBlock
                                                    Margin="0,-2,5,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="Add emoji to cycle" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </StackPanel>
                        </StackPanel>







                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <CheckBox
                        x:Name="CycleStatus_checkbox"
                        Margin="5"
                        IsChecked="{Binding AppSettings.CycleStatus, Mode=TwoWay}"
                        Style="{DynamicResource SettingsCheckbox}">
                        Cycle status items that are marked with 💛
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource OptionCardStyle}" Visibility="{Binding AppSettings.CycleStatus, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">

                    <CheckBox
                        x:Name="IsRandomCycling_checkbox"
                        Margin="5"
                        IsChecked="{Binding AppSettings.IsRandomCycling, Mode=TwoWay}"
                        Style="{DynamicResource SettingsCheckbox}">
                        Cycle status items in random order
                    </CheckBox>


                </Border>

                <Border Style="{StaticResource OptionCardStyle}" Visibility="{Binding AppSettings.CycleStatus, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock
                            Padding="0,0,9,0"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="15"
                            Foreground="{StaticResource TextLabelBrush}"
                            Text="Cycle to the next every" />
                        <TextBox
                            x:Name="SwitchStatusInterval"
                            Width="auto"
                            Height="auto"
                            Margin="0,0,0,0"
                            Padding="5,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="15"
                            Text="{Binding AppSettings.SwitchStatusInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center" />
                        <TextBlock
                            Padding="5,0,5,0"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="15"
                            Foreground="{StaticResource TextLabelBrush}"
                            Text="seconds" />

                    </StackPanel>

                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock
                            Padding="2,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="20"
                            Foreground="{StaticResource TextLabelBrush}"
                            Style="{StaticResource OptionSubsectionHeaderStyle}"
                            Text="AFK Detection" />

                        <TextBlock
                            Width="auto"
                            Padding="2,3,0,0"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="13"
                            FontStyle="Italic"
                            Foreground="{StaticResource TextLabelBrush}"
                            Opacity="0.5"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="You can show a custom message when you are AFK" />

                        <CheckBox
                            x:Name="EnableAFKDetectCheck"
                            Margin="4,5,4,4"
                            IsChecked="{Binding Afk.Settings.EnableAfkDetection, Mode=TwoWay}"
                            Style="{DynamicResource SettingsCheckbox}">
                            Enable AFK detection
                        </CheckBox>

                        <CheckBox
                            Margin="4,5,4,4"
                            IsChecked="{Binding Afk.Settings.ActivateInVR, Mode=TwoWay}"
                            Style="{DynamicResource SettingsCheckbox}">
                            Enable When in VR
                        </CheckBox>


                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock
                                Padding="0,0,4,0"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="15"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Timeout time in" />
                            <TextBox
                                x:Name="TimeoutTime"
                                Width="auto"
                                Height="auto"
                                Margin="0,0,0,0"
                                Padding="5,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="15"
                                Text="{Binding Afk.Settings.AfkTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />

                            <TextBlock
                                Padding="4,0,2,0"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="15"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="seconds" />

                            <TextBlock
                                Margin="0,-5,0,0"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                FontStyle="Italic"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="{Binding Afk.FriendlyTimeoutTime, UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>

                        <CheckBox
                            Margin="4,5,4,4"
                            IsChecked="{Binding Afk.Settings.UseSmallLettersForDuration, Mode=TwoWay}"
                            Style="{DynamicResource SettingsCheckbox}">
                            Use small letters for duration suffix
                        </CheckBox>

                        <!--  ====================================================================
                              AFK STYLES. A style is a whole way of saying you are away - prefix,
                              wording, whether the clock shows - saved under a name and switchable
                              from the side panel. What used to be four loose fields here is now
                              one of these, so nothing was lost, it just got a name.
                              ====================================================================  -->
                        <TextBlock
                            Padding="4,15,9,0"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="19"
                            Foreground="{StaticResource TextLabelBrush}"
                            Style="{StaticResource OptionSubsectionHeaderStyle}"
                            Text="AFK styles" />

                        <TextBlock
                            Padding="4,0,9,8"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="13"
                            FontStyle="Italic"
                            Foreground="{StaticResource TextLabelBrush}"
                            Opacity="0.5"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Build as many as you like and switch between them from the side panel. Use \n for a new line."
                            TextWrapping="Wrap" />

                        <StackPanel Margin="4,0,4,6" Orientation="Horizontal">
                            <ComboBox
                                Width="190"
                                Height="26"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Name"
                                IsSynchronizedWithCurrentItem="False"
                                ItemsSource="{Binding AfkStyles.Styles}"
                                SelectedItem="{Binding AfkStyles.SelectedStyle, Mode=TwoWay}"
                                Style="{StaticResource FlatComboBoxStyle}" />

                            <Button
                                Height="26"
                                Margin="6,0,0,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.AddStyleCommand}"
                                Content="Duplicate"
                                Style="{DynamicResource Status_Button_style}"
                                ToolTip="Start a new style from the one you have selected" />

                            <Button
                                Height="26"
                                Margin="6,0,0,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.DeleteStyleCommand}"
                                Content="Delete"
                                Style="{DynamicResource Status_Button_style}"
                                ToolTip="Delete this style. The ones that ship with MagicChatbox cannot be deleted." />

                            <Button
                                Height="26"
                                Margin="16,0,0,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ExportStylesCommand}"
                                Content="Export"
                                Style="{DynamicResource Status_Button_style}"
                                ToolTip="Save the styles you made to a file. The ones that ship with the app are not included - they are already in it." />

                            <Button
                                Height="26"
                                Margin="6,0,0,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ImportStylesCommand}"
                                Content="Import"
                                Style="{DynamicResource Status_Button_style}"
                                ToolTip="Load styles from a file. They are added to yours, never on top of them." />
                        </StackPanel>

                        <TextBlock
                            Margin="4,0,4,6"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="11"
                            FontStyle="Italic"
                            Foreground="#FFFFD79A"
                            Text="{Binding AfkStyles.EditHint}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource OptionHelpTextStyle}" TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AfkStyles.EditHint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="4,4,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="14"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="Name" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,6"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="14"
                                IsReadOnly="{Binding AfkStyles.CanEditSelected, Converter={StaticResource InvertBooleanConverter}}"
                                Text="{Binding AfkStyles.SelectedStyle.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                VerticalAlignment="Center"
                                IsChecked="{Binding AfkStyles.SelectedStyle.ShowPrefix, Mode=TwoWay}"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                Style="{DynamicResource SettingsCheckbox}">
                                Prefix
                            </CheckBox>
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,6"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="14"
                                IsEnabled="{Binding AfkStyles.SelectedStyle.ShowPrefix}"
                                IsReadOnly="{Binding AfkStyles.CanEditSelected, Converter={StaticResource InvertBooleanConverter}}"
                                Text="{Binding AfkStyles.SelectedStyle.Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                VerticalAlignment="Center"
                                IsChecked="{Binding AfkStyles.SelectedStyle.ShowTime, Mode=TwoWay}"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                Style="{DynamicResource SettingsCheckbox}"
                                ToolTip="Show how long you have been away">
                                With clock
                            </CheckBox>
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,0,0,6"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="14"
                                IsEnabled="{Binding AfkStyles.SelectedStyle.ShowTime}"
                                IsReadOnly="{Binding AfkStyles.CanEditSelected, Converter={StaticResource InvertBooleanConverter}}"
                                Text="{Binding AfkStyles.SelectedStyle.MessageWithTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="The duration is added straight after this text, so end it with a space." />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="14"
                                Foreground="{StaticResource TextLabelBrush}"
                                Text="No clock" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,0,0,6"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="14"
                                IsReadOnly="{Binding AfkStyles.CanEditSelected, Converter={StaticResource InvertBooleanConverter}}"
                                Text="{Binding AfkStyles.SelectedStyle.MessageWithoutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Used when the clock is off, and whenever there is no duration to show yet." />
                        </Grid>

                        <!--  Same Render() the chatbox line comes from, so this cannot drift from reality.  -->
                        <Border
                            Margin="4,6,4,0"
                            Padding="10,8"
                            Background="{StaticResource AccentDeepPurpleBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="/Fonts/#Comfortaa"
                                    FontSize="15"
                                    Foreground="White"
                                    Text="{Binding AfkStyles.PreviewLine}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="/Fonts/#Albert Sans"
                                    FontSize="11"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding AfkStyles.PreviewCost}" />
                            </StackPanel>
                        </Border>

                        <!--  ====================================================================
                              THE COMPOSER. Fancy text is the whole appeal of an AFK line and there
                              is no way to type it on a keyboard, so the app types it for you and
                              drops it straight into the field rather than sending you to a website
                              and back through the clipboard.
                              ====================================================================  -->
                        <TextBlock
                            Padding="4,16,9,0"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="15"
                            Foreground="{StaticResource TextLabelBrush}"
                            Text="Make fancy text" />
                        <TextBlock
                            Padding="4,0,9,6"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="12"
                            FontStyle="Italic"
                            Foreground="{StaticResource TextLabelBrush}"
                            Opacity="0.5"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Type normally, pick a look, then drop it into one of the fields above. Letters with no fancy version are left alone."
                            TextWrapping="Wrap" />

                        <StackPanel Margin="4,0,4,0" Orientation="Horizontal">
                            <TextBox
                                Width="220"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="14"
                                Text="{Binding AfkStyles.ComposerInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Width="130"
                                Height="26"
                                Margin="6,0,0,0"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding AfkStyles.TextStyles}"
                                SelectedItem="{Binding AfkStyles.ComposerStyle, Mode=TwoWay}"
                                Style="{StaticResource FlatComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Border
                            Margin="4,6,4,0"
                            Padding="10,8"
                            Background="{StaticResource SurfaceButtonDarkBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="/Fonts/#Comfortaa"
                                    FontSize="15"
                                    Foreground="White"
                                    Text="{Binding AfkStyles.ComposerOutput}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontFamily="/Fonts/#Albert Sans"
                                    FontSize="11"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="{Binding AfkStyles.ComposerCost}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="4,6,4,0" Orientation="Horizontal">
                            <Button
                                Height="26"
                                Margin="0,0,6,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ApplyComposerToCommand}"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                CommandParameter="WithTime"
                                Content="Use for with clock"
                                Style="{DynamicResource Status_Button_style}" />
                            <Button
                                Height="26"
                                Margin="0,0,6,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ApplyComposerToCommand}"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                CommandParameter="WithoutTime"
                                Content="Use for no clock"
                                Style="{DynamicResource Status_Button_style}" />
                            <Button
                                Height="26"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ApplyComposerToCommand}"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                CommandParameter="Prefix"
                                Content="Use as prefix"
                                Style="{DynamicResource Status_Button_style}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding AppState.BussyBoysMode, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">

                            <TextBlock
                                Padding="4,15,9,0"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="19"
                                Foreground="{StaticResource TextLabelBrush}"
                                Style="{StaticResource OptionSubsectionHeaderStyle}"
                                Text="Bussy Boys (custom counting from date and more)" />

                            <CheckBox
                                Margin="4,5,4,4"
                                IsChecked="{Binding TimeSettings.BussyBoysMultiMODE, Mode=TwoWay}"
                                Style="{DynamicResource SettingsCheckbox}">
                                Allow personal AFK + Status
                            </CheckBox>

                            <CheckBox
                                Margin="4,5,4,4"
                                IsChecked="{Binding TimeSettings.BussyBoysDateEnable, Mode=TwoWay}"
                                Style="{DynamicResource SettingsCheckbox}">
                                Start custom counting ↴
                            </CheckBox>

                            <DatePicker
                                Width="250"
                                Margin="3,5,4,4"
                                HorizontalAlignment="Left"
                                BorderThickness="0"
                                IsTodayHighlighted="True"
                                Opacity="0.5"
                                SelectedDate="{Binding TimeSettings.BussyBoysDate, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>

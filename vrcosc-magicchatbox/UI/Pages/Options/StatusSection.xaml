<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.StatusSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:StatusSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_Status, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Status options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>

        <Grid
            x:Name="Settings_Status_Grid"
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_Status, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel Margin="5">

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="The icon in front of your status" />

                        <!--  Sample words, so the icon settings can be judged before anyone joins a world.  -->
                        <controls:SegmentPreview Caption="Your status will look like this" Line="{Binding StatusPreview}" />

                        <CheckBox
                            x:Name="StatusIconPrefix_checkbox"
                            Margin="0,10,0,0"
                            IsChecked="{Binding AppSettings.PrefixIconStatus, Mode=TwoWay}">
                            Put an icon in front of my status
                        </CheckBox>

                        <CheckBox
                            x:Name="EnableEmojiShuffle_checkbox"
                            Margin="0,6,0,0"
                            IsChecked="{Binding AppSettings.EnableEmojiShuffle, Mode=TwoWay}">
                            Use my own icons, a different one each time
                        </CheckBox>

                        <StackPanel Visibility="{Binding AppSettings.EnableEmojiShuffle, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="Every icon in this list gets a turn before any of them comes round again. Separate them with a space or a comma. This same list can be used in front of the messages you type - there is a switch for that in Chatting options." />
                            <TextBox
                                MinWidth="50"
                                MaxWidth="630"
                                Margin="4,3,0,10"
                                Padding="5,0,5,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Emojis.EmojiListString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="Or add one at a time here." />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    x:Name="EmojiNew"
                                    Width="auto"
                                    Height="30"
                                    MinWidth="25"
                                    Margin="5"
                                    Padding="5,0,5,0"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    PreviewKeyUp="EmojiNew_PreviewKeyUp"
                                    Text="" />
                                <Button
                                    x:Name="AddEmojiButton"
                                    Width="auto"
                                    Height="30"
                                    Padding="5"
                                    Click="AddEmojiButton_Click"
                                    Style="{StaticResource Status_Button_style}">
                                    <Button.ContentTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image
                                                    Width="21"
                                                    Height="18"
                                                    Margin="0,0,3,0"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    Source="/Img/Icons/Add.png" />
                                                <TextBlock
                                                    Margin="0,-2,5,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSizeCompact}"
                                                    Text="Add to the list" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Button.ContentTemplate>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Showing more than one status" />
                        <CheckBox x:Name="CycleStatus_checkbox" IsChecked="{Binding AppSettings.CycleStatus, Mode=TwoWay}">
                            Take turns showing every status marked 💛
                        </CheckBox>
                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Without this, only the one status you picked is shown." />

                        <StackPanel Visibility="{Binding AppSettings.CycleStatus, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <CheckBox
                                x:Name="IsRandomCycling_checkbox"
                                Margin="0,6,0,0"
                                IsChecked="{Binding AppSettings.IsRandomCycling, Mode=TwoWay}">
                                Pick them in a random order rather than top to bottom
                            </CheckBox>

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Move to the next one every" />
                                <TextBox
                                    x:Name="SwitchStatusInterval"
                                    Width="auto"
                                    Height="auto"
                                    Padding="5,0"
                                    HorizontalAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding AppSettings.SwitchStatusInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="seconds" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel Margin="5">
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="When you go quiet" />

                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Stop moving for long enough and MagicChatbox swaps your status for an away message, so nobody has to guess whether you are there." />

                        <CheckBox
                            x:Name="EnableAFKDetectCheck"
                            Margin="4,5,4,4"
                            IsChecked="{Binding Afk.Settings.EnableAfkDetection, Mode=TwoWay}">
                            Show an away message when I stop moving
                        </CheckBox>

                        <CheckBox Margin="4,5,4,4" IsChecked="{Binding Afk.Settings.ActivateInVR, Mode=TwoWay}">
                            Do this while I am in VR too
                        </CheckBox>

                        <StackPanel Margin="5" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Count me as away after" />
                            <TextBox
                                x:Name="TimeoutTime"
                                Width="auto"
                                Height="auto"
                                Padding="5,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Afk.Settings.AfkTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextAlignment="Center" />

                            <TextBlock
                                Margin="4,0,2,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="seconds" />

                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="{Binding Afk.FriendlyTimeoutTime, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <CheckBox Margin="4,5,4,4" IsChecked="{Binding Afk.Settings.UseSmallLettersForDuration, Mode=TwoWay}">
                            Write the h, m and s small, like 12ᵐ
                        </CheckBox>

                        <!--  ====================================================================
                              AFK STYLES. A style is a whole way of saying you are away - prefix,
                              wording, whether the clock shows - saved under a name and switchable
                              from the side panel. What used to be four loose fields here is now
                              one of these, so nothing was lost, it just got a name.
                              ====================================================================  -->
                        <TextBlock
                            Margin="2,18,0,5"
                            Style="{StaticResource OptionSubsectionHeaderStyle}"
                            Text="Ways of saying you are away" />

                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Build as many as you like and switch between them from the side panel. Type \n where you want a new line." />

                        <StackPanel Margin="4,0,4,6" Orientation="Horizontal">
                            <ComboBox
                                Width="190"
                                Height="26"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Name"
                                IsSynchronizedWithCurrentItem="False"
                                ItemsSource="{Binding AfkStyles.Styles}"
                                SelectedItem="{Binding AfkStyles.SelectedStyle, Mode=TwoWay}"
                                Style="{StaticResource FlatComboBoxStyle}" />

                            <Button
                                Height="26"
                                Margin="6,0,0,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.AddStyleCommand}"
                                Content="Duplicate"
                                Style="{DynamicResource Status_Button_style}"
                                ToolTip="Start a new one from the one you have selected" />

                            <Button
                                Height="26"
                                Margin="6,0,0,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.DeleteStyleCommand}"
                                Content="Delete"
                                Style="{DynamicResource Status_Button_style}"
                                ToolTip="Delete this one. The ones that ship with MagicChatbox cannot be deleted." />

                            <Button
                                Height="26"
                                Margin="16,0,0,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ExportStylesCommand}"
                                Content="Save to a file"
                                Style="{DynamicResource Status_Button_style}"
                                ToolTip="Save the ones you made. The ones that ship with the app are not included - they are already in it." />

                            <Button
                                Height="26"
                                Margin="6,0,0,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ImportStylesCommand}"
                                Content="Load from a file"
                                Style="{DynamicResource Status_Button_style}"
                                ToolTip="Load ones from a file. They are added to yours, never on top of them." />
                        </StackPanel>

                        <TextBlock
                            Margin="4,0,4,6"
                            Foreground="{StaticResource StatusWarningBrush}"
                            Text="{Binding AfkStyles.EditHint}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource OptionHelpTextStyle}" TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AfkStyles.EditHint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Margin="4,4,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Call it" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,6"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeCompact}"
                                IsReadOnly="{Binding AfkStyles.CanEditSelected, Converter={StaticResource InvertBooleanConverter}}"
                                Text="{Binding AfkStyles.SelectedStyle.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                VerticalAlignment="Center"
                                IsChecked="{Binding AfkStyles.SelectedStyle.ShowPrefix, Mode=TwoWay}"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}">
                                Starts with
                            </CheckBox>
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,6"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeCompact}"
                                IsEnabled="{Binding AfkStyles.SelectedStyle.ShowPrefix}"
                                IsReadOnly="{Binding AfkStyles.CanEditSelected, Converter={StaticResource InvertBooleanConverter}}"
                                Text="{Binding AfkStyles.SelectedStyle.Prefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                VerticalAlignment="Center"
                                IsChecked="{Binding AfkStyles.SelectedStyle.ShowTime, Mode=TwoWay}"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                ToolTip="Show how long you have been away">
                                With the time
                            </CheckBox>
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,0,0,6"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeCompact}"
                                IsEnabled="{Binding AfkStyles.SelectedStyle.ShowTime}"
                                IsReadOnly="{Binding AfkStyles.CanEditSelected, Converter={StaticResource InvertBooleanConverter}}"
                                Text="{Binding AfkStyles.SelectedStyle.MessageWithTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="The time is added straight after this text, so end it with a space." />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Without the time" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,0,0,6"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeCompact}"
                                IsReadOnly="{Binding AfkStyles.CanEditSelected, Converter={StaticResource InvertBooleanConverter}}"
                                Text="{Binding AfkStyles.SelectedStyle.MessageWithoutTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Used when the time is off, and for the first moments before there is a time to show." />
                        </Grid>

                        <!--  Same Render() the chatbox line comes from, so this cannot drift from reality.  -->
                        <controls:SegmentPreview Caption="What people will see" Line="{Binding AfkStyles.PreviewLine}" />

                        <!--  ====================================================================
                              THE COMPOSER. Fancy text is the whole appeal of an AFK line and there
                              is no way to type it on a keyboard, so the app types it for you and
                              drops it straight into the field rather than sending you to a website
                              and back through the clipboard.
                              ====================================================================  -->
                        <TextBlock
                            Margin="2,16,0,3"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Make fancy text" />
                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Type normally, pick a look, then drop it into one of the boxes above. Letters with no fancy version are left as they are." />

                        <StackPanel Margin="4,0,4,0" Orientation="Horizontal">
                            <TextBox
                                Width="220"
                                Padding="5,3"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeCompact}"
                                Text="{Binding AfkStyles.ComposerInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Width="130"
                                Height="26"
                                Margin="6,0,0,0"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding AfkStyles.TextStyles}"
                                SelectedItem="{Binding AfkStyles.ComposerStyle, Mode=TwoWay}"
                                Style="{StaticResource FlatComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!--  Not a chatbox line of its own, so this keeps its own cost line: what it
                              has to say - that fancy letters cost two each - the n/144 chip cannot.  -->
                        <Border
                            Margin="4,6,4,0"
                            Padding="10,8"
                            Background="{StaticResource SurfaceButtonDarkBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontFamily="{StaticResource FontSecondary}"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Text="{Binding AfkStyles.ComposerOutput}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="{Binding AfkStyles.ComposerCost}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="4,6,4,0" Orientation="Horizontal">
                            <Button
                                Height="26"
                                Margin="0,0,6,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ApplyComposerToCommand}"
                                CommandParameter="WithTime"
                                Content="Use it with the time"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                Style="{DynamicResource Status_Button_style}" />
                            <Button
                                Height="26"
                                Margin="0,0,6,0"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ApplyComposerToCommand}"
                                CommandParameter="WithoutTime"
                                Content="Use it without the time"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                Style="{DynamicResource Status_Button_style}" />
                            <Button
                                Height="26"
                                Padding="10,0"
                                Command="{Binding AfkStyles.ApplyComposerToCommand}"
                                CommandParameter="Prefix"
                                Content="Use it at the start"
                                IsEnabled="{Binding AfkStyles.CanEditSelected}"
                                Style="{DynamicResource Status_Button_style}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding AppState.BussyBoysMode, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">

                            <TextBlock
                                Margin="2,18,0,5"
                                Style="{StaticResource OptionSubsectionHeaderStyle}"
                                Text="Bussy Boys" />

                            <CheckBox Margin="4,5,4,4" IsChecked="{Binding TimeSettings.BussyBoysMultiMODE, Mode=TwoWay}">
                                Show my status and my away message at the same time
                            </CheckBox>

                            <CheckBox Margin="4,5,4,4" IsChecked="{Binding TimeSettings.BussyBoysDateEnable, Mode=TwoWay}">
                                Count up from a date of my choosing ↴
                            </CheckBox>

                            <DatePicker
                                Width="250"
                                Margin="3,5,4,4"
                                HorizontalAlignment="Left"
                                BorderThickness="0"
                                IsTodayHighlighted="True"
                                Opacity="0.5"
                                SelectedDate="{Binding TimeSettings.BussyBoysDate, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>

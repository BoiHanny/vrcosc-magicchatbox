<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.VrPerformanceSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:VrPerformanceSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_VrPerformance, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="VR performance options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="34,10,0,0"
            d:Visibility="Visible"
            Visibility="{Binding AppSettings.Settings_VrPerformance, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What goes in your chatbox" />

                    <!--  Both states, because "only when frames drop" is otherwise invisible until it happens.  -->
                    <controls:SegmentPreview Caption="While everything is running smoothly" Line="{Binding HealthyPreview}" />
                    <controls:SegmentPreview Caption="While your headset is struggling" Line="{Binding DegradedPreview}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What to show" />

                    <WrapPanel Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Frame rate"
                            IsChecked="{Binding Settings.ShowFps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Headset refresh rate"
                            IsChecked="{Binding Settings.ShowTargetHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Frames faked to keep up %"
                            IsChecked="{Binding Settings.ShowReprojection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Dropped frames"
                            IsChecked="{Binding Settings.ShowDroppedFrames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Motion smoothing"
                            IsChecked="{Binding Settings.ShowMotionSmoothing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Time the game takes to draw a frame"
                            IsChecked="{Binding Settings.ShowAppGpuMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Time SteamVR takes on top"
                            IsChecked="{Binding Settings.ShowCompositorGpuMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="How full each frame is %"
                            IsChecked="{Binding Settings.ShowHeadroom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Time your PC takes to prepare a frame"
                            IsChecked="{Binding Settings.ShowCpuTiming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="&quot;How full each frame is&quot; counts up, not down: it is the share of the frame budget already spent, so a higher number means less room left. Around 65% is comfortable and anything near 100% is about to drop frames." />

                    <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="The chatbox holds 144 characters and every integration shares them. Turning all of these on costs roughly 55-70 of them, which pushes lower-priority integrations off the line." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="When to show it" />

                    <ComboBox
                        Width="220"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding DisplayModes}"
                        SelectedItem="{Binding Settings.DisplayMode, Mode=TwoWay}"
                        Style="{StaticResource DarkComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="'Only when frames drop' costs no characters while everything is running smoothly, so it never pushes another integration off the line unless something is actually wrong." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What counts as struggling" />

                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="240"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Frames faked to keep up, at or above (%)" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.DegradedReprojectionPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="240"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Dropped frames per minute" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.DegradedDroppedPerMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="240"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Frame rate below (% of the headset's)" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.DegradedFpsPercentOfTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="240"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Seconds running smoothly before it clears" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.DegradedHysteresisSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="The last one stops the warning flickering on and off when a value sits right on the line." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="How it is written" />

                    <CheckBox
                        Margin="0,2"
                        Content="Use icons instead of words"
                        IsChecked="{Binding Settings.UseEmojisForVrPerf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Margin="0,2"
                        Content="Small raised labels - ᶠᵖˢ instead of FPS"
                        IsChecked="{Binding Settings.UseSuperscriptUnits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Margin="0,2"
                        Content="Round the numbers off (no decimals)"
                        IsChecked="{Binding Settings.RemoveNumberTrailing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Margin="0,4" Orientation="Horizontal">
                        <TextBlock
                            Width="240"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="What goes between the values" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.StatsSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Status" />

                    <TextBlock
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="{Binding StatusText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

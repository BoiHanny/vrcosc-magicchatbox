<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.VrPerformanceSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:VrPerformanceSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                FontSize="15"
                FontWeight="Bold"
                Foreground="{StaticResource TextSectionHeaderBrush}"
                IsChecked="{Binding AppSettings.Settings_VrPerformance, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="VR performance options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>

        <StackPanel
            Grid.Row="1"
            Margin="34,10,0,0"
            d:Visibility="Visible"
            Visibility="{Binding AppSettings.Settings_VrPerformance, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontFamily="/Fonts/#Comfortaa"
                        FontSize="13"
                        Foreground="{StaticResource TextSectionHeaderBrush}"
                        Text="Preview" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Healthy" />
                        <Border
                            Grid.Column="1"
                            Padding="8,4"
                            Background="{StaticResource AccentDeepPurpleBrush}"
                            CornerRadius="4">
                            <TextBlock
                                FontFamily="/Fonts/#Comfortaa"
                                FontSize="15"
                                Foreground="White"
                                Text="{Binding HealthyPreview}"
                                TextWrapping="Wrap" />
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{Binding HealthyPreviewLength}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Struggling" />
                        <Border
                            Grid.Column="1"
                            Padding="8,4"
                            Background="{StaticResource AccentDeepPurpleBrush}"
                            CornerRadius="4">
                            <TextBlock
                                FontFamily="/Fonts/#Comfortaa"
                                FontSize="15"
                                Foreground="White"
                                Text="{Binding DegradedPreview}"
                                TextWrapping="Wrap" />
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="{Binding DegradedPreviewLength}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontFamily="/Fonts/#Comfortaa"
                        FontSize="13"
                        Foreground="{StaticResource TextSectionHeaderBrush}"
                        Text="What to show" />

                    <WrapPanel Orientation="Horizontal">
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Frame rate"
                            IsChecked="{Binding Settings.ShowFps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Target Hz"
                            IsChecked="{Binding Settings.ShowTargetHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Reprojection %"
                            IsChecked="{Binding Settings.ShowReprojection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Dropped frames"
                            IsChecked="{Binding Settings.ShowDroppedFrames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Motion smoothing"
                            IsChecked="{Binding Settings.ShowMotionSmoothing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="GPU frame time"
                            IsChecked="{Binding Settings.ShowAppGpuMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Compositor time"
                            IsChecked="{Binding Settings.ShowCompositorGpuMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="Frame budget %"
                            IsChecked="{Binding Settings.ShowHeadroom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,0,12,4"
                            Content="CPU frame time"
                            IsChecked="{Binding Settings.ShowCpuTiming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,6,0,0"
                        FontFamily="/Fonts/#Albert Sans"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="The chatbox is limited to 144 characters and shared with every other integration. Turning all of these on costs roughly 55–70 of them, which pushes lower-priority integrations out."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontFamily="/Fonts/#Comfortaa"
                        FontSize="13"
                        Foreground="{StaticResource TextSectionHeaderBrush}"
                        Text="When to show it" />

                    <ComboBox
                        Width="220"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding DisplayModes}"
                        SelectedItem="{Binding Settings.DisplayMode, Mode=TwoWay}"
                        Style="{StaticResource DarkComboBoxStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock
                        Margin="0,6,0,0"
                        FontFamily="/Fonts/#Albert Sans"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="'Only when frames drop' costs no characters while performance is healthy, so it never pushes another integration out unless something is actually wrong."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontFamily="/Fonts/#Comfortaa"
                        FontSize="13"
                        Foreground="{StaticResource TextSectionHeaderBrush}"
                        Text="What counts as a problem" />

                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="200"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Reprojection at or above (%)" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.DegradedReprojectionPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="200"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Dropped frames per minute" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.DegradedDroppedPerMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="200"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Frame rate below (% of target)" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.DegradedFpsPercentOfTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="200"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Seconds healthy before clearing" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.DegradedHysteresisSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,6,0,0"
                        FontFamily="/Fonts/#Albert Sans"
                        FontSize="11"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="The last one stops the warning flickering on and off when a value sits right on a threshold."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontFamily="/Fonts/#Comfortaa"
                        FontSize="13"
                        Foreground="{StaticResource TextSectionHeaderBrush}"
                        Text="Formatting" />

                    <CheckBox
                        Margin="0,2"
                        Content="Use emoji instead of text labels"
                        IsChecked="{Binding Settings.UseEmojisForVrPerf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Margin="0,2"
                        Content="Small units and labels (ᶠᵖˢ  ʳᵉᵖʳᵒʲ  ᵐˢ)"
                        IsChecked="{Binding Settings.UseSuperscriptUnits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Margin="0,2"
                        Content="Round numbers (drop decimals)"
                        IsChecked="{Binding Settings.RemoveNumberTrailing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Margin="0,4" Orientation="Horizontal">
                        <TextBlock
                            Width="200"
                            VerticalAlignment="Center"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Separator between values" />
                        <TextBox
                            Width="60"
                            Text="{Binding Settings.StatsSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontFamily="/Fonts/#Comfortaa"
                        FontSize="13"
                        Foreground="{StaticResource TextSectionHeaderBrush}"
                        Text="Status" />

                    <TextBlock
                        FontFamily="/Fonts/#Albert Sans"
                        FontSize="12"
                        Foreground="{StaticResource BorderMutedBrush}"
                        Text="{Binding StatusText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

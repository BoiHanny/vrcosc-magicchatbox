<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.VoicemodSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:VoicemodSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="VoicemodOptionButton"
            BasedOn="{StaticResource Status_Button_style}"
            TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ToggleButton
                x:Name="VoicemodSectionToggle"
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_Voicemod, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Voicemod options"
                TextOptions.TextRenderingMode="ClearType" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_Voicemod, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>
                <Border Style="{StaticResource OptionCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Connection" />
                            <TextBlock
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeSecondary}"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="{Binding Display.StatusText}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="{Binding ConnectionDetails}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="Turn Voicemod on or off from its tile on the Integrations page."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Command="{Binding ReconnectCommand}"
                                Content="Reconnect"
                                Style="{StaticResource VoicemodOptionButton}" />
                            <Button
                                Command="{Binding RefreshCommand}"
                                Content="Refresh"
                                IsEnabled="{Binding CanControl}"
                                Style="{StaticResource VoicemodOptionButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Padding="8"
                    Background="{StaticResource StatusWarningBackgroundBrush}"
                    BorderBrush="{StaticResource StatusWarningBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="0,5"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{StaticResource StatusWarningBrush}"
                        Text="{Binding Display.ErrorText}"
                        TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Client key" />
                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Save the client key Voicemod gave you for this Windows user. It is stored with Windows encryption; a saved key takes priority over a build-injected key."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--
                                No Height override. The themed minimum leaves room for the masking
                                dots; forcing it down to button height clipped them.
                            -->
                            <PasswordBox
                                x:Name="VoicemodClientKeyInput"
                                Margin="0,0,6,0"
                                VerticalContentAlignment="Center"
                                ToolTip="Paste your Voicemod client key" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="SaveLocalClientKey_Click"
                                Content="Save key"
                                Style="{StaticResource VoicemodOptionButton}" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{Binding ClearLocalClientKeyCommand}"
                                Content="Clear local"
                                IsEnabled="{Binding HasSavedLocalClientKey}"
                                Style="{StaticResource VoicemodOptionButton}" />
                        </Grid>
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="{Binding LocalClientKeyStatus}" />
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,0,0,5"
                    Padding="8"
                    Background="{StaticResource StatusInfoBackgroundBrush}"
                    BorderBrush="{StaticResource AccentTealBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{Binding NeedsPermission, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Allow local Voicemod control in Privacy &amp; permissions before connecting."
                            TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Command="{Binding OpenPrivacyCommand}"
                            Content="Open privacy"
                            Style="{StaticResource VoicemodOptionButton}" />
                    </Grid>
                </Border>

                <Border
                    Margin="0,0,0,5"
                    Padding="8"
                    Background="{StaticResource StatusInfoBackgroundBrush}"
                    BorderBrush="{StaticResource AccentTealBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Visibility="{Binding MissingClientKey, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="No Voicemod client key is available. Save one above or inject VoicemodClientKey when you build."
                        TextWrapping="Wrap" />
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Features" />
                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Switch off the parts you never use. MagicChatbox then stops asking Voicemod about them entirely, so a soundboard-only setup never loads voices."
                            TextWrapping="Wrap" />
                        <CheckBox
                            Margin="0,7,0,0"
                            IsChecked="{Binding Settings.VoiceControlEnabled, Mode=TwoWay}">
                            Voice changer — pick voices, tune parameters, hear myself, background effects
                        </CheckBox>
                        <CheckBox
                            Margin="0,4,0,0"
                            IsChecked="{Binding Settings.SoundboardControlEnabled, Mode=TwoWay}">
                            Soundboard — browse boards, play and stop sounds, soundboard monitoring
                        </CheckBox>
                        <CheckBox
                            Margin="0,4,0,0"
                            IsChecked="{Binding Settings.MicControlEnabled, Mode=TwoWay}">
                            Mic — mute the Voicemod microphone and hold-to-bleep
                        </CheckBox>
                        <Border
                            Margin="0,7,0,0"
                            Padding="8"
                            Background="{StaticResource StatusWarningBackgroundBrush}"
                            BorderBrush="{StaticResource StatusWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="{Binding Settings.AnyFeatureEnabled, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock
                                FontFamily="{StaticResource FontPrimary}"
                                FontSize="{StaticResource FontSizeCaption}"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Text="Every feature is off, so MagicChatbox stays connected but shows no controls. Switch one back on, or turn the integration off from its tile."
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border
                    Style="{StaticResource OptionCardStyle}"
                    Visibility="{Binding Settings.SoundboardControlEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Soundboard layout" />
                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="How the soundboard on the Integrations page is laid out. With a large library, more per page means less clicking and a taller panel."
                            TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Sounds per page" />
                            <Slider
                                Grid.Column="1"
                                IsSnapToTickEnabled="True"
                                Maximum="96"
                                Minimum="8"
                                SmallChange="8"
                                Style="{StaticResource CustomSlider}"
                                TickFrequency="8"
                                Value="{Binding Settings.SoundsPerPage, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="{Binding Settings.SoundsPerPage}" />
                        </Grid>
                        <CheckBox
                            Margin="0,8,0,0"
                            IsChecked="{Binding Settings.CompactSoundBlobs, Mode=TwoWay}">
                            Compact sounds — smaller tiles, more of them on screen
                        </CheckBox>
                        <CheckBox
                            Margin="0,4,0,0"
                            IsChecked="{Binding Settings.ShowSoundboardStrip, Mode=TwoWay}">
                            Show the soundboard picker strip
                        </CheckBox>
                        <CheckBox
                            Margin="0,4,0,0"
                            IsChecked="{Binding Settings.ShowSoundThumbnails, Mode=TwoWay}">
                            Show each sound's thumbnail
                        </CheckBox>
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Thumbnails are fetched from Voicemod one page at a time. Turning them off keeps the sounds as plain labels and asks Voicemod for nothing extra."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Hiding the strip leaves search, pinned sounds and the page controls, which is enough if you only ever use one board."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource OptionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Chatbox output" />
                        <TextBlock
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="When you start a sound from MagicChatbox, show its name in the VRChat chatbox using the same format as Soundpad." />
                        <CheckBox
                            IsChecked="{Binding Settings.AnnounceSoundboardToChat, Mode=TwoWay}"
                            IsEnabled="{Binding Settings.SoundboardControlEnabled}">
                            Announce soundboard effects in chat
                        </CheckBox>
                        <Grid Margin="0,8,0,0" IsEnabled="{Binding Settings.AnnounceSoundboardToChat}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Show for" />
                            <Slider
                                Grid.Column="1"
                                Maximum="15"
                                Minimum="2"
                                SmallChange="1"
                                Style="{StaticResource CustomSlider}"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding Settings.SoundAnnouncementDurationSeconds, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="{Binding Settings.SoundAnnouncementDurationSeconds, StringFormat={}{0} sec}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionFieldLabelStyle}"
                                Text="Show in" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ToggleButton
                                    IsChecked="{Binding IntegrationSettings.IntgrVoicemod_DESKTOP, Mode=TwoWay}"
                                    Style="{StaticResource RouteChipDesktop}" />
                                <ToggleButton
                                    IsChecked="{Binding IntegrationSettings.IntgrVoicemod_VR, Mode=TwoWay}"
                                    Style="{StaticResource RouteChipVr}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox
                            Margin="0,10,0,0"
                            IsChecked="{Binding Settings.AnnounceVoiceToChat, Mode=TwoWay}"
                            IsEnabled="{Binding Settings.VoiceControlEnabled}">
                            Show the voice you are using in chat
                        </CheckBox>
                        <TextBlock
                            Margin="0,2,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Stays in the chatbox while a voice is active, and disappears when you go back to no effect."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,7,0,0"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="Preview: 🎶 'Sound name'   ·   🎙️ 'Voice name'" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.TwitchSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:TwitchSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_Twitch, Mode=TwoWay}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Twitch options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>
        <Grid
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            Visibility="{Binding AppSettings.Settings_Twitch, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel>
                <Button
                    x:Name="SetupTwitch"
                    Width="210"
                    Height="34"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    Click="SetupTwitch_Click"
                    Content="⚙ Setup Twitch Integration"
                    Style="{StaticResource Status_Button_style}" />
                <StackPanel
                    Width="auto"
                    Margin="0,0,0,15"
                    HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Channel name" />
                    <TextBox
                        x:Name="TwitchChannelName"
                        Width="200"
                        Margin="0,3,0,0"
                        Padding="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        FontSize="{StaticResource FontSizeBody}"
                        Text="{Binding Modules.Twitch.Settings.ChannelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Client ID" />
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <ToggleButton
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceButtonPanelBrush}"
                            BorderBrush="{StaticResource BorderAccentPurpleBrush}"
                            IsChecked="{Binding Modules.Twitch.Settings.ClientIdEditing, Mode=TwoWay}"
                            Style="{DynamicResource Editbutton}"
                            ToolTip="Edit client ID">
                            <Image
                                Width="19"
                                Height="19"
                                Source="/Img/Icons/admin.png" />
                        </ToggleButton>
                        <Grid
                            Width="260"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left">
                            <TextBox
                                x:Name="TwitchClientIdPreview"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                IsHitTestVisible="False"
                                IsReadOnly="True"
                                Text="{Binding Modules.Twitch.Settings.ClientId, Converter={StaticResource MaskedWeatherCityConverter}}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TileRightTextBox}" TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Modules.Twitch.Settings.ClientIdEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox
                                x:Name="TwitchClientIdEditor"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Modules.Twitch.Settings.ClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TileRightTextBox}" TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Modules.Twitch.Settings.ClientIdEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Access token" />
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <ToggleButton
                            Width="26"
                            Height="26"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource SurfaceButtonPanelBrush}"
                            BorderBrush="{StaticResource BorderAccentPurpleBrush}"
                            IsChecked="{Binding Modules.Twitch.Settings.AccessTokenEditing, Mode=TwoWay}"
                            Style="{DynamicResource Editbutton}"
                            ToolTip="Edit access token">
                            <Image
                                Width="19"
                                Height="19"
                                Source="/Img/Icons/admin.png" />
                        </ToggleButton>
                        <Grid Width="360" HorizontalAlignment="Left">
                            <TextBox
                                x:Name="TwitchAccessTokenPreview"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                IsHitTestVisible="False"
                                IsReadOnly="True"
                                Text="{Binding Modules.Twitch.Settings.AccessToken, Converter={StaticResource MaskedWeatherCityConverter}}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TileRightTextBox}" TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Modules.Twitch.Settings.AccessTokenEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBox
                                x:Name="TwitchAccessTokenEditor"
                                Padding="5,0,0,0"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Modules.Twitch.Settings.AccessToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.Style>
                                    <Style BasedOn="{StaticResource TileRightTextBox}" TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Modules.Twitch.Settings.AccessTokenEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Twitch has to let MagicChatbox read your channel. Press '⚙ Setup Twitch Integration' above and it fills both boxes in for you." />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Ask Twitch for new numbers every (seconds)" />
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <TextBox
                            x:Name="TwitchRefreshInterval"
                            Width="40"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding Modules.Twitch.Settings.UpdateIntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Name="TwitchSyncNow"
                            Width="60"
                            Height="26"
                            Margin="6,0,0,0"
                            Padding="6,0,6,0"
                            Command="{Binding TwitchSyncCommand}"
                            Style="{StaticResource Status_Button_style}">
                            <TextBlock FontSize="{StaticResource FontSizeCaption}" Text="Sync" />
                        </Button>
                        <TextBlock
                            Margin="8,3,0,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeSecondary}"
                            Foreground="{StaticResource TextLabelBrush}"
                            Text="{Binding Modules.Twitch.LastSyncDisplay}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,2,0,0"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeSecondary}"
                        Foreground="{StaticResource TextLabelBrush}"
                        Text="{Binding Modules.Twitch.StatusMessage}" />

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource OptionSubsectionHeaderStyle}"
                        Text="What goes in the chatbox" />
                    <TextBlock
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="The two boxes below show the finished line, built from stand-in numbers so you can see the effect of every switch before you ever go live."
                        TextWrapping="Wrap" />

                    <!--
                        Twitch is one of two sections that asks the user to author a format string.
                        Both states are shown because the offline one is easy to leave empty by
                        accident and then wonder where the chatbox went.
                    -->
                    <controls:SegmentPreview
                        Width="480"
                        HorizontalAlignment="Left"
                        Caption="While you are live"
                        Line="{Binding LivePreview}" />
                    <controls:SegmentPreview
                        Width="480"
                        HorizontalAlignment="Left"
                        Caption="After the stream ends — empty means Twitch shows nothing"
                        Line="{Binding OfflinePreview}" />

                    <CheckBox
                        x:Name="TwitchUseSmallText_checkbox"
                        Margin="0,10,0,0"
                        IsChecked="{Binding Modules.Twitch.Settings.UseSmallText, Mode=TwoWay}">
                        Small raised labels — ᵛⁱᵉʷᵉʳˢ instead of viewers
                    </CheckBox>
                    <CheckBox
                        x:Name="TwitchShowLiveIndicator_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding Modules.Twitch.Settings.ShowLiveIndicator, Mode=TwoWay}">
                        Say that you are live
                    </CheckBox>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShowLiveIndicator, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Word to use" />
                        <TextBox
                            x:Name="TwitchLivePrefix"
                            Width="120"
                            Margin="0,3,0,0"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding Modules.Twitch.Settings.LivePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox
                        x:Name="TwitchShowGameName_checkbox"
                        Margin="0,6,0,6"
                        IsChecked="{Binding Modules.Twitch.Settings.ShowGameName, Mode=TwoWay}">
                        Show what you are playing
                    </CheckBox>
                    <StackPanel Margin="0,0,0,6" Visibility="{Binding Modules.Twitch.Settings.ShowGameName, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Word before the game" />
                        <TextBox
                            x:Name="TwitchGamePrefix"
                            Width="120"
                            Margin="0,3,0,0"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding Modules.Twitch.Settings.GamePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox
                        x:Name="TwitchShowViewerCount_checkbox"
                        Margin="0,0,0,0"
                        IsChecked="{Binding Modules.Twitch.Settings.ShowViewerCount, Mode=TwoWay}">
                        Show how many people are watching
                    </CheckBox>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShowViewerCount, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <CheckBox
                            x:Name="TwitchShowViewerLabel_checkbox"
                            Margin="0,0,0,0"
                            IsChecked="{Binding Modules.Twitch.Settings.ShowViewerLabel, Mode=TwoWay}">
                            Put a word in front of that number
                        </CheckBox>
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShowViewerLabel, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Word before the viewer count" />
                            <TextBox
                                x:Name="TwitchViewerLabel"
                                Width="120"
                                Margin="0,3,0,0"
                                Padding="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Modules.Twitch.Settings.ViewerLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="TwitchViewerCountCompact_checkbox"
                            Margin="0,6,0,0"
                            IsChecked="{Binding Modules.Twitch.Settings.ViewerCountCompact, Mode=TwoWay}">
                            Shorten big viewer numbers — 1234 becomes 1.23K
                        </CheckBox>
                    </StackPanel>
                    <CheckBox
                        x:Name="TwitchShowFollowerCount_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding Modules.Twitch.Settings.ShowFollowerCount, Mode=TwoWay}">
                        Show your follower total
                    </CheckBox>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShowFollowerCount, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <CheckBox
                            x:Name="TwitchShowFollowerLabel_checkbox"
                            Margin="0,0,0,0"
                            IsChecked="{Binding Modules.Twitch.Settings.ShowFollowerLabel, Mode=TwoWay}">
                            Put a word in front of that number
                        </CheckBox>
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShowFollowerLabel, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Word before the follower count" />
                            <TextBox
                                x:Name="TwitchFollowerLabel"
                                Width="120"
                                Margin="0,3,0,0"
                                Padding="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                FontSize="{StaticResource FontSizeBody}"
                                Text="{Binding Modules.Twitch.Settings.FollowerLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="TwitchFollowerCountCompact_checkbox"
                            Margin="0,6,0,0"
                            IsChecked="{Binding Modules.Twitch.Settings.FollowerCountCompact, Mode=TwoWay}">
                            Shorten big follower numbers — 8420 becomes 8.42K
                        </CheckBox>
                    </StackPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="{StaticResource FontSizeSecondary}"
                        Foreground="{StaticResource StatusWarningBrush}"
                        Text="{Binding Modules.Twitch.FollowerScopeWarning}"
                        TextWrapping="Wrap"
                        Visibility="{Binding Modules.Twitch.FollowerScopeWarning, Converter={StaticResource CountToVisibilityConverter}}" />
                    <CheckBox
                        x:Name="TwitchShowStreamTitle_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding Modules.Twitch.Settings.ShowStreamTitle, Mode=TwoWay}">
                        Show your stream title
                    </CheckBox>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShowStreamTitle, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Word before the title" />
                        <TextBox
                            x:Name="TwitchStreamTitlePrefix"
                            Width="120"
                            Margin="0,3,0,0"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding Modules.Twitch.Settings.StreamTitlePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox
                        x:Name="TwitchShowChannelName_checkbox"
                        Margin="0,6,0,0"
                        IsChecked="{Binding Modules.Twitch.Settings.ShowChannelName, Mode=TwoWay}">
                        Show your channel name
                    </CheckBox>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShowChannelName, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Word before the channel name" />
                        <TextBox
                            x:Name="TwitchChannelPrefix"
                            Width="120"
                            Margin="0,3,0,0"
                            Padding="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding Modules.Twitch.Settings.ChannelPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="What sits between each part"
                        Visibility="{Binding Modules.Twitch.Settings.TemplateHasValue, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        x:Name="TwitchSeparator"
                        Width="120"
                        Margin="0,3,0,0"
                        Padding="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        FontSize="{StaticResource FontSizeBody}"
                        Text="{Binding Modules.Twitch.Settings.Separator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding Modules.Twitch.Settings.TemplateHasValue, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Your own layout below decides the spacing, so this box is not used while it has anything in it."
                        Visibility="{Binding Modules.Twitch.Settings.TemplateHasValue, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Write your own layout (optional)" />
                    <TextBox
                        x:Name="TwitchTemplate"
                        Width="480"
                        Margin="0,3,0,0"
                        Padding="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        FontSize="{StaticResource FontSizeBody}"
                        Text="{Binding Modules.Twitch.Settings.Template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Leave this empty and the switches above build the line for you. To arrange it yourself, type any of these where you want that piece to appear — the preview updates as you type."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="2,0,0,6"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="{}{live} the live word · {game} the game · {gameWithLabel} the game with its word · {viewers} viewers with their word · {viewerCount} just the number · {viewerLabel} just the word · {followers} followers with their word · {followerCount} just the number · {followerLabel} just the word · {title} the stream title · {titleWithLabel} the title with its word · {channel} your channel · {channelWithLabel} your channel with its word · {status} the words live or offline · \n starts a new line"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource OptionFieldLabelStyle}"
                        Text="Show this when the stream is over" />
                    <TextBox
                        x:Name="TwitchOfflineMessage"
                        Width="240"
                        Margin="0,3,0,0"
                        Padding="5,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        FontSize="{StaticResource FontSizeBody}"
                        Text="{Binding Modules.Twitch.Settings.OfflineMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Leave it empty to drop Twitch out of the chatbox entirely once you stop streaming." />
                    <TextBlock
                        Margin="0,14,0,0"
                        Style="{StaticResource OptionSubsectionHeaderStyle}"
                        Text="Post to your Twitch chat" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="These two send a message to your own Twitch chat. They do not go in the VRChat chatbox."
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,8,0,0"
                        CornerRadius="6"
                        Style="{StaticResource OptionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{Binding Modules.Twitch.Settings.AnnouncementColor, Converter={StaticResource TwitchAnnouncementColorToBrushConverter}}"
                                CornerRadius="3" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Announcements" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="A highlighted message in your Twitch chat. Twitch only allows it if you gave MagicChatbox permission to send announcements during setup."
                                    TextWrapping="Wrap" />
                                <CheckBox
                                    x:Name="TwitchAnnouncementsEnabled_checkbox"
                                    Margin="0,8,0,0"
                                    IsChecked="{Binding Modules.Twitch.Settings.AnnouncementsEnabled, Mode=TwoWay}">
                                    Let me send announcements
                                </CheckBox>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.AnnouncementsEnabled, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Message" />
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="TwitchAnnouncementMessage"
                                            Grid.Column="0"
                                            Padding="5,0,0,0"
                                            VerticalContentAlignment="Center"
                                            FontSize="{StaticResource FontSizeBody}"
                                            Text="{Binding Modules.Twitch.Settings.AnnouncementMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            x:Name="TwitchSendAnnouncement"
                                            Grid.Column="1"
                                            Width="60"
                                            Height="26"
                                            Margin="6,0,0,0"
                                            Padding="6,0,6,0"
                                            Command="{Binding Modules.Twitch.SendAnnouncementCommand}"
                                            Style="{StaticResource Status_Button_style}">
                                            <TextBlock FontSize="{StaticResource FontSizeCaption}" Text="Send" />
                                        </Button>
                                    </Grid>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Style="{StaticResource OptionFieldLabelStyle}"
                                            Text="Colour" />
                                        <Border
                                            Width="14"
                                            Height="14"
                                            Margin="8,6,0,0"
                                            Background="{Binding Modules.Twitch.Settings.AnnouncementColor, Converter={StaticResource TwitchAnnouncementColorToBrushConverter}}"
                                            CornerRadius="7" />
                                        <ComboBox
                                            Width="160"
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Left"
                                            ItemsSource="{Binding Modules.Twitch.Settings.AvailableAnnouncementColors}"
                                            SelectedItem="{Binding Modules.Twitch.Settings.AnnouncementColor, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border
                                                            Width="10"
                                                            Height="10"
                                                            Margin="0,0,6,0"
                                                            Background="{Binding Converter={StaticResource TwitchAnnouncementColorToBrushConverter}}"
                                                            CornerRadius="5" />
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeSecondary}"
                                        Foreground="{StaticResource TextLabelBrush}"
                                        Text="{Binding Modules.Twitch.AnnouncementStatusMessage}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border
                        Margin="0,8,0,0"
                        CornerRadius="6"
                        Style="{StaticResource OptionCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Background="{Binding Modules.Twitch.Settings.ShoutoutAnnouncementColor, Converter={StaticResource TwitchAnnouncementColorToBrushConverter}}"
                                CornerRadius="3" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Shoutouts" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="Twitch's built-in way of pointing your viewers at another streamer. Twitch only allows it if you gave MagicChatbox permission to send shoutouts during setup."
                                    TextWrapping="Wrap" />
                                <CheckBox
                                    x:Name="TwitchShoutoutsEnabled_checkbox"
                                    Margin="0,8,0,0"
                                    IsChecked="{Binding Modules.Twitch.Settings.ShoutoutsEnabled, Mode=TwoWay}">
                                    Let me send shoutouts
                                </CheckBox>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShoutoutsEnabled, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="Channel to shout out" />
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="TwitchShoutoutTarget"
                                            Grid.Column="0"
                                            Padding="5,0,0,0"
                                            VerticalContentAlignment="Center"
                                            FontSize="{StaticResource FontSizeBody}"
                                            Text="{Binding Modules.Twitch.Settings.ShoutoutTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            x:Name="TwitchSendShoutout"
                                            Grid.Column="1"
                                            Width="60"
                                            Height="26"
                                            Margin="6,0,0,0"
                                            Padding="6,0,6,0"
                                            Command="{Binding Modules.Twitch.SendShoutoutCommand}"
                                            Style="{StaticResource Status_Button_style}">
                                            <TextBlock FontSize="{StaticResource FontSizeCaption}" Text="Send" />
                                        </Button>
                                    </Grid>
                                    <CheckBox
                                        x:Name="TwitchShoutoutAlsoAnnounce_checkbox"
                                        Margin="0,6,0,0"
                                        IsChecked="{Binding Modules.Twitch.Settings.ShoutoutAlsoAnnounce, Mode=TwoWay}">
                                        Post a highlighted message about them too
                                    </CheckBox>
                                    <StackPanel Margin="0,6,0,0" Visibility="{Binding Modules.Twitch.Settings.ShoutoutAlsoAnnounce, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBlock Style="{StaticResource OptionFieldLabelStyle}" Text="What that message says" />
                                        <TextBox
                                            x:Name="TwitchShoutoutAnnouncementTemplate"
                                            Margin="0,3,0,0"
                                            Padding="5,0,0,0"
                                            VerticalContentAlignment="Center"
                                            FontSize="{StaticResource FontSizeBody}"
                                            Text="{Binding Modules.Twitch.Settings.ShoutoutAnnouncementTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource OptionHelpTextStyle}"
                                            Text="Type {user} where their name should go and {url} where their link should go." />
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Style="{StaticResource OptionFieldLabelStyle}"
                                                Text="Colour" />
                                            <Border
                                                Width="14"
                                                Height="14"
                                                Margin="8,6,0,0"
                                                Background="{Binding Modules.Twitch.Settings.ShoutoutAnnouncementColor, Converter={StaticResource TwitchAnnouncementColorToBrushConverter}}"
                                                CornerRadius="7" />
                                            <ComboBox
                                                Width="160"
                                                Margin="8,0,0,0"
                                                HorizontalAlignment="Left"
                                                ItemsSource="{Binding Modules.Twitch.Settings.AvailableAnnouncementColors}"
                                                SelectedItem="{Binding Modules.Twitch.Settings.ShoutoutAnnouncementColor, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border
                                                                Width="10"
                                                                Height="10"
                                                                Margin="0,0,6,0"
                                                                Background="{Binding Converter={StaticResource TwitchAnnouncementColorToBrushConverter}}"
                                                                CornerRadius="5" />
                                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeSecondary}"
                                        Foreground="{StaticResource TextLabelBrush}"
                                        Text="{Binding Modules.Twitch.ShoutoutStatusMessage}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

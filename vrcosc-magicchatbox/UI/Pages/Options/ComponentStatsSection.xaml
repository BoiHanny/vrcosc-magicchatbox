<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Options.ComponentStatsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modules="clr-namespace:vrcosc_magicchatbox.Classes.Modules"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DataContext="{d:DesignInstance Type=sections:ComponentStatsSectionViewModel,
                                     IsDesignTimeCreatable=False}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush SpreadMethod="Pad" StartPoint="1,1" EndPoint="0,0">
                <GradientStop Color="{StaticResource SurfaceGradientStartColor}" />
                <GradientStop Offset="1" Color="{StaticResource SurfaceGradientEndColor}" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid Grid.Row="0">
            <ToggleButton
                Width="Auto"
                Height="30"
                HorizontalAlignment="Left"
                IsChecked="{Binding AppSettings.Settings_ComponentStats, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                Tag="Component stats options"
                TextOptions.TextRenderingMode="ClearType" />
        </Grid>

        <StackPanel
            x:Name="Settings_ComponentStats_Grid"
            Grid.Row="1"
            Height="Auto"
            Margin="34,10,0,0"
            d:Visibility="Visible"
            Visibility="{Binding AppSettings.Settings_ComponentStats, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">

            <!--  Thirty-odd switches below, every one of them shaping this single line. Several of
                  them depend on each other in ways no label can state briefly, so they are shown
                  doing it instead: with icons on, the raised-label switches stop changing the
                  temperature and power readings at all.  -->
            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="What goes in the chatbox" />
                    <TextBlock Style="{StaticResource OptionHelpTextStyle}" Text="Example readings — yours will differ, but the wording, the order and the length will look like this. All four components are shown here; which ones really appear depends on what your machine reports. If the line runs past 144 characters the app shortens it for you, dropping the longest parts first." />
                    <controls:SegmentPreview Line="{Binding PreviewLine}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Everything at once" />

                    <TextBlock
                        Margin="7,2,0,2"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Replaces the words next to the temperature and power readings with icons. An icon is never shrunk, so the 'small raised labels' boxes below stop affecting those readings while this is on." />
                    <CheckBox
                        x:Name="UseEmojisForTempAndPower_checkbox"
                        Margin="5,5"
                        Content="Use icons instead of words — ♨️ 64°C instead of ᵗᵉᵐᵖ 64°C"
                        IsChecked="{Binding StatsManager.Settings.UseEmojisForTempAndPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        Margin="5,8,5,5"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="What goes between the readings" />
                        <TextBox
                            x:Name="StatsSeparatorTextBox"
                            Width="60"
                            MinWidth="20"
                            Margin="5,0"
                            Padding="3,0"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding StatsManager.Settings.StatsSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Leave blank for the default ' ¦ '. Anything longer than eight characters is trimmed — three separators would otherwise eat a fifth of the line." />
                    </StackPanel>

                    <TextBlock
                        Margin="7,8,0,2"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="On a laptop or a machine with two graphics chips, untick this to say which one to read." />
                    <CheckBox
                        x:Name="ComponentStatAutoSelectGPU_checkbox"
                        Margin="5,5"
                        Content="Pick the graphics card automatically"
                        IsChecked="{Binding StatsManager.Settings.AutoSelectGPU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        x:Name="ComponentStatSelectedGPUComboBox"
                        Width="186"
                        Margin="5,5"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding StatsManager.GPUList}"
                        SelectedItem="{Binding StatsManager.Settings.SelectedGPU, Mode=TwoWay}"
                        Visibility="{Binding StatsManager.Settings.AutoSelectGPU, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <!--  Every temperature the app prints is measured in Celsius and converted here, so this
                  card decides the units for the readings above and for the weather line as well,
                  unless the weather section has been given a unit of its own.  -->
            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="Temperature" />

                    <TextBlock
                        Margin="7,2,0,6"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Tick every scale you want to see. Tick two or more and the reading swaps between them on a timer, in the order below; tick a single one and it stays there. The example beside each is the same 64 degree card." />
                    <CheckBox
                        x:Name="TemperatureCelsius_checkbox"
                        Margin="5,3"
                        Content="Celsius — 64.0°C"
                        IsChecked="{Binding StatsManager.Settings.TemperatureCelsius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="TemperatureFahrenheit_checkbox"
                        Margin="5,3"
                        Content="Fahrenheit — 147.2°F"
                        IsChecked="{Binding StatsManager.Settings.TemperatureFahrenheit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="TemperatureKelvin_checkbox"
                        Margin="5,3"
                        Content="Kelvin — 337.2K"
                        IsChecked="{Binding StatsManager.Settings.TemperatureKelvin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Written without a degree sign, because a kelvin is not a degree. It is an amount of hot, counted up from the coldest anything can be." />
                    <CheckBox
                        x:Name="TemperatureRankine_checkbox"
                        Margin="5,3"
                        Content="Rankine — 606.9°R"
                        IsChecked="{Binding StatsManager.Settings.TemperatureRankine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Fahrenheit counted from absolute zero. Chosen by people who wanted Kelvin but could not let go." />
                    <CheckBox
                        x:Name="TemperatureReaumur_checkbox"
                        Margin="5,3"
                        Content="Réaumur — 51.2°Ré"
                        IsChecked="{Binding StatsManager.Settings.TemperatureReaumur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Water freezes at 0 and boils at 80. It was briefly the future, in about 1730." />

                    <StackPanel
                        Margin="5,10,5,2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding StatsManager.Settings.TemperatureRotates, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="Swap to the next scale every" />
                        <TextBox
                            x:Name="TemperatureDisplaySwitchIntervalTextBox"
                            Width="42"
                            Margin="5,0"
                            Padding="3,0"
                            VerticalAlignment="Center"
                            FontSize="{StaticResource FontSizeBody}"
                            Text="{Binding StatsManager.Settings.TemperatureDisplaySwitchInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Seconds. The swap is driven by the clock rather than by a timer of its own, so every reading on the line turns over together." />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionFieldLabelStyle}"
                            Text="seconds" />
                    </StackPanel>

                    <TextBlock
                        Margin="7,10,0,2"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="A second scale in brackets after every temperature, for reading both at once instead of waiting for the swap. It is shrunk along with the unit, so it costs the line about six characters per reading." />
                    <ComboBox
                        x:Name="TemperatureCompanionScaleComboBox"
                        Width="220"
                        Margin="5,4"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding Source={x:Static modules:ComponentStatsSettings.AvailableTemperatureCompanions}}"
                        SelectedItem="{Binding StatsManager.Settings.TemperatureCompanionScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="{Binding ComponentStats.CPUHardwareName, StringFormat='Processor — {0}', UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="CPU_SmallName_checkbox"
                        Margin="5,5"
                        Content="Small raised label — ᶜᵖᵘ instead of CPU:"
                        IsChecked="{Binding ComponentStats.CPU_SmallName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="CPU_NumberTrailingZeros_checkbox"
                        Margin="5,5"
                        Content="Round to whole numbers — 23﹪ instead of 23.4﹪"
                        IsChecked="{Binding ComponentStats.CPU_NumberTrailingZeros, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="CPU_EnableHardwareTitle_checkbox"
                        Margin="5,5"
                        Content="Use the chip's own name instead of 'CPU'"
                        IsChecked="{Binding ComponentStats.CPU_EnableHardwareTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Model names run to thirty characters and never change, so this is the most expensive switch on the page. Watch the counter in the preview." />
                    <StackPanel Margin="5" IsEnabled="{Binding ComponentStats.CPU_EnableHardwareTitle, UpdateSourceTrigger=PropertyChanged}">
                        <CheckBox
                            x:Name="CPU_PrefixHardwareTitle_checkbox"
                            Content="…or a shorter name you choose"
                            IsChecked="{Binding ComponentStats.CPU_PrefixHardwareTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ComponentStats.CPU_PrefixHardwareTitle, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel
                                Margin="0,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Call it" />
                                <TextBox
                                    x:Name="CPUCustomHardwareName"
                                    Width="auto"
                                    MinWidth="50"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ComponentStats.CPUCustomHardwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="{Binding ComponentStats.GPUHardwareName, StringFormat='Graphics card — {0}', UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="GPU_SmallName_checkbox"
                        Margin="5,5"
                        Content="Small raised label — ᵍᵖᵘ instead of GPU:"
                        IsChecked="{Binding ComponentStats.GPU_SmallName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="GPU_NumberTrailingZeros_checkbox"
                        Margin="5,5"
                        Content="Round to whole numbers — 61﹪ instead of 61.7﹪"
                        IsChecked="{Binding ComponentStats.GPU_NumberTrailingZeros, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="GPU_EnableHardwareTitle_checkbox"
                        Margin="5,5"
                        Content="Use the card's own name instead of 'GPU'"
                        IsChecked="{Binding ComponentStats.GPU_EnableHardwareTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Card names are the longest text this readout can print. Watch the counter in the preview." />
                    <StackPanel Margin="5" IsEnabled="{Binding ComponentStats.GPU_EnableHardwareTitle, UpdateSourceTrigger=PropertyChanged}">
                        <CheckBox
                            x:Name="GPU_PrefixHardwareTitle_checkbox"
                            Content="…or a shorter name you choose"
                            IsChecked="{Binding ComponentStats.GPU_PrefixHardwareTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ComponentStats.GPU_PrefixHardwareTitle, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel
                                Margin="0,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Call it" />
                                <TextBox
                                    x:Name="GPUCustomHardwareName"
                                    Width="auto"
                                    MinWidth="50"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ComponentStats.GPUCustomHardwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Margin="7,10,0,2"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Extra readings from the card. Each one adds a few characters to the line." />
                    <CheckBox
                        x:Name="ComponentStatGPUTempVisible_checkbox"
                        Margin="5,5"
                        Content="Show how hot the card is"
                        IsChecked="{Binding ComponentStats.ComponentStatGPUTempVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="ComponentStatGPUHotSpotVisible_checkbox"
                        Margin="5,5"
                        Content="Show the hottest spot on the chip"
                        IsChecked="{Binding ComponentStats.ComponentStatGPUHotSpotVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="ComponentStatGPUWattageVisible_checkbox"
                        Margin="5,5"
                        Content="Show how much power the card is drawing"
                        IsChecked="{Binding ComponentStats.ComponentStatGPUWattageVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="GPU_ShowFanSpeed_checkbox"
                        Margin="5,5"
                        Content="Show how hard the fan is working"
                        IsChecked="{Binding StatsManager.Settings.ShowGpuFanSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Not every card reports this. If nothing appears in the preview, yours does not." />
                    <CheckBox
                        x:Name="GPU_ShowCoreClock_checkbox"
                        Margin="5,5"
                        Content="Show the chip's clock speed"
                        IsChecked="{Binding StatsManager.Settings.ShowGpuCoreClock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="GPU_ShowMemClock_checkbox"
                        Margin="5,5"
                        Content="Show the memory clock speed"
                        IsChecked="{Binding StatsManager.Settings.ShowGpuMemoryClock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="GPU_ShowMemTemp_checkbox"
                        Margin="5,5"
                        Content="Show how hot the card's memory is"
                        IsChecked="{Binding StatsManager.Settings.ShowGpuMemoryTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Only newer cards report this. If nothing appears in the preview, yours does not." />
                    <CheckBox
                        x:Name="GPU_ShowMemLoad_checkbox"
                        Margin="5,5"
                        Content="Show how busy the card's memory is"
                        IsChecked="{Binding StatsManager.Settings.ShowGpuMemoryLoad, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Most of the boxes above are answered by this one: the card's own sensor
                          library is what reports the hotspot, the fan, the clocks and the memory
                          temperature. Turning it off leaves the readings that Windows can supply on
                          its own, which is the plain temperature and the load.  -->
                    <TextBlock
                        Margin="7,10,0,2"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Reads the card's own sensors for the hotspot, the fan, the clocks and the memory. Turn it off if the readings look wrong on a machine with two graphics chips, or if you would rather nothing talked to the card directly; the plain temperature and load carry on either way." />
                    <CheckBox
                        x:Name="EnableVendorGpuSensors_checkbox"
                        Margin="5,5"
                        Content="Read the card's own sensors"
                        IsChecked="{Binding StatsManager.Settings.EnableVendorGpuSensors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Takes effect straight away: the hardware monitor is closed and reopened on the next reading." />

                    <TextBlock
                        Margin="7,10,0,2"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Counts only what games and VR are drawing, ignoring video playback and other work the card does. Usually the number you want." />
                    <CheckBox
                        x:Name="GPU_Core3DHook_checkbox"
                        Margin="5,5"
                        Content="Measure the load from 3D rendering only"
                        IsChecked="{Binding StatsManager.Settings.GPU3DHook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="{Binding ComponentStats.VRAMHardwareName, StringFormat='Graphics memory — {0}', UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="VRAM_SmallName_checkbox"
                        Margin="5,5"
                        Content="Small raised label — ᵛʳᵃᵐ instead of VRAM:"
                        IsChecked="{Binding ComponentStats.VRAM_SmallName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="VRAM_NumberTrailingZeros_checkbox"
                        Margin="5,5"
                        Content="Round to whole numbers — 6ᵍᵇ instead of 5.7ᵍᵇ"
                        IsChecked="{Binding ComponentStats.VRAM_NumberTrailingZeros, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="VRAM_ShowMaxValue_checkbox"
                        Margin="5,5"
                        Content="Show how much there is in total — 5.7/16.0 instead of 5.7"
                        IsChecked="{Binding ComponentStats.VRAM_ShowMaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="VRAM_EnableHardwareTitle_checkbox"
                        Margin="5,5"
                        Content="Use the card's own name instead of 'VRAM'"
                        IsChecked="{Binding ComponentStats.VRAM_EnableHardwareTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="5" IsEnabled="{Binding ComponentStats.VRAM_EnableHardwareTitle, UpdateSourceTrigger=PropertyChanged}">
                        <CheckBox
                            x:Name="VRAM_PrefixHardwareTitle_checkbox"
                            Content="…or a shorter name you choose"
                            IsChecked="{Binding ComponentStats.VRAM_PrefixHardwareTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ComponentStats.VRAM_PrefixHardwareTitle, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel
                                Margin="0,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Call it" />
                                <TextBox
                                    x:Name="VRAMCustomHardwareName"
                                    Width="auto"
                                    MinWidth="50"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ComponentStats.VRAMCustomHardwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Margin="7,10,0,2"
                        Style="{StaticResource OptionHelpTextStyle}"
                        Text="Counts only the memory games and VR are using, ignoring the rest." />
                    <CheckBox
                        x:Name="ComponentStatsGPU3DVRAMHook_checkbox"
                        Margin="5,5"
                        Content="Measure from 3D rendering only"
                        IsChecked="{Binding StatsManager.Settings.GPU3DVRAMHook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OptionCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSubsectionHeaderStyle}" Text="{Binding ComponentStats.RAMHardwareName, StringFormat='Memory — {0}', UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="RAM_SmallName_checkbox"
                        Margin="5,5"
                        Content="Small raised label — ʳᵃᵐ instead of RAM:"
                        IsChecked="{Binding ComponentStats.RAM_SmallName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="RAM_NumberTrailingZeros_checkbox"
                        Margin="5,5"
                        Content="Round to whole numbers — 18ᵍᵇ instead of 18.3ᵍᵇ"
                        IsChecked="{Binding ComponentStats.RAM_NumberTrailingZeros, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="RAM_ShowMaxValue_checkbox"
                        Margin="5,5"
                        Content="Show how much there is in total — 18.3/32.0 instead of 18.3"
                        IsChecked="{Binding ComponentStats.RAM_ShowMaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="RAM_ShowDDRVersion_checkbox"
                        Margin="5,5"
                        Content="Show which generation it is — ⁽ᴰᴰᴿ⁵⁾"
                        IsChecked="{Binding ComponentStats.RAM_ShowDDRVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        x:Name="RAM_EnableHardwareTitle_checkbox"
                        Margin="5,5"
                        Content="Use the memory's own name instead of 'RAM'"
                        IsChecked="{Binding ComponentStats.RAM_EnableHardwareTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="5" IsEnabled="{Binding ComponentStats.RAM_EnableHardwareTitle, UpdateSourceTrigger=PropertyChanged}">
                        <CheckBox
                            x:Name="RAM_PrefixHardwareTitle_checkbox"
                            Content="…or a shorter name you choose"
                            IsChecked="{Binding ComponentStats.RAM_PrefixHardwareTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding ComponentStats.RAM_PrefixHardwareTitle, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel
                                Margin="0,5,0,5"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionFieldLabelStyle}"
                                    Text="Call it" />
                                <TextBox
                                    x:Name="RAMCustomHardwareName"
                                    Width="auto"
                                    MinWidth="50"
                                    Margin="5,0"
                                    Padding="3,0"
                                    VerticalAlignment="Center"
                                    FontSize="{StaticResource FontSizeBody}"
                                    Text="{Binding ComponentStats.RAMCustomHardwareName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.ChattingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:core="clr-namespace:vrcosc_magicchatbox.Core"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ChattingPageViewModel,
                                     IsDesignTimeCreatable=False}"
    Background="{StaticResource SurfaceCardBrush}"
    FontFamily="{DynamicResource FontPrimary}"
    mc:Ignorable="d">
    <!--
        No page-level converter dictionary. App.xaml already merges the converters, and it has to:
        a UserControl's XAML is parsed before the control is attached to anything, so a StaticResource
        inside it can only ever reach the application dictionary. Merging the same file here was
        doing nothing the app was not already doing.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <!--  Auto, not a fixed 31: the warning is normally collapsed and should cost no height.  -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="35" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <!--  Only ever shows when the line will not fit, so it wears the colour of a problem.  -->
        <Border
            Margin="12,4,12,2"
            Padding="10,0"
            BorderBrush="#66FF6B6B"
            BorderThickness="1"
            CornerRadius="6">
            <Border.Background>
                <SolidColorBrush Color="#FF6B6B" Opacity="0.16" />
            </Border.Background>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ChatStatus.ChatTopBarTxt.Length}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                d:Text="That is 4 over what the chatbox will take."
                FontFamily="{StaticResource FontPrimary}"
                FontSize="{StaticResource FontSizeSecondary}"
                Foreground="#FFFFC9C9"
                Text="{Binding ChatStatus.ChatTopBarTxt}" />
        </Border>

        <!--
            The composer. One object with one focus ring, rather than a text box with a row of
            controls parked on top of it behind 93px of right padding.
        -->
        <Grid
            Grid.Row="4"
            Margin="12,0"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Height="42"
                Style="{StaticResource ChatComposerShell}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ToggleButton
                        x:Name="LiveTypingToggle"
                        Grid.Column="0"
                        Margin="6,0,2,0"
                        IsChecked="{Binding ChatSettings.ChatLiveTyping, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource LiveTypingChip}"
                        ToolTip="Show what you are typing in VRChat as you type it, instead of only when you send. Press Enter and it becomes a normal message." />

                    <Grid Grid.Column="1" Margin="4,0,0,0">
                        <TextBox
                            x:Name="NewChattingTxt"
                            Padding="6,0"
                            VerticalContentAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeBody}"
                            Foreground="{StaticResource ChatTextBrush}"
                            KeyDown="NewChattingTxt_KeyDown"
                            MaxLength="144"
                            Style="{StaticResource InlineTransparentTextBox}"
                            Text="{Binding ChatStatus.NewChattingTxt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Left"
                            TextChanged="NewChattingTxt_TextChanged" />

                        <!--
                            The ghost has to start on exactly the same pixel as the real text, so it
                            copies the box's font and padding and hides the typed prefix behind a
                            transparent run rather than trying to measure it.
                        -->
                        <TextBlock
                            Padding="6,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeBody}"
                            Foreground="{StaticResource AccentLightPurpleBrush}"
                            IsHitTestVisible="False"
                            Opacity="0.45"
                            Visibility="{Binding ChatStatus.ChatAutocompleteActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Foreground="Transparent" Text="{Binding ChatStatus.NewChattingTxt, Mode=OneWay}" />
                            <Run Text="{Binding ChatStatus.ChatAutocompleteSuggestion, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock
                            Padding="6,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource FontPrimary}"
                            FontSize="{StaticResource FontSizeBody}"
                            Foreground="{StaticResource TextDarkMutedBrush}"
                            IsHitTestVisible="False"
                            Text="Send a chat message">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewChattingTxt}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeFine}"
                        Foreground="{StaticResource TextMutedBrush}"
                        IsHitTestVisible="False"
                        Text="TAB"
                        Visibility="{Binding ChatStatus.ChatAutocompleteActive, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock
                        Grid.Column="3"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeCaption}"
                        Foreground="{Binding ChatStatus.ChatBoxColor}"
                        Text="{Binding ChatStatus.ChatBoxCount}" />

                    <StackPanel
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="Paste_Chatting"
                            Command="{Binding PasteChatCommand}"
                            Style="{StaticResource ChatComposerIconButton}"
                            ToolTip="Paste"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                            <Image
                                Width="17"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Img/Icons/PasteChat_ico.png" />
                        </Button>
                        <Button
                            x:Name="CleanChatting_btn"
                            Command="{Binding ClearChatInputCommand}"
                            ToolTip="Clear what you typed"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                            <Image
                                Width="17"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Img/Icons/Remove_icon.png" />
                            <Button.Style>
                                <Style BasedOn="{StaticResource ChatComposerIconButton}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=NewChattingTxt}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Button
                x:Name="ButtonChattingTxt"
                Grid.Column="1"
                Width="84"
                Height="42"
                Margin="8,0,0,0"
                Click="ButtonChattingTxt_Click"
                Content="Send"
                Style="{DynamicResource Status_Button_style}" />
        </Grid>
        <!--
            The status strip. Laid out in real columns, so the countdown no longer has to be nudged
            clear of the buttons with a hard-coded right margin that only held at one window width.
        -->
        <Border
            Grid.Row="1"
            Background="{StaticResource SurfaceVariantBrush}"
            BorderBrush="#33000000"
            BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    d:Text="Chat feedback"
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeCompact}"
                    Foreground="{StaticResource TextLabelBrush}"
                    Text="{Binding ChatStatus.ChatFeedbackTxt}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding Modules.IntelliChat.Settings.IntelliChatUILabel, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    d:Text="Connecting with OpenAI..."
                    FontFamily="{StaticResource FontPrimary}"
                    FontSize="{StaticResource FontSizeCompact}"
                    Foreground="{StaticResource TextSuccessLightBrush}"
                    Text="{Binding Modules.IntelliChat.Settings.IntelliChatUILabelTxt, UpdateSourceTrigger=PropertyChanged}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding Modules.IntelliChat.Settings.IntelliChatUILabel, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        d:Text="Visible for 12s"
                        FontFamily="{StaticResource FontPrimary}"
                        FontSize="{StaticResource FontSizeSecondary}"
                        Foreground="{StaticResource FeatureOnEdgeBrush}"
                        Text="{Binding ChatStatus.ScanPauseCountDown, StringFormat='Visible for {0}s', UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding ChatStatus.CountDownUI, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        x:Name="StopChat"
                        Width="52"
                        Height="26"
                        Click="StopChat_Click"
                        Content="Stop"
                        Style="{StaticResource ChatRowButton}"
                        ToolTip="Take the message out of the chatbox now" />
                    <Button
                        x:Name="ClearChat"
                        Height="26"
                        Click="ClearChat_Click"
                        Content="Clear history"
                        Style="{StaticResource ChatRowButton}"
                        ToolTip="Forget the messages listed here" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                Name="RecentScroll"
                Margin="7,0,0,0"
                Visibility="Visible">
                <ItemsControl
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    ItemsSource="{Binding ChatStatus.LastMessages, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Opacity="{Binding Opacity}" Style="{StaticResource ChatMessageCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        Which message is currently in the chatbox. The row already
                                        carries a lit edge, but that reads as hover; a bar that only
                                        the live row has cannot be mistaken for one.
                                    -->
                                    <Border
                                        Grid.Column="0"
                                        Width="3"
                                        Margin="7,10,0,10"
                                        Background="{StaticResource FeatureOnEdgeBrush}"
                                        CornerRadius="2"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        Padding="12,12,0,12"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeSubheading}"
                                        Foreground="{StaticResource ChatTextBrush}"
                                        Text="{Binding Msg, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding CanLiveEditRun, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox
                                        x:Name="EditChatTextBox"
                                        Grid.Column="1"
                                        Padding="12,12,0,12"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource FontPrimary}"
                                        FontSize="{StaticResource FontSizeSubheading}"
                                        Foreground="{StaticResource ChatEditTextBrush}"
                                        IsReadOnly="{Binding CanLiveEditRun, Converter={StaticResource InvertBooleanConverter}, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        KeyDown="EditChatTextBox_KeyDown"
                                        MaxLength="{x:Static core:Constants.MaxChatMessageLength}"
                                        Style="{StaticResource InlineTransparentTextBox}"
                                        Text="{Binding MsgReplace, UpdateSourceTrigger=PropertyChanged}"
                                        TextChanged="EditChatTextBox_TextChanged"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding CanLiveEditRun, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Grid.Column="2" Style="{StaticResource ChatRowActions}">
                                        <Button
                                            x:Name="CancelEditChatbutton"
                                            Click="CancelEditChatbutton_Click"
                                            Content="Cancel"
                                            Style="{StaticResource ChatRowButton}"
                                            Tag="{Binding}"
                                            ToolTip="Throw the edit away and put the message back"
                                            Visibility="{Binding CanLiveEditRun, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                        <ToggleButton
                                            Checked="ToggleButton_Checked"
                                            Content="{Binding LiveEditButtonTxt}"
                                            IsChecked="{Binding CanLiveEditRun, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            Style="{StaticResource ChatRowToggle}"
                                            Tag="{Binding}"
                                            ToolTip="Change this message while it is still showing in VRChat"
                                            Unchecked="ToggleButton_Checked"
                                            Visibility="{Binding CanLiveEdit, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Click="OnSendAgain"
                                            Content="Resend"
                                            IsEnabled="{Binding CanLiveEditRun, Converter={StaticResource InvertBooleanConverter}, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ChatRowButton}"
                                            Tag="{Binding}"
                                            ToolTip="Put this message back in the chatbox" />
                                        <Button
                                            Command="{Binding CopyToClipboardCommand}"
                                            CommandParameter="{Binding Msg}"
                                            Padding="8,0"
                                            Style="{StaticResource ChatRowButton}"
                                            ToolTip="Copy">
                                            <Image
                                                Width="15"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="/Img/Icons/Copy_ico.png" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Grid
                x:Name="AIResponse"
                Grid.Row="1"
                Height="auto"
                Margin="6,0,7,7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                d:Visibility="Collapsed"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Visibility="{Binding Modules.IntelliChat.Settings.IntelliChatWaitingToAccept, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                <Border Margin="10,0" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#3E5750" />
                            <GradientStop Offset="1" Color="{StaticResource SurfaceMidGradientColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="35"
                            Direction="-90"
                            Opacity="0.5"
                            RenderingBias="Performance"
                            ShadowDepth="5"
                            Color="LightGreen" />
                    </Border.Effect>
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="55" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="Auto" MinHeight="40" />
                        </Grid.RowDefinitions>


                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="auto"
                            Height="Auto"
                            Margin="0,0,95,0"
                            Padding="15,0,0,15"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="15"
                            Foreground="AntiqueWhite"
                            Text="{Binding Modules.IntelliChat.Settings.IntelliChatTxt, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap">
                            <TextBlock.Effect>
                                <DropShadowEffect
                                    BlurRadius="20"
                                    Opacity="1"
                                    RenderingBias="Performance"
                                    ShadowDepth="0"
                                    Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>



                        <Image
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Width="30"
                            Height="auto"
                            Margin="5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Effect="{StaticResource ImageShadowEffect}"
                            Opacity="0.5"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Img/Icons/OpenAI.png" />

                        <StackPanel Height="auto" Orientation="Horizontal">

                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="15,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="18"
                                Foreground="{StaticResource TextChatAccentBrush}"
                                Text="IntelliChat">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="20"
                                        Opacity="0.9"
                                        RenderingBias="Performance"
                                        ShadowDepth="0"
                                        Color="Purple" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="5,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Foreground="{StaticResource TextChatAccentBrush}"
                                Opacity="0.6"
                                Text="Tokens:" />
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="2,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Foreground="{StaticResource TextChatAccentBrush}"
                                Opacity="0.6"
                                Text="{Binding Modules.IntelliChat.Settings.TokenUsageData.LastRequestTotalTokens, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="5,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Foreground="{StaticResource TextChatAccentBrush}"
                                Opacity="0.6"
                                Text="Model:" />
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="2,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Foreground="{StaticResource TextChatAccentBrush}"
                                Opacity="0.6"
                                Text="{Binding Modules.IntelliChat.Settings.TokenUsageData.LastRequestModelName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="5,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Foreground="{StaticResource TextChatAccentBrush}"
                                Opacity="0.3"
                                Text="Today tokens:" />
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="2,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Foreground="{StaticResource TextChatAccentBrush}"
                                Opacity="0.3"
                                Text="{Binding Modules.IntelliChat.Settings.TokenUsageData.TotalDailyTokens, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="5,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Style="{StaticResource CharacterCountTextStyle}"
                                Text="Characters:" />
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="5,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Style="{StaticResource CharacterCountTextStyle}"
                                Text="{Binding Modules.IntelliChat.Settings.IntelliChatTxt.Length, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Width="auto"
                                Height="Auto"
                                Padding="0,10,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="12"
                                Style="{StaticResource CharacterCountTextStyle}"
                                Text="/144" />


                        </StackPanel>
                        <TextBlock
                            Width="auto"
                            Height="Auto"
                            Margin="0,0,-10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            FontFamily="/Fonts/#Albert Sans"
                            FontSize="12"
                            Foreground="{StaticResource TextChatAccentBrush}"
                            Opacity="0.3"
                            Text="Powered by OpenAI" />

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="-70,5,0,5"
                            Orientation="Horizontal">
                            <Button
                                x:Name="AcceptAndSentIntelliChat"
                                Width="auto"
                                Margin="2"
                                Padding="2"
                                Click="AcceptAndSentIntelliChat_Click"
                                Style="{DynamicResource Status_Button_style}">
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="18"
                                        Margin="2"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="/Img/Icons/Accept_ico.png" />
                                    <TextBlock
                                        Padding="3,0"
                                        VerticalAlignment="Center"
                                        FontFamily="/Fonts/#Albert Sans"
                                        FontSize="13"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Sent" />
                                </StackPanel>

                            </Button>
                            <Button
                                x:Name="NotAcceptIntelliChat"
                                Width="auto"
                                Margin="2"
                                Padding="2"
                                Command="{Binding RejectIntelliChatCommand}"
                                Style="{DynamicResource Status_Button_style}">
                                <Image
                                    Width="18"
                                    Margin="1"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="/Img/Icons/NotAccept_ico.png" />
                            </Button>
                            <Button
                                x:Name="AcceptIntelliChat"
                                Width="auto"
                                Margin="2"
                                Padding="2"
                                Command="{Binding AcceptIntelliChatCommand}"
                                Style="{DynamicResource Status_Button_style}">
                                <Image
                                    Width="18"
                                    Margin="1"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="/Img/Icons/Accept_ico.png" />
                            </Button>
                        </StackPanel>

                    </Grid>

                </Border>
            </Grid>
            <Grid
                x:Name="AIErrorResponse"
                Grid.Row="1"
                Height="auto"
                Margin="6,0,7,7"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                d:Visibility="Collapsed"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Visibility="{Binding Modules.IntelliChat.Settings.IntelliChatError, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                <Border Margin="10,0" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="MediumVioletRed" />
                            <GradientStop Offset="1" Color="{StaticResource SurfaceMidGradientColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="35"
                            Direction="-90"
                            Opacity="0.9"
                            RenderingBias="Performance"
                            ShadowDepth="5"
                            Color="MediumVioletRed" />
                    </Border.Effect>
                    <Grid Margin="3">

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal">
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Width="auto"
                                Height="Auto"
                                Padding="15,15,0,15"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="MediumVioletRed"
                                Text="{Binding Modules.IntelliChat.Settings.IntelliChatErrorTxt, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="20"
                                        Opacity="1"
                                        RenderingBias="Performance"
                                        ShadowDepth="0"
                                        Color="Black" />
                                </TextBlock.Effect>
                            </TextBlock>


                        </StackPanel>

                        <Button
                            x:Name="CloseIntelliErrorPanel"
                            Width="auto"
                            Padding="6"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseIntelliErrorCommand}"
                            Opacity="0.8"
                            Style="{DynamicResource Status_Button_style}">
                            <Image
                                Width="18"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Img/Icons/NotAccept_ico.png" />
                        </Button>





                    </Grid>

                </Border>
            </Grid>
        </Grid>
        <!--
            The AI tool strip. One shared button style instead of eight repeated drop shadows, so it
            reads as the same kind of control as the row actions above it and costs eight fewer
            render passes on a row that is always on screen.
        -->
        <Border
            Grid.Row="3"
            Background="{StaticResource SurfaceVariantBrush}"
            BorderBrush="#33000000"
            BorderThickness="0,1,0,0">
            <StackPanel
                Margin="12,7"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                RenderOptions.BitmapScalingMode="HighQuality"
                Visibility="{Binding ChatSettings.HideOpenAITools, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChatStatus.IntelliChatRequesting}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button
                    x:Name="SpellingCheck"
                    Height="30"
                    Margin="0,0,6,0"
                    Command="{Binding SpellCheckCommand}"
                    Style="{StaticResource ChatRowButton}"
                    ToolTip="Have AI fix the spelling and grammar of what you typed">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="18"
                            Margin="0,0,6,0"
                            Source="/Img/Icons/SpellingCheck.png" />
                        <TextBlock VerticalAlignment="Center" Text="Spelling &amp; grammar" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="RebuildChat"
                    Height="30"
                    Margin="0,0,6,0"
                    Command="{Binding BeautifyCommand}"
                    Style="{StaticResource ChatRowButton}"
                    ToolTip="Have AI rewrite what you typed so it reads better">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="18"
                            Margin="0,0,6,0"
                            Source="/Img/Icons/RebuildChat.png" />
                        <TextBlock VerticalAlignment="Center" Text="Magic Improve" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="TranslateChat"
                    Height="30"
                    Margin="0,0,6,0"
                    Command="{Binding TranslateCommand}"
                    Style="{StaticResource ChatRowButton}"
                    ToolTip="Have AI translate what you typed">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="18"
                            Margin="0,0,6,0"
                            Source="/Img/Icons/Translate_ico.png" />
                        <TextBlock VerticalAlignment="Center" Text="Translate" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ShortenChat"
                    Height="30"
                    Margin="0,0,6,0"
                    Command="{Binding ShortenChatCommand}"
                    Style="{StaticResource ChatRowButton}"
                    ToolTip="Have AI say the same thing in fewer characters">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="18"
                            Margin="0,0,6,0"
                            Source="/Img/Icons/Cut_ico.png" />
                        <TextBlock VerticalAlignment="Center" Text="Shorten" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="ConvoStarterChat"
                    Height="30"
                    Margin="0,0,6,0"
                    Command="{Binding ConvoStarterCommand}"
                    Style="{StaticResource ChatRowButton}"
                    ToolTip="Have AI suggest something to say">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="18"
                            Margin="0,0,6,0"
                            Source="/Img/Icons/Wand_ico.png" />
                        <TextBlock VerticalAlignment="Center" Text="Convo starter" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="Record"
                    Height="30"
                    Margin="0,0,6,0"
                    Command="{Binding StartRecordingCommand}"
                    Style="{StaticResource ChatRowButton}"
                    ToolTip="Talk instead of typing - AI writes down what you say"
                    Visibility="{Binding Modules.Whisper.Settings.IsRecording, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="18"
                            Margin="0,0,6,0"
                            Source="/Img/Icons/SpeechToText.png" />
                        <TextBlock VerticalAlignment="Center" Text="Speech to text" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="StopRecord"
                    Height="30"
                    Margin="0,0,6,0"
                    Command="{Binding StopRecordingCommand}"
                    Style="{StaticResource ChatRowButton}"
                    ToolTip="Stop listening"
                    Visibility="{Binding Modules.Whisper.Settings.IsRecording, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="18"
                            Margin="0,0,6,0"
                            Source="/Img/Icons/SpeechToText.png" />
                        <TextBlock VerticalAlignment="Center" Text="Stop listening" />
                    </StackPanel>
                </Button>

                <ToggleButton
                    x:Name="AutocompleteToggle"
                    Height="30"
                    Content="Auto complete"
                    IsChecked="{Binding ChatSettings.ChatAutocompleteEnabled, Mode=TwoWay}"
                    Style="{StaticResource ChatRowToggle}"
                    ToolTip="Suggest the rest of the sentence ahead of your cursor. Press Tab to take it." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

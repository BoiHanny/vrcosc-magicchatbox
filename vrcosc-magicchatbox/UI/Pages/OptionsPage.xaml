<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.OptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:options="clr-namespace:vrcosc_magicchatbox.UI.Pages.Options"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OptionsPageViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="550"
    d:DesignWidth="900"
    FontFamily="{DynamicResource FontPrimary}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="OptionSectionPlaceholderTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="15,8,10,0" />
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSectionHeaderBrush}" />
        </Style>
        <Style
            x:Key="OptionSectionPlaceholderStatus"
            BasedOn="{StaticResource OptionSectionPlaceholderTitle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="15,2,10,10" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="MainScroll"
        Padding="0,0,0,12"
        CanContentScroll="False"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SectionsPanel">
            <controls:OptionGroupHeader Title="Your message" />

            <ContentControl
                x:Name="OptionsWrapper_Chatting"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="chatting">
                <options:ChattingOptionsSection x:Name="Section_Chatting" DataContext="{Binding ChattingOptionsSection}" />
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_Status"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="status">
                <options:StatusSection x:Name="Section_Status" DataContext="{Binding StatusSection}" />
            </ContentControl>

            <controls:OptionGroupHeader Title="Music" />

            <ContentControl
                x:Name="OptionsWrapper_MediaLink"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="media-link">
                <options:MediaLinkSection x:Name="MediaLinkSectionControl" DataContext="{Binding MediaLinkSection}" />
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_Spotify"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="spotify">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Spotify options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_Lyrics"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="lyrics">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Lyrics (MediaLink &amp; Spotify)" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <controls:OptionGroupHeader Title="Streaming and chat" />

            <ContentControl
                x:Name="OptionsWrapper_Twitch"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="twitch">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Twitch options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_TikTokLive"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="tiktok-live">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="TikTok options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_Discord"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="discord">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Discord voice options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_VrcRadar"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="vrc-radar">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="VRChat radar options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <controls:OptionGroupHeader Title="On screen" />

            <ContentControl
                x:Name="OptionsWrapper_Time"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="time">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Time options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_Weather"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="weather">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Weather options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <controls:OptionGroupHeader Title="Your PC and body" />

            <ContentControl
                x:Name="OptionsWrapper_Pulsoid"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="pulsoid">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Pulsoid heart rate options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_ComponentStats"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="component-stats">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Component stats options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_NetworkStatistics"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="network-statistics">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Network statistics options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_WindowActivity"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="window-activity">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Window activity options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <controls:OptionGroupHeader Title="VR" />

            <ContentControl
                x:Name="OptionsWrapper_VrPerformance"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="vr-performance">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="VR performance options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_TrackerBattery"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="tracker-battery">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Tracker battery manager" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <controls:OptionGroupHeader Title="AI and voice" />

            <ContentControl
                x:Name="OptionsWrapper_OpenAI"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="openai">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="OpenAI options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_Tts"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="tts">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Text to speech options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <controls:OptionGroupHeader Title="App and privacy" />

            <ContentControl
                x:Name="OptionsWrapper_AppOptions"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="app-options">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="App options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_Privacy"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="privacy">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="Privacy &amp; permissions" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <ContentControl
                x:Name="OptionsWrapper_EggDev"
                Style="{StaticResource OptionSectionWithResetStyle}"
                Tag="egg-dev"
                Visibility="{Binding EggDevSection.AppState.Egg_Dev, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                <StackPanel>
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderTitle}" Text="EGG options" />
                    <TextBlock Style="{StaticResource OptionSectionPlaceholderStatus}" Text="Loading…" />
                </StackPanel>
            </ContentControl>

            <TextBlock
                Margin="12,14,12,8"
                HorizontalAlignment="Center"
                FontFamily="/Fonts/#Albert Sans"
                FontSize="11"
                Foreground="{StaticResource TextMutedBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap">
                <Run Text="By using MagicChatbox, you agree to the " />
                <Hyperlink
                    Foreground="{StaticResource TextLabelBrush}"
                    NavigateUri="https://github.com/BoiHanny/vrcosc-magicchatbox/blob/master/Security.md"
                    RequestNavigate="Hyperlink_RequestNavigate"
                    ToolTip="Opens the Privacy &amp; Security policy on GitHub">
                    <Run Text="Privacy &amp; Security Policy" />
                </Hyperlink>
                <Run Text=" and " />
                <Hyperlink
                    Foreground="{StaticResource TextLabelBrush}"
                    NavigateUri="https://github.com/BoiHanny/vrcosc-magicchatbox/blob/master/License.md"
                    RequestNavigate="Hyperlink_RequestNavigate"
                    ToolTip="Opens the Software License on GitHub">
                    <Run Text="Software License" />
                </Hyperlink>
                <Run Text="." />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>

                                    Style="{StaticResource TileDescriptionStyle}"
                                    Text="Whatever&#x27;s playing on your PC: Spotify, YouTube, a browser tab. No account, no setup, just music." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource TileControlDeck}">
                                <StackPanel Style="{StaticResource DeckOutputRow}">
                                    <ToggleButton
                                        Content="LYRICS"
                                        IsChecked="{Binding LyricsFromMediaLink, Mode=TwoWay}"
                                        Style="{StaticResource FeatureChipLyrics}"
                                        ToolTip="Sing along in the chatbox for whatever Windows is playing. Spotify has its own switch." />
                                    <ToggleButton
                                        Content="TRANSIENT"
                                        IsChecked="{Binding MediaLinkSettings.ShowOnlyOnChange, Mode=TwoWay}"
                                        Style="{StaticResource FeatureChip}"
                                        ToolTip="Transient" />
                                    <ToggleButton IsChecked="{Binding IntegrationSettings.IntgrMediaLink_DESKTOP, Mode=TwoWay}" Style="{StaticResource RouteChipDesktop}" />
                                    <ToggleButton IsChecked="{Binding IntegrationSettings.IntgrMediaLink_VR, Mode=TwoWay}" Style="{StaticResource RouteChipVr}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource DeckChromeRow}">
                                    <Button
                                        AutomationProperties.Name="Hide this tile"
                                        Click="HideTile_Click"
                                        Style="{StaticResource TileHideButton}"
                                        ToolTip="Hide this tile from the list. The integration stays switched on." />
                                    <Button
                                        Command="{Binding ActivateSettingCommand}"
                                        CommandParameter="Settings_MediaLink"
                                        Style="{StaticResource TileDoorButton}" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox
                                Name="MediaLink_switch"
                                Grid.Column="3"
                                Margin="5,0,5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="Update_Click"
                                IsChecked="{Binding IntegrationSettings.IntgrScanMediaLink, Mode=TwoWay}"
                                Style="{DynamicResource Switch}" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Height="auto"
                        Margin="0,-3,0,0"
                        d:Visibility="Visible"
                        Background="Transparent"
                        CornerRadius="0,0,5,5"
                        Visibility="{Binding MediaLinkDisplay.MediaSessions.Count, Converter={StaticResource CountToVisibilityConverter}}"
                        BorderBrush="#FF150C33"
                        BorderThickness="1">
                        <ItemsControl
                            Height="auto"
                            Padding="0,0,0,5"
                            Background="Transparent"
                            ItemsSource="{Binding MediaLinkDisplay.MediaSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="auto"
                                        Margin="5,5,5,0"
                                        VerticalAlignment="Stretch"
                                        Background="{StaticResource SurfaceButtonDarkBrush}"
                                        CornerRadius="5"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="MediaSessionRow_MouseLeftButtonUp"
                                        Tag="{Binding}">
                                        <Grid Margin="10,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="auto"
                                                    MinWidth="60"
                                                    MaxWidth="115" />
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>


                                            <Border
                                                Margin="-10,-5,-5,-5"
                                                BorderThickness="3,3,0,3"
                                                CornerRadius="4,0,0,4"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.0,0">
                                                        <GradientStop Color="#FF3A1F73" />
                                                        <GradientStop Offset="1" Color="#230E53" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.0,0">
                                                        <GradientStop Color="#FF3A1F73" />
                                                        <GradientStop Offset="1" Color="#A38ED1" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>

                                            </Border>
                                            <Border
                                                Margin="-10,-5,-5,-5"
                                                BorderThickness="3,3,0,3"
                                                CornerRadius="4,0,0,4"
                                                IsHitTestVisible="False"
                                                Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.0,0">
                                                        <GradientStop Color="#FF3A1F73" />
                                                        <GradientStop Offset="1" Color="#2B165C" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.0,0">
                                                        <GradientStop Color="#FF3A1F73" />
                                                        <GradientStop Offset="1" Color="#482D7F" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>

                                            </Border>
                                            <RadioButton
                                                Grid.Column="0"
                                                Width="auto"
                                                Margin="0,-1,0,0"
                                                VerticalAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Checked="Update_Click"
                                                Content="{Binding FriendlyAppName}"
                                                Cursor="Hand"
                                                Foreground="#DBD9DE"
                                                GroupName="MediaSessions"
                                                IsChecked="{Binding IsActive}"
                                                Unchecked="Update_Click">

                                                <RadioButton.Template>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <ContentPresenter
                                                            x:Name="contentPresenter"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                                                    </ControlTemplate>
                                                </RadioButton.Template>
                                            </RadioButton>



                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="7,0,0,0"
                                                Orientation="Horizontal">
                                                <CheckBox
                                                    Width="auto"
                                                    Height="25"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Checked="Update_Click"
                                                    Content="VIDEO"
                                                    IsChecked="{Binding IsVideo}"
                                                    Style="{DynamicResource GlowyToggleButtonMediaLink}"
                                                    Unchecked="Update_Click" />
                                                <CheckBox
                                                    Width="auto"
                                                    Height="25"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Checked="Update_Click"
                                                    Content="ARTIST"
                                                    IsChecked="{Binding ShowArtist}"
                                                    Style="{DynamicResource GlowyToggleButtonMediaLink}"
                                                    Unchecked="Update_Click" />
                                                <CheckBox
                                                    Width="auto"
                                                    Height="25"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Checked="Update_Click"
                                                    Content="TITLE"
                                                    IsChecked="{Binding ShowTitle}"
                                                    Style="{DynamicResource GlowyToggleButtonMediaLink}"
                                                    Unchecked="Update_Click" />
                                                <Button
                                                    x:Name="MediaSessionPlay"
                                                    Width="25"
                                                    Height="25"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Click="MediaSessionPausePlay_Click"
                                                    Content="▶"
                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                    Style="{StaticResource GlowyButtonMediaLinkWithText}"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding PlayingNow, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                <Button
                                                    x:Name="MediaSessionPause"
                                                    Width="25"
                                                    Height="25"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Click="MediaSessionPausePlay_Click"
                                                    Content="⏸"
                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                    Style="{StaticResource GlowyButtonMediaLinkWithText}"
                                                    Tag="{Binding}"
                                                    Visibility="{Binding PlayingNow, Converter={StaticResource InverseBoolToHiddenConverter}}" />
                                                <StackPanel
                                                    Width="170"
                                                    Margin="5,0,5,0"
                                                    VerticalAlignment="Center">
                                                    <Border Visibility="{Binding IsLiveTime, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                        <ProgressBar
                                                            x:Name="MediaProgressbar"
                                                            Margin="0,0,0,0"
                                                            BorderThickness="5"
                                                            Cursor="Hand"
                                                            Effect="{Binding TimePeekEnabled, Converter={StaticResource BoolToBlurEffectConverter}}"
                                                            MouseLeftButtonDown="MediaProgressbar_MouseLeftButtonDown"
                                                            Style="{StaticResource MediaPlayerProgress}"
                                                            Tag="{Binding}"
                                                            Value="{Binding TimePosition, Mode=OneWay}" />
                                                    </Border>
                                                    <Grid Visibility="{Binding IsLiveTime, Converter={StaticResource InverseBoolToHiddenConverter}}">
                                                        <Grid>
                                                            <ProgressBar
                                                                Margin="0,0,0,0"
                                                                BorderThickness="5"
                                                                Style="{StaticResource MediaPlayerProgress}"
                                                                Visibility="{Binding TimePeekEnabled, Converter={StaticResource InverseBoolToHiddenConverter}}"
                                                                Value="69" />
                                                            <Grid.Effect>
                                                                <BlurEffect Radius="10" po:Freeze="True" />
                                                            </Grid.Effect>
                                                        </Grid>
                                                        <TextBox
                                                            Padding="0,2,0,0"
                                                            d:Text="LIVE"
                                                            AllowDrop="False"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Focusable="False"
                                                            FontFamily="/Fonts/#Albert Sans"
                                                            FontSize="17"
                                                            FontWeight="Bold"
                                                            Foreground="#26FFFE"
                                                            IsHitTestVisible="False"
                                                            IsReadOnly="True"
                                                            Opacity="0.8"
                                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                            Text="LIVE"
                                                            TextAlignment="Center">
                                                        </TextBox>
                                                    </Grid>

                                                </StackPanel>
                                                <Button
                                                    x:Name="MediaSessionPrevious"
                                                    Width="25"
                                                    Height="25"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Click="MediaSessionPrevious_Click"
                                                    Content="⏮"
                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                    Style="{StaticResource GlowyButtonMediaLinkWithText}"
                                                    Tag="{Binding}" />
                                                <Button
                                                    x:Name="MediaSessionNext"
                                                    Width="25"
                                                    Height="25"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Click="MediaSessionNext_Click"
                                                    Content="⏭"
                                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                    Style="{StaticResource GlowyButtonMediaLinkWithText}"
                                                    Tag="{Binding}" />

                                            </StackPanel>

                                            <StackPanel />
                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="0,0,-6,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">

                                                <CheckBox
                                                    Height="25"
                                                    Margin="0,0,3,0"
                                                    Checked="Update_Click"
                                                    Content="AUTOSWITCH ON PLAY"
                                                    IsChecked="{Binding AutoSwitch}"
                                                    Style="{DynamicResource GlowyToggleButtonMediaLink}"
                                                    Unchecked="Update_Click" />
                                                <CheckBox
                                                    Width="25"
                                                    Height="25"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Checked="Update_Click"
                                                    Content=""
                                                    IsChecked="{Binding KeepSaved}"
                                                    Style="{DynamicResource GlowyToggleButtonMediaLinkWithImage}"
                                                    Unchecked="Update_Click" />

                                            </StackPanel>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ContentControl
                        Grid.Row="2"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource LyricsRibbonTemplate}"
                        Visibility="{Binding LyricsDisplay.ShowOnMediaLinkCard, Converter={StaticResource InverseBoolToHiddenConverter}}" />
                </Grid>


            </ListBoxItem>






        </ListBox>
    </Grid>
</UserControl>

<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.IntegrationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:IntegrationsPageViewModel,
                                     IsDesignTimeCreatable=False}"
    Background="{StaticResource SurfaceCardBrush}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="LyricsRibbonTemplate">
                <Border
                    Margin="5,0,5,5"
                    Padding="10,7"
                    BorderBrush="#3A2A66"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#221740" />
                            <GradientStop Offset="1" Color="#1A0F30" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="2,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{StaticResource AccentLightPurpleBrush}"
                            Text="♪" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                d:Text="It's because"
                                FontFamily="Comfortaa Light"
                                FontSize="14"
                                Foreground="White"
                                Text="{Binding LyricsDisplay.CurrentLine}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding LyricsDisplay.IsShowingLine, Converter={StaticResource InverseBoolToHiddenConverter}}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                d:Text="56 lines from LRCLIB"
                                FontFamily="Albert Sans Thin"
                                FontSize="11"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="{Binding LyricsDisplay.StatusText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{Binding ActivateSettingCommand}"
                            CommandParameter="Settings_Lyrics"
                            Content="Tune ›"
                            Style="{StaticResource CustomizePillButton}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="10,5,19,0"
            Padding="10,7"
            HorizontalAlignment="Stretch"
            d:Visibility="Visible"
            Background="#332B1B4A"
            BorderBrush="#9B7FD9"
            BorderThickness="1"
            CornerRadius="5"
            Visibility="{Binding HasModeVisibilityWarning, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,7,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="👁" />
                <TextBlock
                    VerticalAlignment="Center"
                    d:Text="Enabled but not shown in VR mode: Network Statistics."
                    FontFamily="Comfortaa Light"
                    FontSize="12"
                    Foreground="#D9CCF5"
                    Text="{Binding ModeVisibilityWarning, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ListBox
            x:Name="IntegrationsList"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.CanContentScroll="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    Padding="3,0,3,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Name="StatusItem" Opacity="{Binding IntegrationDisplay.StatusOpacity}">
                <Border Margin="5" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="DarkSlateBlue" />
                            <GradientStop Offset="1" Color="{StaticResource AccentDeepPurpleColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="5"
                            Direction="-23"
                            RenderingBias="Performance"
                            ShadowDepth="0"
                            Color="DarkBlue" />
                    </Border.Effect>
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Margin="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Effect="{StaticResource ImageShadowEffect}"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Img/Icons/PersonalMsg_ico.png" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel
                                Margin="0,3,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Effect="{StaticResource TextBlockShadowEffect}"
                                    FontFamily="Comfortaa Light"
                                    FontSize="20"
                                    Foreground="White"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="Personal status"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,3,0,0"
                                Effect="{StaticResource TextBlockShadowEffect}"
                                FontFamily="Comfortaa Light"
                                FontSize="13"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Text="With this integration, you can write an epic status message that will be displayed in the chatbox.."
                                TextWrapping="Wrap">
                                <TextBlock.Foreground>
                                    <RadialGradientBrush>
                                        <GradientStop Color="White" />
                                        <GradientStop Offset="1" Color="{StaticResource AccentLightPurpleColor}" />
                                    </RadialGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="0,5,0,0"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <Button
                                Margin="0,0,5,0"
                                Command="{Binding ActivateSettingCommand}"
                                CommandParameter="Settings_Status"
                                Style="{StaticResource CustomizePillButton}" />
                            <ToggleButton
                                Width="60"
                                Height="19"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="DESKTOP"
                                IsChecked="{Binding IntegrationSettings.IntgrStatus_DESKTOP, Mode=TwoWay}"
                                Style="{StaticResource GlowyToggleButtonDT}" />
                            <ToggleButton
                                Width="30"
                                Height="19"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="VR"
                                IsChecked="{Binding IntegrationSettings.IntgrStatus_VR, Mode=TwoWay}"
                                Style="{StaticResource GlowyToggleButtonVR}" />
                        </StackPanel>
                        <CheckBox
                            Name="Status_switch"
                            Grid.Column="3"
                            Margin="5,0,5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="Update_Click"
                            IsChecked="{Binding IntegrationSettings.IntgrStatus, Mode=TwoWay}"
                            Style="{DynamicResource Switch}" />
                    </Grid>
                </Border>
            </ListBoxItem>
            <ListBoxItem Name="WindowActivityItem" Opacity="{Binding IntegrationDisplay.WindowOpacity}">
                <Border Margin="5,0,5,5" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="DarkSlateBlue" />
                            <GradientStop Offset="1" Color="{StaticResource AccentDeepPurpleColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="5"
                            Direction="-23"
                            RenderingBias="Performance"
                            ShadowDepth="0"
                            Color="DarkBlue" />
                    </Border.Effect>
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Margin="4"
                            Effect="{StaticResource ImageShadowEffect}"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Img/Icons/WindowActivity_ico.png" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel
                                Margin="0,3,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Effect="{StaticResource TextBlockShadowEffect}"
                                    FontFamily="Comfortaa Light"
                                    FontSize="20"
                                    Foreground="White"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="Window activity"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,3,0,0"
                                Effect="{StaticResource TextBlockShadowEffect}"
                                FontFamily="Comfortaa Light"
                                FontSize="13"
                                RenderTransformOrigin="0.5,0.5"
                                Text="With this integration, you can show if you're in VR or desktop mode, and in desktop mode, it displays the currently focused application."
                                TextWrapping="Wrap">
                                <TextBlock.Foreground>
                                    <RadialGradientBrush>
                                        <GradientStop Color="White" />
                                        <GradientStop Offset="1" Color="{StaticResource AccentLightPurpleColor}" />
                                    </RadialGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="0,5,0,0"
                            VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Command="{Binding ActivateSettingCommand}"
                                    CommandParameter="Settings_WindowActivity"
                                    Style="{StaticResource CustomizePillButton}" />
                                <ToggleButton
                                    Width="60"
                                    Height="19"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Content="DESKTOP"
                                    IsChecked="{Binding IntegrationSettings.IntgrWindowActivity_DESKTOP, Mode=TwoWay}"
                                    Style="{StaticResource GlowyToggleButtonDT}" />
                                <ToggleButton
                                    Width="30"
                                    Height="19"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Content="VR"
                                    IsChecked="{Binding IntegrationSettings.IntgrWindowActivity_VR, Mode=TwoWay}"
                                    Style="{StaticResource GlowyToggleButtonVR}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,3,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <ToggleButton
                                    Width="57"
                                    Height="19"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Content="Force VR"
                                    IsChecked="{Binding IntegrationSettings.IntgrScanForce, Mode=TwoWay}"
                                    Style="{StaticResource GlowyToggleButton}"
                                    Visibility="{Binding IntegrationSettings.IntgrWindowActivity_VR, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox
                            Name="WindowActivity_switch"
                            Grid.Column="3"
                            Margin="5,0,5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="Update_Click"
                            IsChecked="{Binding IntegrationSettings.IntgrScanWindowActivity, Mode=TwoWay}"
                            Style="{DynamicResource Switch}" />
                    </Grid>
                </Border>
            </ListBoxItem>
            <ListBoxItem Name="HeartRateItem" Opacity="{Binding IntegrationDisplay.HeartRateOpacity}">
                <Border Margin="5,0,5,5" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="DarkSlateBlue" />
                            <GradientStop Offset="1" Color="{StaticResource AccentDeepPurpleColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="5"
                            Direction="-23"
                            RenderingBias="Performance"
                            ShadowDepth="0"
                            Color="DarkBlue" />
                    </Border.Effect>
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Margin="4"
                            Effect="{StaticResource ImageShadowEffect}"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="/Img/Icons/HeartRate_ico.png" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <Grid Margin="0,3,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Effect="{StaticResource TextBlockShadowEffect}"
                                    FontFamily="Comfortaa Light"
                                    FontSize="20"
                                    Foreground="White"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="Pulsoid Heart Rate"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <Border Visibility="{Binding Modules.Pulsoid.PulsoidAccessError, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Effect="{StaticResource TextBlockShadowEffect}"
                                            FontFamily="Comfortaa Light"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="LightSeaGreen"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            Text="No device connected"
                                            Visibility="{Binding Modules.Pulsoid.PulsoidDeviceOnline, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                    </Border>
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        Effect="{StaticResource TextBlockShadowEffect}"
                                        FontFamily="Comfortaa Light"
                                        FontSize="12"
                                        Foreground="PaleVioletRed"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Text="Something went wrong, check settings"
                                        Visibility="{Binding Modules.Pulsoid.PulsoidAccessError, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Visibility="{Binding Modules.Pulsoid.PulsoidAccessError, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBlock
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            Effect="{StaticResource TextBlockShadowEffect}"
                                            FontFamily="Comfortaa Light"
                                            FontSize="12"
                                            Foreground="#ABA4B8"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            Text="{Binding Modules.Pulsoid.HeartRateLastUpdate, StringFormat='{}{0:T}'}"
                                            Visibility="{Binding IntegrationSettings.IntgrHeartRate, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                    </Border>
                                    <Border
                                        x:Name="MainDiscoundButton_grid"
                                        Width="auto"
                                        Height="20"
                                        Margin="11,0,0,0"
                                        CornerRadius="5"
                                        Cursor="Hand"
                                        MouseUp="MainDiscoundButton_grid_MouseUp">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#3FE0D2" />
                                                <GradientStop Offset="0.35" Color="#6E9BFF" />
                                                <GradientStop Offset="0.65" Color="#B96BFF" />
                                                <GradientStop Offset="1" Color="#FF6FC7" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Border.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            BeginTime="0:0:0.4"
                                                            Storyboard.TargetName="discountBadgeSheenClip"
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="0"
                                                            To="1"
                                                            Duration="0:0:0.06" />
                                                        <DoubleAnimation
                                                            BeginTime="0:0:0.4"
                                                            Storyboard.TargetName="discountBadgeSheen"
                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                            From="-24"
                                                            To="120"
                                                            Duration="0:0:0.75" />
                                                        <DoubleAnimation
                                                            BeginTime="0:0:1.15"
                                                            Storyboard.TargetName="discountBadgeSheenClip"
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="1"
                                                            To="0"
                                                            Duration="0:0:0.1" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <Border
                                                x:Name="discountBadgeSheenClip"
                                                Panel.ZIndex="2"
                                                ClipToBounds="True"
                                                CornerRadius="5"
                                                IsHitTestVisible="False"
                                                Opacity="0">
                                                <Border
                                                    x:Name="discountBadgeSheen"
                                                    Width="18"
                                                    HorizontalAlignment="Left">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Offset="0" Color="#00FFFFFF" />
                                                            <GradientStop Offset="0.5" Color="#C4FFFFFF" />
                                                            <GradientStop Offset="1" Color="#00FFFFFF" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.LayoutTransform>
                                                        <SkewTransform AngleX="-20" />
                                                    </Border.LayoutTransform>
                                                    <Border.RenderTransform>
                                                        <TranslateTransform X="-24" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>

                                            <Border
                                                Panel.ZIndex="3"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                IsHitTestVisible="False"
                                                SnapsToDevicePixels="True">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#8FF4E8" />
                                                        <GradientStop Offset="0.5" Color="#C9A6FF" />
                                                        <GradientStop Offset="1" Color="#FFA8DF" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                            </Border>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Padding="6,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13.5"
                                                    FontWeight="Bold"
                                                    Foreground="#12002E"
                                                    Text="-15%" />
                                                <TextBlock
                                                    Padding="2,1,4,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    Foreground="#2A1650"
                                                    Text="always" />
                                            </StackPanel>
                                        </Grid>

                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="15"
                                                Opacity="1"
                                                RenderingBias="Performance"
                                                ShadowDepth="0"
                                                Color="#8FD6FF" />
                                        </Border.Effect>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock
                                Margin="0,3,0,0"
                                Effect="{StaticResource TextBlockShadowEffect}"
                                FontFamily="Comfortaa Light"
                                FontSize="13"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Text="This integration displays your heart rate in the chatbox and can send it to OSC, similar to the retired 'HRtoVRChat.' Compatible only with Pulsoid."
                                TextWrapping="Wrap">
                                <TextBlock.Foreground>
                                    <RadialGradientBrush>
                                        <GradientStop Color="White" />
                                        <GradientStop Offset="1" Color="{StaticResource AccentLightPurpleColor}" />
                                    </RadialGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="0,5,0,0"
                            VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Margin="0,0,5,0"
                                    Command="{Binding ActivateSettingCommand}"
                                    CommandParameter="Settings_HeartRate"
                                    Style="{StaticResource CustomizePillButton}" />
                                <ToggleButton
                                    Width="60"
                                    Height="19"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Content="DESKTOP"
                                    IsChecked="{Binding IntegrationSettings.IntgrHeartRate_DESKTOP, Mode=TwoWay}"
                                    Style="{StaticResource GlowyToggleButtonDT}" />
                                <ToggleButton
                                    Width="30"
                                    Height="19"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Content="VR"
                                    IsChecked="{Binding IntegrationSettings.IntgrHeartRate_VR, Mode=TwoWay}"
                                    Style="{StaticResource GlowyToggleButtonVR}" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,3,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <ToggleButton
                                    Width="30"
                                    Height="19"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Content="OSC"
                                    IsChecked="{Binding IntegrationSettings.IntgrHeartRate_OSC, Mode=TwoWay}"
                                    Style="{StaticResource GlowyToggleButton}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox
                            Name="NewHR_Switch"
                            Grid.Column="3"
                            Margin="5,0,5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="Update_Click"
                            IsChecked="{Binding IntegrationSettings.IntgrHeartRate, Mode=TwoWay}"
                            Style="{DynamicResource Switch}" />
                    </Grid>
                </Border>
            </ListBoxItem>
            <ListBoxItem Name="TrackerBatteryItem" Opacity="{Binding IntegrationDisplay.TrackerBatteryOpacity}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="1"
                        Margin="10,-15,10,5"
                        Background="#230E52"
                        CornerRadius="0,0,5,5"
                        Visibility="{Binding IntegrationSettings.IntgrTrackerBattery, Converter={StaticResource InverseBoolToHiddenConverter}}">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="5"
                                Direction="-23"
                                RenderingBias="Performance"
                                ShadowDepth="0"
                                Color="DarkBlue" />
                        </Border.Effect>
                        <Border Margin="5,15,5,5" CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="DarkSlateBlue" />
                                    <GradientStop Offset="1" Color="{StaticResource AccentDeepPurpleColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Comfortaa Light"
                                        FontSize="13"
                                        Foreground="{StaticResource TextSectionHeaderBrush}"
                                        Text="Active devices" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Albert Sans Thin"
                                        FontSize="14"
                                        Foreground="{StaticResource BorderMutedBrush}"
                                        Text="{Binding IntegrationDisplay.TrackerBatteryDeviceSummary}" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Albert Sans Thin"
                                        FontSize="13"
                                        Foreground="{StaticResource BorderMutedBrush}"
                                        Text="{Binding TrackerBattery_LastScanDisplay}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Tracker.TrackerBatteryActiveDevices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="2"
                                                Padding="6,3"
                                                Background="#2A000000"
                                                CornerRadius="4"
                                                Opacity="{Binding IsConnected, Converter={StaticResource BoolToOpacityConverter}}">

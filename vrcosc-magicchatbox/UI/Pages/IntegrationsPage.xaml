<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.IntegrationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls.Voicemod"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    d:DataContext="{d:DesignInstance Type=vm:IntegrationsPageViewModel,
                                     IsDesignTimeCreatable=False}"
    Background="{StaticResource SurfaceCardBrush}"
    mc:Ignorable="d po">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Local to this page on purpose: Theme.xaml is owned elsewhere this cycle. Candidates
                  for promotion once it is free - see the ribbon's other raw hex.  -->
            <Style
                x:Key="LyricsNudgeButton"
                BasedOn="{StaticResource Status_Button_style}"
                TargetType="Button">
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="50" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
            </Style>

            <!--  The ToggleButton twin of CustomizePillButton: same height and radius so the ribbon row
                  does not change height, plus a checked state so an open flyout is obvious.  -->
            <Style x:Key="LyricsFlyoutToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#FF2C2148" />
                <Setter Property="Foreground" Value="{StaticResource TextLightPurpleBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
                <Setter Property="Padding" Value="10,3,8,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="pill"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="#FF3A2D5A" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="#FF44357A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="LyricsRibbonTemplate">
                <Border
                    x:Name="LyricsRibbonRoot"
                    Margin="5,0,5,5"
                    Padding="10,7"
                    BorderBrush="#3A2A66"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsVisibleChanged="LyricsRibbonRoot_IsVisibleChanged"
                    Loaded="LyricsRibbonRoot_Loaded"
                    Unloaded="LyricsRibbonRoot_Unloaded">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#221740" />
                            <GradientStop Offset="1" Color="#1A0F30" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="2,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            Foreground="{StaticResource TileDescriptionBrush}"
                            Text="♪" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                d:Text="It's because"
                                FontFamily="/Fonts/#Comfortaa"
                                FontSize="14"
                                Foreground="White"
                                Text="{Binding LyricsDisplay.CurrentLine}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{Binding LyricsDisplay.IsShowingLine, Converter={StaticResource InverseBoolToHiddenConverter}}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                d:Text="56 lines from LRCLIB"
                                FontFamily="/Fonts/#Albert Sans"
                                FontSize="11"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="{Binding LyricsDisplay.StatusText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!--  Sync offset is the knob reached for mid-song; gap and hold behind the flyout
                              are set once, so the ribbon spends its width on this one.

                              The stepper is LyricsOffsetRowTemplate in Theme.xaml. Its DataContext
                              contract is a LyricsSectionViewModel, which LyricsTuning is, so it goes in
                              as the ContentControl's Content.  -->
                        <StackPanel
                            Grid.Column="2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ContentControl Content="{Binding LyricsTuning}" ContentTemplate="{StaticResource LyricsOffsetRowTemplate}" />
                        </StackPanel>

                        <Grid
                            Grid.Column="3"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                            <ToggleButton x:Name="LyricsSyncToggle" Style="{StaticResource LyricsFlyoutToggle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Timing" />
                                    <!--  The warning is about gap and hold, so it follows them in here.  -->
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        Foreground="#FFFFC46B"
                                        Text="⚠"
                                        ToolTip="{Binding LyricsTuning.TimingWarning}"
                                        Visibility="{Binding LyricsTuning.HasTimingWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <!--  No Opacity here. At 0.7 the chevron fell to 4.18:1 against the
                                          CHECKED pill - i.e. exactly while the flyout is open. Full
                                          opacity is 6.74:1 checked / 9.68:1 unchecked, and the glyph is
                                          small enough that it still reads as secondary.  -->
                                    <TextBlock Margin="5,0,0,0" Text="▾" />
                                </StackPanel>
                            </ToggleButton>

                            <!--  IsOpen is bound straight to this instance's toggle rather than to a VM
                                  flag. The template is instantiated twice - once on the Spotify card and
                                  once on Media link - so a shared VM bool would open both at once, and
                                  the collapsed one would flash its popup over the page.  -->
                            <Popup
                                AllowsTransparency="True"
                                DataContext="{Binding DataContext, ElementName=LyricsSyncToggle}"
                                IsOpen="{Binding IsChecked, ElementName=LyricsSyncToggle, Mode=TwoWay}"
                                Placement="Bottom"
                                PlacementTarget="{Binding ElementName=LyricsRibbonRoot}"
                                PopupAnimation="Slide"
                                StaysOpen="False">
                                <!--  Sized to the ribbon so the card right-aligns with no magic offsets.
                                      The card no longer paints outside its own bounds, so the margin
                                      below is plain spacing, not blur headroom, and no offsets are
                                      needed to compensate for it.  -->
                                <Grid Width="{Binding ActualWidth, ElementName=LyricsRibbonRoot}">
                                    <Border
                                        MinWidth="330"
                                        Margin="0,2,2,2"
                                        Padding="12,10"
                                        HorizontalAlignment="Right"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#FF221D38" />
                                                <GradientStop Offset="1" Color="#FF1A1630" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#FF4A3580" />
                                                <GradientStop Offset="1" Color="#FF2D2050" />
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>

                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontFamily="/Fonts/#Comfortaa"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource TextSectionHeaderBrush}"
                                                Text="Instrumental breaks" />
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontFamily="/Fonts/#Albert Sans"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="Gap is how much silence counts as a break. Hold is how long the last line stays up before the ♪ marker takes over."
                                                TextWrapping="Wrap" />

                                            <ContentControl Content="{Binding LyricsTuning}" ContentTemplate="{StaticResource LyricsTimingRowTemplate}" />

                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontFamily="/Fonts/#Albert Sans"
                                                FontSize="{StaticResource FontSizeMicro}"
                                                Foreground="#FFFFC46B"
                                                Text="{Binding LyricsTuning.TimingWarning}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding LyricsTuning.HasTimingWarning, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <Separator Margin="0,12,0,10" Background="{StaticResource SurfaceVariantBrush}" />

                                            <TextBlock
                                                Margin="0,0,0,2"
                                                FontFamily="/Fonts/#Comfortaa"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource TextSectionHeaderBrush}"
                                                Text="Sync offset" />
                                            <!--  The 100 ms steps are out on the ribbon now, so this row is
                                                  only the coarse moves and the way back to the default.  -->
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                FontFamily="/Fonts/#Albert Sans"
                                                FontSize="{StaticResource FontSizeCaption}"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="Bigger jumps than the ± on the ribbon, for when the words are out by a whole second. − makes them wait, + brings them forward."
                                                TextWrapping="Wrap" />

                                            <StackPanel Orientation="Horizontal">
                                                <Button
                                                    Command="{Binding LyricsTuning.NudgeOffsetCommand}"
                                                    CommandParameter="-1000"
                                                    Content="−1 s"
                                                    Style="{StaticResource LyricsNudgeButton}" />
                                                <Button
                                                    Command="{Binding LyricsTuning.ResetOffsetCommand}"
                                                    Content="Reset"
                                                    Style="{StaticResource LyricsNudgeButton}"
                                                    ToolTip="Back to the +100 ms the app ships with." />
                                                <Button
                                                    Command="{Binding LyricsTuning.NudgeOffsetCommand}"
                                                    CommandParameter="1000"
                                                    Content="+1 s"
                                                    Style="{StaticResource LyricsNudgeButton}" />
                                            </StackPanel>

                                            <TextBlock
                                                Margin="0,8,0,0"
                                                d:Text="Lyrics run 300 ms early"
                                                FontFamily="/Fonts/#Albert Sans"
                                                FontSize="{StaticResource FontSizeMicro}"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="{Binding LyricsTuning.OffsetSummary}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <Button
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Command="{Binding ActivateSettingCommand}"
                            CommandParameter="Settings_Lyrics"
                            Content="Tune ›"
                            Style="{StaticResource CustomizePillButton}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Two reasons an integration you switched on is not in the chatbox: its mode switch, or no
              room left in the line. They were reported in two different places and two different
              sizes - one a bordered slab here, one a full-width bar on the main window that never
              said which integration it meant. Same strip now, one line each, sized like the chips on
              the tiles rather than like a dialog.  -->
        <StackPanel Grid.Row="0" Margin="12,4,19,2">
            <Border
                Padding="8,3"
                HorizontalAlignment="Left"
                Background="#26FFFFFF"
                CornerRadius="5"
                SnapsToDevicePixels="True"
                Visibility="{Binding HasModeVisibilityWarning, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Text="👁" />
                    <TextBlock
                        VerticalAlignment="Center"
                        d:Text="Enabled but not shown in VR mode: Network Statistics."
                        FontFamily="/Fonts/#Albert Sans"
                        FontSize="11"
                        Foreground="{StaticResource DeckTextBrush}"
                        Text="{Binding ModeVisibilityWarning, UpdateSourceTrigger=PropertyChanged}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ModeVisibilityWarning}" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,3,0,0"
                Padding="8,3"
                HorizontalAlignment="Left"
                Background="#3FFFC46B"
                CornerRadius="5"
                SnapsToDevicePixels="True"
                Visibility="{Binding HasTrimmedWarning, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Text="✂" />
                    <TextBlock
                        VerticalAlignment="Center"
                        d:Text="No room in the 144 characters for Discord and Weather."
                        FontFamily="/Fonts/#Albert Sans"
                        FontSize="11"
                        Foreground="#FFFFD79A"
                        Text="{Binding TrimmedWarning, UpdateSourceTrigger=PropertyChanged}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding TrimmedWarning}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <ListBox
            x:Name="IntegrationsList"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            RenderOptions.BitmapScalingMode="NearestNeighbor"
            ScrollViewer.CanContentScroll="False"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border
                                    x:Name="itemHost"
                                    Padding="3,0,3,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <!--
                Hidden tiles. Lives inside the list as its first item so it scrolls away with the
                content instead of permanently occupying the top of the page. Compact by design: one
                wrapping row, and collapsible to a single pill.
            -->
            <ListBoxItem
                x:Name="HiddenStripItem"
                Focusable="False"
                Visibility="{Binding HasHiddenTiles, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                <Border
                    Margin="5,0,5,6"
                    BorderBrush="#3A2F63"
                    BorderThickness="1"
                    CornerRadius="6"
                    SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#4A2E1F5C" />
                            <GradientStop Offset="1" Color="#242B1B4A" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--
                            A thin iridescent rail, borrowing the Lyrics palette so this reads as part of
                            the same family without shouting.
                        -->
                        <Border
                            Grid.Column="0"
                            Width="2"
                            Margin="5,5,0,5"
                            CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="#3FE0D2" />
                                    <GradientStop Offset="0.5" Color="#6E9BFF" />
                                    <GradientStop Offset="1" Color="#B96BFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <WrapPanel
                            Grid.Column="1"
                            Margin="7,3,6,3"
                            Orientation="Horizontal">

                            <ToggleButton
                                VerticalAlignment="Center"
                                Content="{Binding HiddenSummary, UpdateSourceTrigger=PropertyChanged}"
                                IsChecked="{Binding IntegrationSettings.HiddenStripCollapsed, Mode=TwoWay}"
                                Style="{StaticResource HiddenStripToggle}"
                                ToolTip="Show or hide this list of hidden tiles." />

                            <ItemsControl
                                VerticalAlignment="Center"
                                ItemsSource="{Binding HiddenChips}"
                                Visibility="{Binding HiddenChipsVisible, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.ShowTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Key}"
                                            Style="{StaticResource HiddenTileChipButton}"
                                            ToolTip="{Binding ToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <!--  Filled = still switched on and running, hollow = switched off.  -->
                                                <Ellipse
                                                    Width="5"
                                                    Height="5"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Stroke="#9C8DC4"
                                                    StrokeThickness="1">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="#7BE495" />
                                                                    <Setter Property="Stroke" Value="#7BE495" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding DisplayName}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border
                                Width="1"
                                Margin="3,5,5,5"
                                Background="#3F3363"
                                Visibility="{Binding HiddenChipsVisible, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                VerticalAlignment="Center"
                                Command="{Binding ShowAllTilesCommand}"
                                Content="Show all"
                                Style="{StaticResource HiddenTileActionButton}"
                                Visibility="{Binding ShowAllActionVisible, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                VerticalAlignment="Center"
                                Command="{Binding TidySwitchedOffCommand}"
                                Content="{Binding TidySwitchedOffLabel, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource HiddenTileActionButton}"
                                Visibility="{Binding TidySwitchedOffVisible, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                VerticalAlignment="Center"
                                Command="{Binding TidyModeUnavailableCommand}"
                                Content="{Binding TidyModeUnavailableLabel, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource HiddenTileActionButton}"
                                Visibility="{Binding TidyModeUnavailableVisible, Converter={StaticResource BoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />

                        </WrapPanel>
                    </Grid>
                </Border>
            </ListBoxItem>

            <ListBoxItem Name="StatusItem" Opacity="{Binding IntegrationDisplay.StatusOpacity}">
                <Border
                    Margin="5"
                    Background="{StaticResource TileSurfaceBrush}"
                    CornerRadius="5"
                    BorderBrush="#FF150C33"
                    BorderThickness="1">
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  Lit while this integration is actually in the line VRChat is receiving - not merely
                                  switched on. Switched on but contributing nothing, routed away by its
                                  desktop/VR chips, or trimmed to fit the 144 characters all read as dark,
                                  so the rail answers "is this reaching the chatbox right now".  -->
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Margin="-3,-3,0,-3"
                            HorizontalAlignment="Left"
                            CornerRadius="5,0,0,5"
                            IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1AFFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IntegrationDisplay.LiveOutputKeys, Converter={StaticResource CollectionContainsConverter}, ConverterParameter=Status}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                        <GradientStop Offset="0" Color="#3FE0D2" />
                                                        <GradientStop Offset="1" Color="#B96BFF" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Border
                            Grid.Column="0"
                            Width="50"
                            Height="50"
                            Margin="6,4,6,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource TileIconFrameBrush}"
                            BorderBrush="{StaticResource TileIconFrameBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                            <Grid Margin="4">
                                <Image
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="/Img/Icons/PersonalMsg_ico.png" />
                            </Grid>
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center">
                            <StackPanel
                                Margin="0,3,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TileTitleStyle}" Text="Personal status" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource TileDescriptionStyle}" Text="Say whatever you want. Save a pile of messages, cycle them, and drop to AFK when you wander off." />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource TileControlDeck}">
                            <StackPanel Style="{StaticResource DeckOutputRow}">
                                <ToggleButton IsChecked="{Binding IntegrationSettings.IntgrStatus_DESKTOP, Mode=TwoWay}" Style="{StaticResource RouteChipDesktop}" />
                                <ToggleButton IsChecked="{Binding IntegrationSettings.IntgrStatus_VR, Mode=TwoWay}" Style="{StaticResource RouteChipVr}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource DeckChromeRow}">
                                <Button
                                    AutomationProperties.Name="Hide this tile"
                                    Click="HideTile_Click"
                                    Style="{StaticResource TileHideButton}"
                                    ToolTip="Hide this tile from the list. The integration stays switched on." />
                                <Button
                                    Command="{Binding ActivateSettingCommand}"
                                    CommandParameter="Settings_Status"
                                    Style="{StaticResource TileDoorButton}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox
                            Name="Status_switch"
                            Grid.Column="3"
                            Margin="5,0,5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="Update_Click"
                            IsChecked="{Binding IntegrationSettings.IntgrStatus, Mode=TwoWay}"
                            Style="{DynamicResource Switch}" />
                    </Grid>
                </Border>
            </ListBoxItem>
            <ListBoxItem Name="WindowActivityItem" Opacity="{Binding IntegrationDisplay.WindowOpacity}">
                <Border
                    Margin="5,0,5,5"
                    Background="{StaticResource TileSurfaceBrush}"
                    CornerRadius="5"
                    BorderBrush="#FF150C33"
                    BorderThickness="1">
                    <Grid Margin="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--  Lit while this integration is actually in the line VRChat is receiving - not merely
                                  switched on. Switched on but contributing nothing, routed away by its
                                  desktop/VR chips, or trimmed to fit the 144 characters all read as dark,
                                  so the rail answers "is this reaching the chatbox right now".  -->
                        <Border
                            Grid.Column="0"
                            Width="3"
                            Margin="-3,-3,0,-3"
                            HorizontalAlignment="Left"
                            CornerRadius="5,0,0,5"
                            IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1AFFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IntegrationDisplay.LiveOutputKeys, Converter={StaticResource CollectionContainsConverter}, ConverterParameter=Window}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                        <GradientStop Offset="0" Color="#3FE0D2" />
                                                        <GradientStop Offset="1" Color="#B96BFF" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Border
                            Grid.Column="0"
                            Width="50"
                            Height="50"
                            Margin="6,4,6,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource TileIconFrameBrush}"
                            BorderBrush="{StaticResource TileIconFrameBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                            <Grid Margin="4">
                                <Image
                                    RenderOptions.BitmapScalingMode="HighQuality"

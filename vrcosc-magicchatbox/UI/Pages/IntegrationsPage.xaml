                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#8FF4E8" />
                                                        <GradientStop Offset="0.5" Color="#C9A6FF" />
                                                        <GradientStop Offset="1" Color="#FFA8DF" />
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                            </Border>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    Padding="6,1,0,0"

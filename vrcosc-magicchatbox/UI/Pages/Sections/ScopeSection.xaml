<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Sections.ScopeSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DesignWidth="640"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Fully qualified rather than the rooted "/UI/..." form: the rooted form resolves
                    against the entry assembly, which makes the control unloadable from a test host.
                -->
                <ResourceDictionary Source="pack://application:,,,/MagicChatbox;component/UI/Resources/SharedConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Colour carries the same thing the words do, never it alone.  -->
            <Style
                x:Key="VerdictPillStyle"
                BasedOn="{StaticResource TileStatusPill}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LiveVerdict}" Value="allowing it">
                        <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LiveVerdict}" Value="holding it off">
                        <Setter Property="Foreground" Value="{StaticResource TextAccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LiveVerdict}" Value="settling">
                        <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>

        <!--  A guard reads as a sentence first and is a form second. The editor is a disclosure, so a
              list of ten guards is ten lines you can scan rather than ten forms you have to.  -->

        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource OptionSubsectionHeaderStyle}"
                Text="When things are allowed to run" />

            <CheckBox
                Grid.Column="1"
                VerticalAlignment="Center"
                IsChecked="{Binding ScopeEnabled, Mode=TwoWay}"
                Style="{StaticResource SettingsCheckbox}"
                ToolTip="Switch every guard off at once without deleting any of them.">
                Guards on
            </CheckBox>
        </Grid>

        <TextBlock
            Margin="2,0,0,10"
            Style="{StaticResource OptionHelpTextStyle}"
            Text="A guard narrows when something you have already switched on is allowed to run. It can hold something off; it can never switch on something you left off."
            TextWrapping="Wrap" />

        <!--  Empty state. A bare list with an Add button teaches nobody what a guard is.  -->
        <Border
            Padding="14"
            Style="{StaticResource OptionNestedCardStyle}"
            Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource TileTitleStyle}"
                    Text="Nothing is guarded yet"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource OptionHelpTextStyle}"
                    Text="Pick one of the ready-made guards below to see the shape of it — they all arrive switched off, so nothing changes until you say so."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ItemsControl x:Name="ScopeRuleList" ItemsSource="{Binding Rules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type sections:ScopeRuleRowViewModel}">
                    <Border Margin="0,0,0,6" Padding="12,10" Style="{StaticResource OptionNestedCardStyle}">
                        <StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                                    Style="{StaticResource SettingsCheckbox}"
                                    ToolTip="Switch this guard on." />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource TileTitleStyle}"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource VerdictPillStyle}"
                                    Text="{Binding LiveVerdict}" />

                                <Button
                                    Grid.Column="3"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding ToggleEditingCommand}"
                                    Content="Edit"
                                    Style="{StaticResource CustomizePillButton}" />
                            </Grid>

                            <TextBlock
                                Margin="26,4,0,0"
                                Style="{StaticResource TileDescriptionStyle}"
                                Text="{Binding Sentence}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="26,4,0,0"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="{Binding Problems}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!--  The form, only once somebody has asked for it.  -->
                            <StackPanel
                                Margin="26,10,0,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">

                                <TextBox
                                    Margin="0,0,0,8"
                                    Style="{StaticResource LightInputTextBox}"
                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                    ToolTip="What you will call this guard." />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource OptionFieldLabelStyle}"
                                        Text="Guards" />
                                    <ComboBox
                                        Grid.Column="1"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding Targets}"
                                        SelectedItem="{Binding Target, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource OptionFieldLabelStyle}"
                                        Text="only while" />
                                    <ComboBox
                                        Grid.Column="1"
                                        MinWidth="70"
                                        ItemsSource="{Binding Joins}"
                                        SelectedItem="{Binding Join, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource OptionHelpTextStyle}"
                                        Text="of these are true" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Predicates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type sections:ScopePredicateRowViewModel}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" MinWidth="90" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ComboBox
                                                    Grid.Column="0"
                                                    DisplayMemberPath="Label"
                                                    ItemsSource="{Binding Facts}"
                                                    SelectedItem="{Binding Fact, Mode=TwoWay}" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    MinWidth="96"
                                                    Margin="4,0"
                                                    DisplayMemberPath="Label"
                                                    ItemsSource="{Binding Operators}"
                                                    SelectedItem="{Binding Operator, Mode=TwoWay}" />
                                                <TextBox
                                                    Grid.Column="2"
                                                    IsEnabled="{Binding NeedsValue}"
                                                    Style="{StaticResource LightInputTextBox}"
                                                    Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                                <Button
                                                    Grid.Column="3"
                                                    Width="26"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding DataContext.RemoveTestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="−"
                                                    Style="{StaticResource Status_Button_style}"
                                                    ToolTip="Remove this test." />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Style="{StaticResource OptionActionRowStyle}">
                                    <Button
                                        Command="{Binding AddTestCommand}"
                                        Content="Add a test"
                                        Style="{StaticResource CustomizePillButton}" />
                                    <Button
                                        Margin="6,0,0,0"
                                        Command="{Binding UseCurrentAvatarCommand}"
                                        Content="The avatar I'm wearing"
                                        Style="{StaticResource CustomizePillButton}" />
                                    <Button
                                        Margin="6,0,0,0"
                                        Command="{Binding UseCurrentWorldCommand}"
                                        Content="The world I'm in"
                                        Style="{StaticResource CustomizePillButton}" />
                                </StackPanel>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource OptionHelpTextStyle}"
                                        Text="Wait" />
                                    <TextBox
                                        Grid.Column="1"
                                        Width="44"
                                        Margin="6,0"
                                        Style="{StaticResource LightInputTextBox}"
                                        Text="{Binding DwellSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource OptionHelpTextStyle}"
                                        Text="seconds before acting on a change" />
                                </Grid>

                                <CheckBox
                                    Margin="0,8,0,0"
                                    IsChecked="{Binding BlockWhileUnknown, Mode=TwoWay}"
                                    Style="{StaticResource SettingsCheckbox}"
                                    ToolTip="Leave this off unless the guard exists for privacy. A guard only narrows, so &quot;we cannot tell yet&quot; is normally not a reason to override your own switch.">
                                    If we can't tell, keep it off
                                </CheckBox>

                                <StackPanel Style="{StaticResource OptionActionRowStyle}">
                                    <Button
                                        Command="{Binding ToggleEditingCommand}"
                                        Content="Done"
                                        Style="{StaticResource CustomizePillButton}" />
                                    <Button
                                        Margin="6,0,0,0"
                                        Command="{Binding DeleteCommand}"
                                        Content="Remove this guard"
                                        Style="{StaticResource Status_Button_style}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox
                Grid.Column="0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding ReadyMade}"
                SelectedItem="{Binding SelectedReadyMade, Mode=TwoWay}"
                ToolTip="Ready-made guards. Each arrives switched off." />
            <Button
                Grid.Column="1"
                Margin="6,0,0,0"
                Command="{Binding AddReadyMadeCommand}"
                Content="Add"
                Style="{StaticResource CustomizePillButton}" />
            <Button
                Grid.Column="2"
                Margin="6,0,0,0"
                Command="{Binding AddBlankRuleCommand}"
                Content="Start from scratch"
                Style="{StaticResource CustomizePillButton}" />
        </Grid>

        <TextBlock
            Margin="2,6,0,0"
            Style="{StaticResource OptionHelpTextStyle}"
            Text="{Binding SelectedReadyMade.Note}"
            TextWrapping="Wrap" />

        <!--  Groups are a named set reused by many guards, so they live behind a disclosure rather
              than taking room from the guards themselves.  -->
        <CheckBox
            Margin="0,14,0,0"
            IsChecked="{Binding ShowGroups, Mode=TwoWay}"
            Style="{StaticResource SettingsCheckbox}">
            Name a set of avatars or worlds
        </CheckBox>

        <StackPanel Visibility="{Binding ShowGroups, Converter={StaticResource BoolToVisibilityConverter}}">

            <TextBlock
                Margin="2,8,0,4"
                Style="{StaticResource OptionFieldLabelStyle}"
                Text="Avatar groups" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Style="{StaticResource LightInputTextBox}"
                    Text="{Binding NewAvatarGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="What to call this set of avatars." />
                <Button
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Command="{Binding AddAvatarGroupCommand}"
                    Content="Add a group"
                    Style="{StaticResource CustomizePillButton}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding AvatarGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource TileDescriptionStyle}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource TileStatusPill}"
                                Text="{Binding AvatarIds.Length, StringFormat={}{0} in it}" />
                            <Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Command="{Binding DataContext.AddWornAvatarToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="Add the one I'm wearing"
                                Style="{StaticResource CustomizePillButton}" />
                            <Button
                                Grid.Column="3"
                                Margin="6,0,0,0"
                                Command="{Binding DataContext.DeleteAvatarGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="Remove"
                                Style="{StaticResource Status_Button_style}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Margin="2,12,0,4"
                Style="{StaticResource OptionFieldLabelStyle}"
                Text="World groups" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Style="{StaticResource LightInputTextBox}"
                    Text="{Binding NewWorldGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="What to call this set of worlds." />
                <Button
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Command="{Binding AddWorldGroupCommand}"
                    Content="Add a group"
                    Style="{StaticResource CustomizePillButton}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding WorldGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource TileDescriptionStyle}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource TileStatusPill}"
                                Text="{Binding WorldIds.Length, StringFormat={}{0} in it}" />
                            <Button
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Command="{Binding DataContext.AddCurrentWorldToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="Add the one I'm in"
                                Style="{StaticResource CustomizePillButton}" />
                            <Button
                                Grid.Column="3"
                                Margin="6,0,0,0"
                                Command="{Binding DataContext.DeleteWorldGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="Remove"
                                Style="{StaticResource Status_Button_style}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock
            Margin="2,10,0,0"
            Style="{StaticResource OptionHelpTextStyle}"
            Text="{Binding Status}"
            TextWrapping="Wrap" />

    </StackPanel>
</UserControl>

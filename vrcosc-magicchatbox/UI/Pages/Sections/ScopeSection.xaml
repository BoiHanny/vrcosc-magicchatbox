<UserControl
    x:Class="vrcosc_magicchatbox.UI.Pages.Sections.ScopeSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sections="clr-namespace:vrcosc_magicchatbox.ViewModels.Sections"
    d:DesignWidth="700"
    mc:Ignorable="d">

    <StackPanel>

        <TextBlock
            Margin="0,0,0,4"
            Style="{StaticResource OptionFieldLabelStyle}"
            Text="Guards" />
        <TextBlock
            Margin="0,0,0,8"
            Style="{StaticResource OptionHelpTextStyle}"
            Text="A guard says when something you have already switched on may actually run — while you are wearing a certain avatar, outside public instances, and so on. A guard can only ever narrow: it never switches on something you left off."
            TextWrapping="Wrap" />

        <CheckBox Margin="0,0,0,8" IsChecked="{Binding ScopeEnabled, Mode=TwoWay}">
            Let guards decide
        </CheckBox>

        <!--  Ready-made guards are offered rather than seeded into the user's own list: written to disk
              on first launch, their wording would freeze on that day and no release could fix one.  -->
        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
            <ComboBox
                Width="260"
                DisplayMemberPath="Name"
                ItemsSource="{Binding ReadyMade}"
                SelectedItem="{Binding SelectedReadyMade, Mode=TwoWay}" />
            <Button
                Margin="6,0,0,0"
                Command="{Binding AddReadyMadeCommand}"
                Content="Add this one"
                Style="{StaticResource Status_Button_style}" />
            <Button
                Margin="6,0,0,0"
                Command="{Binding AddBlankRuleCommand}"
                Content="Start from scratch"
                Style="{StaticResource Status_Button_style}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Rules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type sections:ScopeRuleRowViewModel}">
                    <Border
                        Margin="0,0,0,8"
                        Padding="8"
                        Style="{StaticResource OptionCardStyle}">
                        <StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                <TextBox
                                    Width="220"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="{Binding LiveVerdict}" />
                                <Button
                                    Margin="10,0,0,0"
                                    Command="{Binding DeleteCommand}"
                                    Content="Remove"
                                    Style="{StaticResource Status_Button_style}" />
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="Guards" />
                                <ComboBox
                                    Width="200"
                                    Margin="6,0,0,0"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding Targets}"
                                    SelectedItem="{Binding Target, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="when" />
                                <ComboBox
                                    Width="80"
                                    Margin="6,0,0,0"
                                    ItemsSource="{Binding Joins}"
                                    SelectedItem="{Binding Join, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="of these hold" />
                            </StackPanel>

                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Predicates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type sections:ScopePredicateRowViewModel}">
                                        <StackPanel Margin="0,2" Orientation="Horizontal">
                                            <ComboBox
                                                Width="220"
                                                DisplayMemberPath="Label"
                                                ItemsSource="{Binding Facts}"
                                                SelectedItem="{Binding Fact, Mode=TwoWay}" />
                                            <ComboBox
                                                Width="110"
                                                Margin="4,0,0,0"
                                                DisplayMemberPath="Label"
                                                ItemsSource="{Binding Operators}"
                                                SelectedItem="{Binding Operator, Mode=TwoWay}" />
                                            <TextBox
                                                Width="180"
                                                Margin="4,0,0,0"
                                                IsEnabled="{Binding NeedsValue}"
                                                Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                                            <Button
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.RemoveTestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="−"
                                                Style="{StaticResource Status_Button_style}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <Button
                                    Command="{Binding AddTestCommand}"
                                    Content="Add a test"
                                    Style="{StaticResource Status_Button_style}" />
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding UseCurrentAvatarCommand}"
                                    Content="Use the avatar I'm wearing"
                                    Style="{StaticResource Status_Button_style}" />
                                <Button
                                    Margin="6,0,0,0"
                                    Command="{Binding UseCurrentWorldCommand}"
                                    Content="Use the world I'm in"
                                    Style="{StaticResource Status_Button_style}" />
                            </StackPanel>

                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="Wait" />
                                <TextBox
                                    Width="46"
                                    Margin="6,0,0,0"
                                    Text="{Binding DwellSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource OptionHelpTextStyle}"
                                    Text="seconds before acting" />
                                <CheckBox
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding BlockWhileUnknown, Mode=TwoWay}"
                                    ToolTip="Leave this off unless the guard exists for privacy. A guard only narrows, so &quot;we cannot tell yet&quot; is normally not a reason to override your own switch.">
                                    If we can't tell, keep it off
                                </CheckBox>
                            </StackPanel>

                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="{Binding Sentence}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,2,0,0"
                                Style="{StaticResource OptionHelpTextStyle}"
                                Text="{Binding Problems}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            Margin="0,10,0,4"
            Style="{StaticResource OptionFieldLabelStyle}"
            Text="Avatar groups" />
        <TextBlock
            Margin="0,0,0,6"
            Style="{StaticResource OptionHelpTextStyle}"
            Text="A named set of avatars, so one guard can cover all of them."
            TextWrapping="Wrap" />

        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
            <TextBox Width="200" Text="{Binding NewAvatarGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="6,0,0,0"
                Command="{Binding AddAvatarGroupCommand}"
                Content="Add a group"
                Style="{StaticResource Status_Button_style}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding AvatarGroups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="160"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="{Binding Name}" />
                        <TextBlock
                            Width="70"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="{Binding AvatarIds.Length, StringFormat={}{0} in it}" />
                        <Button
                            Command="{Binding DataContext.AddWornAvatarToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="Add the one I'm wearing"
                            Style="{StaticResource Status_Button_style}" />
                        <Button
                            Margin="6,0,0,0"
                            Command="{Binding DataContext.DeleteAvatarGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="Remove"
                            Style="{StaticResource Status_Button_style}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            Margin="0,10,0,4"
            Style="{StaticResource OptionFieldLabelStyle}"
            Text="World groups" />

        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
            <TextBox Width="200" Text="{Binding NewWorldGroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="6,0,0,0"
                Command="{Binding AddWorldGroupCommand}"
                Content="Add a group"
                Style="{StaticResource Status_Button_style}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding WorldGroups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2" Orientation="Horizontal">
                        <TextBlock
                            Width="160"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="{Binding Name}" />
                        <TextBlock
                            Width="70"
                            VerticalAlignment="Center"
                            Style="{StaticResource OptionHelpTextStyle}"
                            Text="{Binding WorldIds.Length, StringFormat={}{0} in it}" />
                        <Button
                            Command="{Binding DataContext.AddCurrentWorldToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="Add the one I'm in"
                            Style="{StaticResource Status_Button_style}" />
                        <Button
                            Margin="6,0,0,0"
                            Command="{Binding DataContext.DeleteWorldGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="Remove"
                            Style="{StaticResource Status_Button_style}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
            Margin="0,8,0,0"
            Style="{StaticResource OptionHelpTextStyle}"
            Text="{Binding Status}"
            TextWrapping="Wrap" />

    </StackPanel>
</UserControl>

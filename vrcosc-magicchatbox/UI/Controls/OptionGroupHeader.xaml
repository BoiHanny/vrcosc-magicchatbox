<UserControl
    x:Class="vrcosc_magicchatbox.UI.Controls.OptionGroupHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignWidth="420"
    mc:Ignorable="d">

    <!--
        A filled bar was the wrong instinct: it read as a selected row, and its edges stopped dead
        wherever the panel happened to end. This is the quieter arrangement - a lit accent, the name,
        and a hairline running out to the right until it fades. Nothing has a hard edge, so nothing
        looks cut off.
    -->
    <Grid Margin="6,26,18,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  The only bright thing in the row, so the eye lands here first.  -->
        <Border
            Grid.Column="0"
            Width="3"
            Height="19"
            VerticalAlignment="Center"
            CornerRadius="2"
            SnapsToDevicePixels="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#FFE6E1FF" />
                    <GradientStop Offset="1" Color="#FF8B7EE8" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="10"
                    Opacity="0.75"
                    ShadowDepth="0"
                    Color="#FFAEA7ED" />
            </Border.Effect>
        </Border>

        <TextBlock
            Grid.Column="1"
            Margin="11,0,14,0"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FontSecondary}"
            FontSize="{StaticResource FontSizeHeading}"
            FontWeight="SemiBold"
            Foreground="White"
            Text="{Binding Title, ElementName=Root}" />

        <!--  Carries the eye across the page and gives up before the edge, so the heading spans the
              width without a line ruled all the way over.  -->
        <Border
            Grid.Column="2"
            Height="1"
            VerticalAlignment="Center"
            SnapsToDevicePixels="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#59AEA7ED" />
                    <GradientStop Offset="0.55" Color="#1FAEA7ED" />
                    <GradientStop Offset="1" Color="#00AEA7ED" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>

<Window
    x:Class="vrcosc_magicchatbox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:vrcosc_magicchatbox.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:vrcosc_magicchatbox.Classes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:vrcosc_magicchatbox.UI.Pages"
    xmlns:vm="clr-namespace:vrcosc_magicchatbox.ViewModels"
    Title="MagicChatbox by BoiHanny"
    Width="1150"
    Height="775"
    MinWidth="1080"
    MinHeight="500"
    VerticalAlignment="Bottom"
    d:DataContext="{d:DesignInstance Type=vm:ViewModel,
                                     IsDesignTimeCreatable=True}"
    IsEnabled="{Binding AppSettingsInstance.AppIsEnabled, UpdateSourceTrigger=PropertyChanged}"
    Opacity="{Binding AppSettingsInstance.AppOpacity, UpdateSourceTrigger=PropertyChanged}"
    Topmost="{Binding AppSettingsInstance.Topmost, UpdateSourceTrigger=PropertyChanged}"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="55"
            CornerRadius="0"
            GlassFrameThickness="1"
            ResizeBorderThickness="8"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>



    <Grid>
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource SurfaceDarkBrush}"
            BorderBrush="{StaticResource SurfaceDarkBrush}"
            BorderThickness="1">
            <Border.Effect>
                <BlurEffect
                    d:Radius="0"
                    KernelType="Gaussian"
                    Radius="{Binding MainWindowBlurEffect}" />
            </Border.Effect>
            <Grid HorizontalAlignment="Stretch" Background="{StaticResource SurfaceCardBrush}">


                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="225" />
                </Grid.ColumnDefinitions>




                <pages:StatusPage
                    Grid.Row="1"
                    d:Visibility="Collapsed"
                    DataContext="{Binding Status}"
                    Visibility="{Binding DataContext.SelectedMenuIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=1}" />


                <pages:OptionsPage
                    x:Name="optionsPage"
                    Grid.Row="1"
                    d:Visibility="Collapsed"
                    DataContext="{Binding Options}"
                    Visibility="{Binding DataContext.SelectedMenuIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=3}" />


                <pages:ChattingPage
                    x:Name="chattingPage"
                    Grid.Row="1"
                    d:Visibility="Visible"
                    DataContext="{Binding Chatting}"
                    Visibility="{Binding DataContext.SelectedMenuIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=2}" />

                <!--  The full-width "Some integrations can't be showed because a limit on characters"
                      bar used to sit here. It covered the page, was sized like a headline, and never
                      said which integration it meant. The Integrations page now names them in the
                      same small strip that reports mode visibility.  -->





                <controls:ToastOverlay
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Margin="0,0,12,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="100" />


                <Grid Grid.ColumnSpan="2" Background="{StaticResource SurfacePrimaryBrush}">

                    <Grid.Effect>
                        <DropShadowEffect
                            BlurRadius="12"
                            Direction="-120"
                            Opacity="0.2"
                            RenderingBias="Performance"
                            ShadowDepth="5"
                            Color="black" />
                    </Grid.Effect>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="143" />
                        <ColumnDefinition Width="123" />
                        <ColumnDefinition Width="123" />
                        <ColumnDefinition Width="122" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Border>
                        <Grid x:Name="Drag_area" MouseDown="Drag_area_MouseDown">
                            <TextBlock
                                Grid.Column="0"
                                Padding="0,12,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Albert Sans Thin"
                                FontSize="16"
                                Foreground="White"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Text="MagicChatbox">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Direction="315"
                                        Opacity="1"
                                        ShadowDepth="0"
                                        Color="LightBlue" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock
                                Grid.Column="0"
                                Padding="20,12,0,0"
                                HorizontalAlignment="left"
                                VerticalAlignment="top"
                                FontFamily="Albert Sans Thin"
                                FontSize="10"
                                Foreground="MediumPurple"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Text="VRC OSC">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="15"
                                        Direction="315"
                                        Opacity="1"
                                        ShadowDepth="0"
                                        Color="LightBlue" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Grid
                        Grid.Column="1"
                        Margin="3,0,3,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button
                            Name="MenuButton_0"
                            Margin="0,0,0,0"
                            Background="{StaticResource SurfaceDarkBrush}"
                            BorderThickness="0"
                            Command="{Binding ChangeMenuCommand}"
                            CommandParameter="0"
                            Content="Integrations"
                            Cursor="Hand"
                            FontFamily="Comfortaa Light"
                            FontSize="18"
                            FontWeight="Normal"
                            Foreground="White"
                            Style="{DynamicResource MenuItemStyle}" />
                        <Border
                            Height="4"
                            VerticalAlignment="Top"
                            Background="{StaticResource ButtonHighlightBrush}"
                            IsHitTestVisible="False"
                            Visibility="{Binding SelectedMenuIndex, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=0}" />
                    </Grid>
                    <Grid
                        Grid.Column="2"
                        Margin="3,0,3,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button
                            Name="MenuButton_1"
                            Margin="0,0,0,0"
                            Background="{StaticResource SurfaceDarkBrush}"
                            BorderThickness="0"
                            Command="{Binding ChangeMenuCommand}"
                            CommandParameter="1"
                            Content="Status"
                            Cursor="Hand"
                            FontFamily="Comfortaa Light"
                            FontSize="18"
                            FontWeight="Normal"
                            Foreground="White"
                            Style="{DynamicResource MenuItemStyle}" />
                        <Border
                            Height="4"
                            VerticalAlignment="Top"
                            Background="{StaticResource ButtonHighlightBrush}"
                            IsHitTestVisible="False"
                            Visibility="{Binding SelectedMenuIndex, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=1}" />
                    </Grid>
                    <Grid
                        Grid.Column="3"
                        Margin="3,0,3,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button
                            Name="MenuButton_2"
                            Margin="0,0,0,0"
                            Background="{StaticResource SurfaceDarkBrush}"
                            BorderThickness="0"
                            Command="{Binding ChangeMenuCommand}"
                            CommandParameter="2"
                            Content="Chatting"
                            Cursor="Hand"
                            FontFamily="Comfortaa Light"
                            FontSize="18"
                            FontWeight="Normal"
                            Foreground="White"
                            Style="{DynamicResource MenuItemStyle}" />
                        <Border
                            Height="4"
                            VerticalAlignment="Top"
                            Background="{StaticResource ButtonHighlightBrush}"
                            IsHitTestVisible="False"
                            Visibility="{Binding SelectedMenuIndex, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=2}" />
                    </Grid>
                    <Grid
                        Grid.Column="4"
                        Margin="3,0,3,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button
                            Name="MenuButton_3"
                            Margin="0,0,0,0"
                            Background="{StaticResource SurfaceDarkBrush}"
                            BorderThickness="0"
                            Command="{Binding ChangeMenuCommand}"
                            CommandParameter="3"
                            Content="Options"
                            Cursor="Hand"
                            FontFamily="Comfortaa Light"
                            FontSize="18"
                            FontWeight="Normal"
                            Foreground="White"
                            Style="{DynamicResource MenuItemStyle}" />
                        <Border
                            Height="4"
                            VerticalAlignment="Top"
                            Background="{StaticResource ButtonHighlightBrush}"
                            IsHitTestVisible="False"
                            Visibility="{Binding SelectedMenuIndex, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=3}" />
                    </Grid>

                    <!--  Discord, GitHub and the wiki, moved out of the preview header where they were
                          three absolutely-positioned buttons sharing one cell by margin arithmetic.
                          Two rows, hugging the Options tab: GitHub beside Discord, wiki under Discord.  -->
                    <!--  Right-aligned to sit against the side panel's edge rather than trailing the
                          Options tab. 233 is the panel's 225 plus a hair of breathing room.  -->
                    <Grid
                        Grid.Column="5"
                        Margin="0,0,233,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button
                            x:Name="Github"
                            Grid.Row="0"
                            Grid.Column="0"
                            Command="{Binding OpenGitHubCommand}"
                            Style="{StaticResource TopBarLinkButton}"
                            ToolTip="MagicChatbox on GitHub">
                            <Image
                                Width="17"
                                Height="17"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Img/Icons/GitHub.png" />
                        </Button>

                        <Button
                            x:Name="Discord"
                            Grid.Row="0"
                            Grid.Column="1"
                            Command="{Binding OpenDiscordCommand}"
                            Style="{StaticResource TopBarLinkButton}"
                            ToolTip="Join the MagicChatbox Discord">
                            <Image
                                Width="17"
                                Height="17"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Img/Icons/Discord.png" />
                        </Button>

                        <Button
                            x:Name="WikiHelp"
                            Grid.Row="1"
                            Grid.Column="1"
                            Command="{Binding OpenWikiCommand}"
                            Style="{StaticResource TopBarLinkButton}"
                            ToolTip="Open the MagicChatbox wiki - guides for every integration and setting">
                            <Image
                                Width="16"
                                Height="16"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Img/Icons/Info_ico.png" />
                        </Button>
                    </Grid>

                    <Grid Grid.Column="6" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="45" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Name="Button_close"
                            Grid.Column="2"
                            Width="45"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="#004D0606"
                            BorderThickness="0"
                            Click="Button_close_Click"
                            Cursor="Hand"
                            Style="{DynamicResource CloseButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                            <Image Margin="2" Source="img/icons/Close_ico.png" />
                        </Button>
                        <Button
                            Name="Button_minimize"
                            Grid.Column="1"
                            Width="45"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="#00473C89"
                            BorderThickness="0"
                            Click="Button_minimize_Click"
                            Cursor="Hand"
                            Style="{DynamicResource SubtractButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                            <Image Margin="2" Source="img/icons/subtract_ico.png" />
                        </Button>
                        <Grid
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="-5,22,0,0">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TransformGroup>
                                            <ScaleTransform CenterX="0.5" CenterY="0.5" />
                                            <SkewTransform CenterX="0.5" CenterY="0.5" />
                                            <RotateTransform Angle="180" CenterX="0.5" CenterY="0.5" />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#FF431F91" />
                                    <GradientStop Offset="1" Color="{StaticResource SurfacePrimaryColor}" />
                                </LinearGradientBrush>
                            </Grid.Background>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Orientation="Vertical">
                                <TextBlock
                                    Width="53"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="DemiBold"
                                    Text="Running">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0.006" Color="#FF411E8C" />
                                            <GradientStop Offset="1" Color="#FFA28FCE" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock
                                    Width="18"
                                    Margin="0,-5,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Text="VR"
                                    Visibility="{Binding IsVRRunning, Converter={StaticResource InverseBoolToHiddenConverter}}">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0.106" Color="#FF3A1A7E" />
                                            <GradientStop Offset="0.627" Color="#FFCA577C" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock
                                    Margin="0,-5,0,0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Text="DESKTOP"
                                    Visibility="{Binding IsVRRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0.109" Color="#FF38197C" />
                                            <GradientStop Offset="0.827" Color="#FF54B955" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </StackPanel>

                        </Grid>

                        <Grid Grid.Column="0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel
                                Margin="0,0,5,0"
                                Background="{StaticResource SurfaceDarkPurpleBrush}"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="12"
                                    Foreground="#FFB3B0B9"
                                    Text="Send to VRChat" />
                                <CheckBox
                                    Name="MasterSwitch"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="MasterSwitch_Click"
                                    IsChecked="{Binding MasterSwitch, Mode=TwoWay}"
                                    Opacity="0.90"
                                    Style="{DynamicResource Switch}" />
                            </StackPanel>

                        </Grid>
                    </Grid>

                </Grid>
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="225"
                    Background="#FF42385D">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="auto" />

                    </Grid.RowDefinitions>
                    <Grid.Effect>
                        <DropShadowEffect
                            BlurRadius="5"
                            Direction="-100"
                            Opacity="0.1"
                            RenderingBias="Performance"
                            ShadowDepth="15"
                            Color="DarkBlue" />
                    </Grid.Effect>
                    <StackPanel
                        Grid.Row="3"
                        Margin="10,0,10,10"
                        VerticalAlignment="Bottom">

                        <Border
                            Margin="0,0,0,9"
                            Padding="10,6"
                            Background="#2E1B0F3A"
                            BorderBrush="#FF473A6B"
                            BorderThickness="1"
                            CornerRadius="7">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#FFC0A6FF"
                                    Text="✦" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="11"
                                    Foreground="#FFA99BD2"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="MagicChatbox V2 is on the way" />
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="13,11"
                            BorderBrush="#FF564B79"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#FF3F3559" />
                                    <GradientStop Offset="1" Color="#FF322A46" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontFamily="Albert Sans Thin"
                                            FontSize="10"
                                            Foreground="#FF8B80AE"
                                            Text="INSTALLED" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontFamily="Comfortaa Light"
                                            FontSize="17"
                                            Foreground="#FFEDE7FF"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            Text="{Binding UpdateState.AppVersion.VersionNumber}" />
                                    </StackPanel>

                                    <Button
                                        x:Name="CheckUpdateBtnn"
                                        Grid.Column="1"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CheckUpdateCommand}"
                                        Style="{StaticResource CircleButton}"
                                        ToolTip="Check for updates">
                                        <Image
                                            Width="12"
                                            Height="12"
                                            RenderOptions.BitmapScalingMode="Linear"
                                            Source="/Img/Icons/Load_ico.png" />
                                    </Button>
                                </Grid>

                                <Border
                                    Height="1"
                                    Margin="0,11,0,0"
                                    Background="#FF4C4170" />

                                <Border
                                    Margin="0,11,0,0"
                                    Padding="8,6"
                                    Background="#FF2B2440"
                                    BorderBrush="{Binding UpdateState.VersionTxtColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding Command="{Binding StartUpdateCommand}" MouseAction="LeftClick" />
                                    </Border.InputBindings>
                                    <TextBlock
                                        Name="NewVersion"
                                        HorizontalAlignment="Center"
                                        FontFamily="Albert Sans Thin"
                                        FontSize="12"
                                        Foreground="{Binding UpdateState.VersionTxtColor}"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Text="{Binding UpdateState.VersionTxt}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState.VersionTxtUnderLine}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock
                                    Margin="0,9,0,0"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="11"
                                    Foreground="#FF9186B5"
                                    Text="{Binding UpdateState.UpdateStatustxt}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UpdateState.UpdateStatustxt}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock
                                    x:Name="GitHubChanges"
                                    Margin="0,9,0,0"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="10"
                                    Foreground="#FF6FBEFF"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="View changes on GitHub"
                                    TextDecorations="Underline"
                                    Visibility="{Binding UpdateState.CanUpdateLabel, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Command="{Binding OpenGitHubChangesCommand}" MouseAction="LeftClick" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!--  A section label, not a title: it names the panel below it and then gets out of
                          the way. Letter spacing does the work the old 16px glow was doing.  -->
                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Bahnschrift SemiLight"
                        FontSize="11"
                        Foreground="{StaticResource DeckTextBrush}"
                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                        Text="P R E V I E W" />

                    <!--  Stays quiet until the line actually starts running out of room, then warms up
                          and finally goes red. A counter you only notice when it matters.  -->
                    <Border
                        Grid.Column="0"
                        Height="18"
                        Margin="0,0,10,0"
                        Padding="7,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#26FFFFFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OscDisplay.Fill}" Value="Tight">
                                        <Setter Property="Background" Value="#3FFFC46B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OscDisplay.Fill}" Value="Full">
                                        <Setter Property="Background" Value="#59FF6F8A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Bahnschrift SemiLight"
                            FontSize="10"
                            Text="{Binding OscDisplay.OscMsgCountUI}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DeckTextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OscDisplay.Fill}" Value="Tight">
                                            <Setter Property="Foreground" Value="#FFFFD79A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OscDisplay.Fill}" Value="Full">
                                            <Setter Property="Foreground" Value="#FFFFC2CD" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Grid.Row="2" VerticalAlignment="Top">

                        <StackPanel
                            Width="214"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Orientation="Vertical">
                            <!--  Which set of statuses is live, switchable without leaving whatever page
                                  you are on. This is a view onto the same cycle-override the pin on the
                                  Status page writes, so the two can never disagree.  -->
                            <Border
                                Margin="0,0,0,6"
                                Padding="11,9"
                                Background="#FF2C2148"
                                BorderBrush="{StaticResource DeckEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding Integrations.IntegrationSettings.IntgrStatus, Converter={StaticResource InverseBoolToHiddenConverter}}">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontFamily="Bahnschrift SemiLight"
                                        FontSize="10"
                                        Foreground="{StaticResource DeckTextMutedBrush}"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Text="STATUS SET" />

                                    <ComboBox
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding StatusSets.Sets}"
                                        SelectedItem="{Binding StatusSets.SelectedSet, Mode=TwoWay}"
                                        Style="{StaticResource FlatComboBoxStyle}"
                                        ToolTip="Only this set's messages go to the chatbox. Pick 'Every set' to use them all." />

                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Albert Sans Thin"
                                            FontSize="11"
                                            Text="{Binding StatusSets.Summary}"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource DeckTextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <!--  A set with nothing to send is worth noticing before you
                                                              wonder why the chatbox went quiet.  -->
                                                        <DataTrigger Binding="{Binding StatusSets.IsEmptySet}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFD79A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ToggleButton
                                            Grid.Column="1"
                                            MinWidth="52"
                                            Margin="0"
                                            Content="CYCLE"
                                            IsChecked="{Binding AppSettingsInstance.CycleStatus, Mode=TwoWay}"
                                            Style="{StaticResource FeatureChip}"
                                            ToolTip="Move through this set's messages automatically." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  AFK state, in the deck language the integration tiles use: one card, a
                                  status dot and pill rather than a label reading "Away from keyboard:
                                  Inactive", and the countdown on its own line where it can be read at a
                                  glance. The whole card warms up when you are actually away.  -->
                            <Border
                                Padding="11,9"
                                BorderThickness="1"
                                CornerRadius="10"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding Modules.Afk.Settings.EnableAfkDetection, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FF2C2148" />
                                        <Setter Property="BorderBrush" Value="{StaticResource DeckEdgeBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Modules.Afk.IsAfk}" Value="True">
                                                <Setter Property="Background" Value="#FF352755" />
                                                <Setter Property="BorderBrush" Value="#FF6FD9A6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Bahnschrift SemiLight"
                                            FontSize="10"
                                            Foreground="{StaticResource DeckTextMutedBrush}"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            Text="AWAY FROM KEYBOARD" />

                                        <Border
                                            Grid.Column="1"
                                            Height="18"
                                            Padding="7,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="5"
                                            SnapsToDevicePixels="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#26FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Modules.Afk.IsAfk}" Value="True">
                                                            <Setter Property="Background" Value="#446FD9A6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Bahnschrift SemiLight"
                                                FontSize="10"
                                                RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource DeckTextMutedBrush}" />
                                                        <Setter Property="Text" Value="AT KEYBOARD" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Modules.Afk.IsAfk}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFCFF6E4" />
                                                                <Setter Property="Text" Value="AWAY" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <!--  Swap how you word being away without opening Options. Styles are
                                          built there; this is just the switch.  -->
                                    <!--  IsSynchronizedWithCurrentItem is off on purpose. Two ComboBoxes over
                                          one collection otherwise share its default view's current item, so
                                          the Options picker and this one drag each other's selection about.  -->
                                    <ComboBox
                                        x:Name="AfkStylePicker"
                                        Margin="0,8,0,0"
                                        DisplayMemberPath="Name"
                                        IsSynchronizedWithCurrentItem="False"
                                        ItemsSource="{Binding AfkStyles.Styles}"
                                        SelectedItem="{Binding AfkStyles.SelectedStyle, Mode=TwoWay}"
                                        Style="{StaticResource FlatComboBoxStyle}"
                                        ToolTip="{Binding AfkStyles.PreviewLine}" />

                                    <!--  Out of the way until you go looking. The style's name is enough
                                          at a glance; the full line is only worth the space while you are
                                          actually choosing one, so it appears on hover or focus.  -->
                                    <TextBlock
                                        Margin="1,6,0,0"
                                        FontFamily="Albert Sans Thin"
                                        FontSize="11"
                                        Foreground="{StaticResource DeckTextMutedBrush}"
                                        Text="{Binding AfkStyles.PreviewLine}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding AfkStyles.PreviewLine}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=AfkStylePicker}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AfkStylePicker}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDropDownOpen, ElementName=AfkStylePicker}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="{Binding Modules.Afk.VRModeLabelActive, Converter={StaticResource InverseBoolToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Albert Sans Thin"
                                                FontSize="12"
                                                Foreground="{StaticResource DeckTextMutedBrush}"
                                                RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Away in" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Modules.Afk.IsAfk}" Value="True">
                                                                <Setter Property="Text" Value="Away for" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                Padding="6,0,0,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Comfortaa Light"
                                                FontSize="13"
                                                RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#FFE7E2F5" />
                                                        <Setter Property="Text" Value="{Binding Modules.Afk.RemainingTimeUntilAFK}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Modules.Afk.IsAfk}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF9BEFC9" />
                                                                <Setter Property="Text" Value="{Binding Modules.Afk.TimeCurrentlyAFK}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Albert Sans Thin"
                                            FontSize="12"
                                            Foreground="{StaticResource DeckTextMutedBrush}"
                                            Text="Paused while you are in VR"
                                            Visibility="{Binding Modules.Afk.VRModeLabelActive, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />

                                        <ToggleButton
                                            Grid.Column="1"
                                            MinWidth="66"
                                            Margin="0"
                                            Command="{Binding Integrations.ManualBuildOscCommand}"
                                            Content="AFK NOW"
                                            IsChecked="{Binding Modules.Afk.Settings.OverrideAfk}"
                                            Style="{StaticResource FeatureChip}"
                                            ToolTip="Mark yourself away right now, without waiting for the countdown."
                                            Visibility="{Binding Modules.Afk.OverrideButtonVisible, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Button
                                x:Name="ReorderIntegrationsButton"
                                Width="auto"
                                Height="27"
                                Margin="0,5"
                                Padding="5"
                                HorizontalAlignment="Right"
                                Click="ReorderIntegrations_Click"
                                Style="{StaticResource Status_Button_style}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image
                                                Height="16"
                                                Margin="0,0,5,0"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                Source="/Img/Icons/Edit_ico.png" />
                                            <TextBlock
                                                Margin="0,-1,5,0"
                                                VerticalAlignment="Center"
                                                FontSize="13"
                                                Text="Reorder integrations" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                            <Button
                                x:Name="ToggleVoicebtn"
                                Width="auto"
                                Height="27"
                                Margin="0,0,0,0"
                                Padding="10,0"
                                HorizontalAlignment="Right"
                                local:ButtonProperties.ShadowTrigger="{Binding TtsAudio.TTSBtnShadow}"
                                Command="{Binding ToggleVoiceCommand}"
                                Content="{Binding TtsAudio.ToggleVoiceText}"
                                RenderOptions.BitmapScalingMode="NearestNeighbor"
                                Style="{DynamicResource Status_Button_style_Shadow}" />

                        </StackPanel>


                        <StackPanel
                            Margin="0,8,0,2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Albert Sans Thin"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Opacity="0.7"
                                Text="TopMost" />
                            <CheckBox
                                Margin="4,0,0,0"
                                FontSize="12"
                                IsChecked="{Binding AppSettingsInstance.Topmost, Mode=TwoWay}"
                                Style="{DynamicResource SettingsCheckbox}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Albert Sans Thin"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Opacity="0.7"
                                Text="Close to tray" />
                            <CheckBox
                                Margin="4,0,0,0"
                                FontSize="12"
                                IsChecked="{Binding AppSettingsInstance.CloseToTray, Mode=TwoWay}"
                                Style="{DynamicResource SettingsCheckbox}"
                                ToolTip="Keep MagicChatbox running in the tray when the close button is pressed." />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding SelectedMenuIndex, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=2}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Albert Sans Thin"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Opacity="0.7"
                                Text="Live edit chats"
                                Visibility="{Binding ChatSettings.ChatLiveEdit, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox
                                Margin="4,0,0,0"
                                FontSize="12"
                                IsChecked="{Binding ChatSettings.RealTimeChatEdit, Mode=TwoWay}"
                                Style="{DynamicResource SettingsCheckbox}"
                                Visibility="{Binding ChatSettings.ChatLiveEdit, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel
                            Margin="0,2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Visibility="{Binding SelectedMenuIndex, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=2}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Albert Sans Thin"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Opacity="0.7"
                                Text="Text to speech" />
                            <CheckBox
                                Margin="4,0,0,0"
                                IsChecked="{Binding TtsSettingsInstance.TtsTikTokEnabled, Mode=TwoWay}"
                                Style="{DynamicResource SettingsCheckbox}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding TtsSettingsInstance.TtsTikTokEnabled, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel
                                Width="176"
                                Margin="0,5"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding SelectedMenuIndex, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=2}">
                                <TextBlock
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="13"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="Voice">
                                    <TextBlock.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.5"
                                            ShadowDepth="0"
                                            Color="{StaticResource GradientDeepPurpleColor}" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <ComboBox
                                    x:Name="TikTokTTSVoices_combo"
                                    Width="135"
                                    BorderBrush="#FF020000"
                                    DisplayMemberPath="DisplayName"
                                    FontSize="11.5"
                                    ItemsSource="{Binding TtsAudio.TikTokTTSVoices, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Opacity="0.4"
                                    SelectedItem="{Binding TtsAudio.SelectedTikTokTTSVoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="ApiName"
                                    SelectionChanged="TikTokTTSVoices_combo_SelectionChanged" />
                            </StackPanel>

                            <StackPanel
                                Width="211"
                                Height="22"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding SelectedMenuIndex, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=2}">
                                <TextBlock
                                    Width="69"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Center"
                                    FontFamily="Albert Sans Thin"
                                    FontSize="13"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Text="TTS volume">
                                    <TextBlock.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.5"
                                            ShadowDepth="0"
                                            Color="{StaticResource GradientDeepPurpleColor}" />
                                    </TextBlock.Effect>
                                </TextBlock>
                                <Slider
                                    x:Name="VolumeSlider"
                                    Width="134.5"
                                    Height="12"
                                    Margin="2.2,0,4.5,0"
                                    Maximum="1"
                                    Minimum="0"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Style="{StaticResource CustomSlider}"
                                    Value="{Binding TtsSettingsInstance.TtsVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <Slider.Effect>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            Opacity="0.3"
                                            ShadowDepth="0"
                                            Color="{StaticResource GradientDeepPurpleColor}" />
                                    </Slider.Effect>
                                </Slider>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>

                    <!--  The line as VRChat will receive it. One text layer, not two: the second copy
                          underneath existed only to cast a white glow, and it cost a full extra text
                          render of every rebuild while making the words muddier, not brighter.  -->
                    <Border
                        Grid.Row="1"
                        Height="157"
                        Margin="8,0,9,0"
                        Padding="11,10"
                        VerticalAlignment="Top"
                        BorderBrush="{StaticResource DeckEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        SnapsToDevicePixels="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FF302548" />
                                <GradientStop Offset="1" Color="#FF261D3B" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Top"
                                d:Text="This song is paused 💖💬⏸🎵"
                                FontFamily="Albert Sans Thin"
                                FontSize="14"
                                Foreground="#FFE7E2F5"
                                LineHeight="19"
                                Text="{Binding OscDisplay.OscToSent}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{Binding OscDisplay.HasPreview, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Albert Sans Thin"
                                FontSize="12"
                                Foreground="{StaticResource DeckTextMutedBrush}"
                                Text="Nothing to send yet"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{Binding OscDisplay.HasPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <Grid
                        Grid.Row="2"
                        Height="auto"
                        Margin="5,2,6,15"
                        VerticalAlignment="Top"
                        Visibility="{Binding Modules.Afk.Settings.EnableAfkDetection, Converter={StaticResource InverseBoolToHiddenConverter}, UpdateSourceTrigger=PropertyChanged}" />





                </Grid>
                <pages:IntegrationsPage
                    x:Name="integrationsPage"
                    Grid.Row="1"
                    d:Visibility="Collapsed"
                    DataContext="{Binding Integrations}"
                    Visibility="{Binding DataContext.SelectedMenuIndex, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndexToVisibilityConverter}, FallbackValue=Collapsed, ConverterParameter=0}" />
            </Grid>
        </Border>

        <Grid
            x:Name="StartupOverlay"
            Panel.ZIndex="200"
            Visibility="Visible">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.5,1">
                    <GradientStop Offset="0" Color="#FF2D1265" />
                    <GradientStop Offset="1" Color="#FF1A0E3E" />
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image
                    Width="48"
                    Height="48"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="/Img/Icons/MagicChatbox_ico.png" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Albert Sans Thin"
                    FontSize="18"
                    Foreground="White"
                    Text="MagicChatbox">
                    <TextBlock.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.8"
                            ShadowDepth="0"
                            Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>

                <ProgressBar
                    x:Name="OverlayProgressBar"
                    Width="280"
                    Height="5"
                    Margin="0,20,0,10"
                    Background="#FF3A2F54"
                    Foreground="#FF7C5CBF" />

                <Grid
                    Width="320"
                    Height="54"
                    ClipToBounds="True">
                    <StackPanel>
                        <TextBlock
                            x:Name="OverlayPrevStep"
                            FontFamily="Albert Sans Thin"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Opacity="0.5"
                            Text=""
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="OverlayCurrentStep"
                            Margin="0,2"
                            FontFamily="Albert Sans Thin"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Starting your interfaces..."
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="OverlayNextStep"
                            FontFamily="Albert Sans Thin"
                            FontSize="11"
                            Foreground="{StaticResource TextMutedBrush}"
                            Opacity="0.5"
                            Text=""
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

    </Grid>
</Window>

                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Background" Value="#2D1072" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2D1072" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="true">

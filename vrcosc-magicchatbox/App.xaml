            <!--
                Control deck + scrollbar tokens. The accent ramp means exactly one thing across the app:
                "this is on". Only the master switch wears it, so it never competes with the status rail.
            -->

            <!--
                Off track is LIGHTER than the tile, not darker. A dark track measured 1.37:1 against the
                tile surface, which made the app's primary control the least visible thing in its row.
            -->
            <SolidColorBrush
                x:Key="SwitchTrackOffBrush"
                po:Freeze="True"
                Color="#FF584B8C" />
            <SolidColorBrush
                x:Key="SwitchEdgeOffBrush"
                po:Freeze="True"
                Color="#FF7A6BB5" />
            <SolidColorBrush
                x:Key="SwitchThumbOffBrush"
                po:Freeze="True"
                Color="#FFE3DCF5" />
            <SolidColorBrush
                x:Key="SwitchThumbOnBrush"
                po:Freeze="True"
                Color="#FFFDFBFF" />
            <SolidColorBrush
                x:Key="SwitchEdgeOnBrush"
                po:Freeze="True"
                Color="#FFCBB0FF" />
            <LinearGradientBrush x:Key="AccentRampBrush" po:Freeze="True" StartPoint="0,1" EndPoint="1,0">
                <GradientStop Offset="0" Color="#FF3FE0D2" />
                <GradientStop Offset="0.35" Color="#FF6E9BFF" />
                <GradientStop Offset="0.65" Color="#FFB96BFF" />
                <GradientStop Offset="1" Color="#FFFF6FC7" />
            </LinearGradientBrush>

            <SolidColorBrush
                x:Key="ScrollThumbBrush"
                po:Freeze="True"
                Color="#8FC0B2F0" />
            <SolidColorBrush
                x:Key="ScrollThumbHoverBrush"
                po:Freeze="True"
                Color="#E0D6CCFF" />
            <SolidColorBrush
                x:Key="ScrollTrackHoverBrush"
                po:Freeze="True"
                Color="#1AFFFFFF" />
            <LinearGradientBrush x:Key="AccentRampVerticalBrush" po:Freeze="True" StartPoint="0,1" EndPoint="0,0">
                <GradientStop Offset="0" Color="#FF3FE0D2" />
                <GradientStop Offset="0.5" Color="#FF6E9BFF" />
                <GradientStop Offset="1" Color="#FFB96BFF" />
            </LinearGradientBrush>

            <Style x:Key="Switch" TargetType="{x:Type CheckBox}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <!--  Focus ring sits outside the track so it never overlaps the thumb.  -->
                                    <Border
                                        x:Name="focusRing"
                                        Margin="-2"
                                        BorderBrush="#FF8FD6FF"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Opacity="0"
                                        SnapsToDevicePixels="True" />
                                    <Border
                                        x:Name="track"
                                        Width="42"
                                        Height="22"
                                        Background="{StaticResource SwitchTrackOffBrush}"
                                        BorderBrush="{StaticResource SwitchEdgeOffBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        SnapsToDevicePixels="True" />
                                    <!--
                                        The thumb rides inside the track. The old 25px ball overhung a 20px
                                        rail by 2.5px top and bottom, which is most of what dated it.
                                    -->
                                    <Border
                                        x:Name="knob"
                                        Width="16"
                                        Height="16"
                                        Margin="3,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SwitchThumbOffBrush}"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>

                                <ContentPresenter
                                    x:Name="content"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!--  Contentless call sites reserve no width.  -->
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                                </Trigger>

                                <Trigger Property="IsChecked" Value="True">
                                    <!--
                                        The explicit setter is the resting truth. Tiles are torn down and
                                        re-added on every reorder and hide, and a position that exists only
                                        as an animation clock parks the thumb on the wrong side.
                                    -->
                                    <Setter TargetName="knob" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="20" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="track" Property="Background" Value="{StaticResource AccentRampBrush}" />
                                    <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource SwitchEdgeOnBrush}" />
                                    <Setter TargetName="knob" Property="Background" Value="{StaticResource SwitchThumbOnBrush}" />
                                    <Setter TargetName="track" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
                                                po:Freeze="True"
                                                BlurRadius="12"
                                                Opacity="0.55"
                                                RenderingBias="Performance"
                                                ShadowDepth="0"
                                                Color="#8FD6FF" />
                                        </Setter.Value>
                                    </Setter>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="knob"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="20"
                                                    Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>

                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="knob" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="0" />
                                        </Setter.Value>
                                    </Setter>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="knob"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="0"
                                                    Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="track" Property="BorderBrush" Value="#FFB9A6EE" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="knob" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="focusRing" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScrollThumbs" TargetType="{x:Type Thumb}">
                <Setter Property="Padding" Value="2,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid x:Name="Grid">
                                <!--  Full-width invisible hit area: the visible hairline is far too thin to grab.  -->
                                <Rectangle
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Fill="Transparent" />
                                <Border
                                    x:Name="Rectangle1"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    Cursor="Hand" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
                <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
                <Setter Property="Foreground" Value="{StaticResource ScrollThumbBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <!--
                                Layout width stays 8 so nothing in the app reflows; the bar is thinner
                                visually, not structurally. Width lives on the setter only, so the
                                horizontal orientation trigger can actually override it.
                            -->
                            <Grid
                                x:Name="GridRoot"
                                Width="8"
                                Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.00001*" />
                                </Grid.RowDefinitions>
                                <Track
                                    x:Name="PART_Track"
                                    Grid.Row="0"
                                    Focusable="false"
                                    IsDirectionReversed="true">
                                    <Track.Thumb>
                                        <Thumb
                                            x:Name="Thumb"
                                            Background="{TemplateBinding Foreground}"
                                            Style="{DynamicResource ScrollThumbs}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            x:Name="PageUp"
                                            Command="ScrollBar.PageDownCommand"
                                            Focusable="false"
                                            Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            x:Name="PageDown"
                                            Command="ScrollBar.PageUpCommand"
                                            Focusable="false"
                                            Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!--  The whole rail reacts, not just the 4px thumb.  -->
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="GridRoot" Property="Background" Value="{StaticResource ScrollTrackHoverBrush}" />
                                    <Setter TargetName="Thumb" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
                                </Trigger>
                                <Trigger SourceName="Thumb" Property="IsDragging" Value="true">
                                    <Setter TargetName="Thumb" Property="Background" Value="{StaticResource AccentRampVerticalBrush}" />
                                </Trigger>

                                <!--
                                    The thumb's padding is what makes it a hairline, so it has to
                                    follow the orientation: thin across the rail, generous along it.
                                    Applied per orientation rather than inside the hover triggers,
                                    which previously assumed vertical and squashed a horizontal bar
                                    out of existence.
                                -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Orientation" Value="Vertical" />
                                        <Condition Property="IsMouseOver" Value="true" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Thumb" Property="Padding" Value="1,6" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Orientation" Value="Horizontal" />
                                        <Condition Property="IsMouseOver" Value="true" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Thumb" Property="Padding" Value="6,1" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <!--
                                    Rotating the root AND the track cancels out and collapses the
                                    thumb to a dot. Track already flips its own axis from the
                                    ScrollBar's Orientation, so the horizontal case only needs the
                                    sizing swapped and the reversal undone - no transforms at all.
                                -->
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="GridRoot" Property="Width" Value="Auto" />
                                    <Setter TargetName="GridRoot" Property="Height" Value="8" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="false" />
                                    <Setter TargetName="Thumb" Property="Padding" Value="6,2" />
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Height" Value="8" />
                                    <Setter TargetName="PageDown" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                    <Setter TargetName="PageUp" Property="Command" Value="ScrollBar.PageRightCommand" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
